{
  "description": "Domain map for the cross-domain dependency guard (SWLOR.Architecture.Tests). Every type in Domain.<Domain> or a topic namespace below it belongs to that domain (each key below must be a declared domain); types directly in Feature belong to featureTypeDomain; code outside Domain, Service and Feature belongs to platformDomain. services: the services of each domain, which ConvertedServices.json must agree with (a converted service is Domain.<Domain>.<Name>Service behind I<Name>Service), plus the types left directly in Service; tools/Refactor/Move-SupportNamespaces.ps1 also reads it to move a Service.<Name>Service folder into its domain. featureFolders: the first folders below Feature. Every service and Feature folder of SWLOR.Game.Server must be listed in exactly one domain, and every listed one must still exist. Edges into an unrestrictedTargetDomains domain are recorded but never fail. Edges out of a wiringPlatformAreas area (the composition root, which has to name every service it registers) are not dependencies and are left out.",
  "platformDomain": "Platform",
  "featureTypeDomain": "Gameplay",
  "unrestrictedTargetDomains": ["Foundation", "Platform"],
  "wiringPlatformAreas": ["Composition"],
  "domains": {
    "Foundation": {
      "services": [
        "DB", "Log", "Cache", "Random", "Time", "GameMath", "ColorToken", "Messaging",
        "Communication", "BackgroundJob", "FrameProfiler", "Migration", "Authorization", "Menu",
        "Conversation", "ConversationMenu", "Snippet", "PlayerFeedback", "ObjectVisibility",
        "Walkmesh", "TileMagic", "AnimationPlayer", "NamedAnimation", "NamedAnimationPlayback",
        "Animation", "Attribute", "INamedAnimationRuntime"
      ],
      "featureFolders": [
        "MigrationDefinition", "SnippetDefinition", "DialogDefinition"
      ]
    },
    "UI": {
      "services": [
        "Gui", "ExtraHotbar", "ExtraHotbars"
      ],
      "featureFolders": [
        "GuiDefinition"
      ]
    },
    "Combat": {
      "services": [
        "Combat", "CombatPoint", "CombatRecorder", "Enmity", "PvpCombat", "Resistance", "Recast",
        "RecastTimestamp", "Telegraph", "Targeting", "QueuedAttackAnimation",
        "WeaponAttackEligibility", "WeaponAttackPhase", "WeaponDelay", "OrdinaryAttackTraits",
        "PairedRangedTraits", "MeleeTechnique", "TwinPistolAbility", "TwinPistolEquipment",
        "TwinPistolMastery", "PowerGloveEquipment", "Stealth", "Death", "Poisons", "BattleGrid",
        "BattleGridSettings", "QueuedAttackAnimationPlayback", "TemporaryStatModifier"
      ],
