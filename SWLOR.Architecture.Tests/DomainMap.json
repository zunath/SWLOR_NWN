      "featureFolders": [
        "BeastDefinition"
      ]
    },
    "Social": {
      "services": [
        "ChatCommand", "ChatPortraitTells", "Party", "PlayerList", "ChatPortraitTell"
      ],
      "featureFolders": [
        "ChatCommandDefinition"
      ]
    },
    "Administration": {
      "services": [
        "DMBlueprintCatalog", "DMCreatorFavorite", "DMCreatureManagerFavorite", "DMObjectDetails",
        "DMObjectSearch", "DMPlayerDirectory", "DMPreference", "DMPresence", "DMTool"
      ],
      "featureFolders": []
    },
    "Gameplay": {
      "services": [],
      "featureFolders": []
    }
  }
