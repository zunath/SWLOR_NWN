<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The native hook extension tests stand in for NWNX's FunctionHook pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- RealBuildReloadTests needs the JIT setting it holds (the file says why). -->
    <RunSettingsFilePath>$(MSBuildProjectDirectory)/SWLOR.Game.Host.Tests.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="Nwn.Hosting.Testing" Version="0.1.0-preview.3" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SWLOR.Game.Host\SWLOR.Game.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The package's ReloadHost refuses to start unless thread-pool workers never retire, as on the server. -->
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.ThreadsToKeepAlive" Value="-1" />
  </ItemGroup>

</Project>
