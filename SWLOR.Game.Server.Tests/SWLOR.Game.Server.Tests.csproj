<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SWLOR.Game.Server\SWLOR.Game.Server.csproj" />
    <!-- The coverage ratchets (AbilityBehaviorCoverageTests, PerkCoverageTests) assert that
         every registered ability/perk has an engine-test case, so they reference the
         engine-test assembly's case sources. -->
    <ProjectReference Include="..\SWLOR.Game.Server.EngineTests\SWLOR.Game.Server.EngineTests.csproj" />
  </ItemGroup>

</Project>
