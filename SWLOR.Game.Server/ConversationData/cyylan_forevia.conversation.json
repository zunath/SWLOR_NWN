      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "We're in the southern part of the Qion Tundra. Hutlar City is located in the north but the government isn't currently allowing off-worlders, such as yourself, inside. With Revan's return, everyone's a bit on edge.",
          "Style": 0,
          "Color": null
        }
      ],
