      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"We dug deep, and trying to unearth this world's secrets come with a steep price in blood. Best not to ask too many questions.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
