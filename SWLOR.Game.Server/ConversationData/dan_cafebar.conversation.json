      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"Welcome to the Starlight Café, traveler! I see you've made your way to our humble establishment here on Dantooine. What can I get you today? A refreshing blue milk or perhaps a strong jawa juice?\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00000",
          "Conditions": []
        }
      ]
    },
    "entry-00001": {
      "Id": "entry-00001",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"While you enjoy your drink, take a look around. We've got cozy booths for weary travelers, and the view of the rolling hills outside is quite serene.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        }
      ]
    },
    "entry-00002": {
      "Id": "entry-00002",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"Oh, I've been tending this place for years. It's become a bit of a home away from home for many. You'll find all sorts of patrons here-farmers, smugglers, and even the occasional Jedi. Speaking of which, rumor has it that there's an old Jedi enclave nearby. Some say it's abandoned, but others claim they've seen mysterious figures in the distance.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00002",
          "Conditions": []
        }
      ]
    },
    "entry-00003": {
      "Id": "entry-00003",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"Well, our Womp Rat Surprise is quite popular. It's a hearty stew made from locally sourced ingredients. Don't worry; no actual womp rats were harmed in the making of it. And for dessert, you must try our Twi'lek Lekku Delight. It's a sweet pastry shaped like a Twi'lek head-tail. Kids love it.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00003",
          "Conditions": []
        }
      ]
    }
  },
  "Choices": {
    "reply-00000": {
      "Id": "reply-00000",
      "Text": {
        "Text": "\"Ah, thank you! It's been a long journey.\"",
        "Style": 4,
        "Color": null
      },
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
