    },
    "reply-00002": {
      "Id": "reply-00002",
      "Text": {
        "Text": "\"Jedi, huh? Intriguing. And what's the specialty dish here? Anything unique to the Starlight Café?\"",
        "Style": 4,
        "Color": null
      },
      "SoundResref": "",
      "Animation": 0,
