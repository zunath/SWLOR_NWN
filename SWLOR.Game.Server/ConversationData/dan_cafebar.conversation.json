      ],
      "EndsConversation": false,
      "IsAutomatic": false
    },
    "reply-00001": {
      "Id": "reply-00001",
      "Text": {
        "Text": "\"It's beautiful here. I've heard Dantooine is known for its lush landscapes. How long have you been running this café?\"",
        "Style": 4,
        "Color": null
      },
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
