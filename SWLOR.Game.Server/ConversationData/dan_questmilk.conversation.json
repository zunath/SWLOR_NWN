      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"Thank you! The Dantari have moved to the southern fields. Please be cautious, as they tend to be hostile towards strangers.\"",
