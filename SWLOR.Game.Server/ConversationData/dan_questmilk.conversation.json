      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"The trouble stems from the banthas; their recent unease has been a distraction, and amidst this chaos, someone has pilfered their milk. This theft is particularly troubling as the milk is crucial for the forthcoming festival, and its absence is bound to cast a pall of gloom over the festivities.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00003",
          "Conditions": []
