      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"It was last seen near the western farm fields, tearing up the ground something fierce. Be careful, stranger. That Thune is unlike anything we've seen on Dantooine.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
