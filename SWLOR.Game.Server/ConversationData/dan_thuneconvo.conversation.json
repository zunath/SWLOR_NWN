      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"This ain't your ordinary Thune. It's bigger, meaner, and it's got a hide tougher than a Bantha's. We've tried everything, blasters, vibroblades, even tried luring it away with food. Nothing works.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        }
      ]
    },
    "entry-00002": {
