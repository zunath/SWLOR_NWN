    "entry-00015": {
      "Id": "entry-00015",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "After that we go after whoever is giving them orders. Kill the fifteen Kwi Tribals for me first, and then we will see who is left shouting.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00000",
          "Conditions": []
