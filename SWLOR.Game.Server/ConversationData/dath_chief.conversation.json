      "Id": "entry-00014",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I still need five Kwi Ritual Fetishes, taken from Kwi Shamans. Look in the Grottos, the Ruin Base and the Tribe Village. Not every shaman carries one, so keep hunting until you have five.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00020",
          "Conditions": []
