      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I don't have anything for you. Go talk to Roy Moss if you want a reward. Now scram!",
          "Style": 0,
