        },
        {
          "ChoiceId": "reply-00018",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00017",
          "Conditions": []
        }
      ]
    },
    "entry-00015": {
      "Id": "entry-00015",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I don't know his real name or what he looks like. I only know he goes by \"L\" and he's somewhere in Veles. You'll need to look around for him yourself.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00020",
          "Conditions": []
        }
