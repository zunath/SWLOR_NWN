    "entry-00017": {
      "Id": "entry-00017",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "[He dusts off the tome and stares at it intently, lost in thought.]",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00023",
          "Conditions": []
        }
      ]
    },
    "entry-00018": {
      "Id": "entry-00018",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "[He snaps back to reality.] Yes, yes. I apologize. For a moment there, I thought... [He trails off for a moment.] No, it's nothing. I don't have any use for that old book. Why don't you hang on to it. I sense it will serve you better.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00024",
          "Conditions": []
        }
      ]
    },
    "entry-00019": {
      "Id": "entry-00019",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Right. A deal's a deal. I'll unlock the door for you. [He slides a key card through the nearby terminal.] Not a word about what you see or hear in there, understood? Just give my name to whoever is working there today.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00025",
          "Conditions": []
        }
