        }
      ]
    },
    "entry-00006": {
      "Id": "entry-00006",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You sure ask a lot of questions. I have a deal going down soon and I'm supposed to meet my client here.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00007",
          "Conditions": []
        }
      ]
    },
    "entry-00007": {
      "Id": "entry-00007",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I guess since you're involved now it doesn't matter if you know. Yes, this package contains some less-than-legal stims I'm trying to get transported off-planet.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00009",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00010",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00008",
          "Conditions": []
        }
      ]
    },
    "entry-00008": {
      "Id": "entry-00008",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You're just really itching to get involved, aren't ya? Thanks, but no thanks. I have a deal with this guy and I intend on keeping it.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00010",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00008",
          "Conditions": []
        }
      ]
    },
    "entry-00009": {
      "Id": "entry-00009",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I guess if you're running packages for us now then I can tell you. This is the headquarters of Coxxion, a smuggling organization. We're a small group but there's a surprising amount of work on this planet.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00011",
          "Conditions": []
        }
      ]
    },
    "entry-00010": {
      "Id": "entry-00010",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "[He looks you up and down for a moment.] You? Don't make me laugh. Doing one run with us won't change the fact that you're a nobody here. But that decision isn't up to me, I suppose. Tell you what, you run another errand for me and I'll let you inside. ",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00013",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00012",
          "Conditions": []
        }
      ]
    },
    "entry-00011": {
      "Id": "entry-00011",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I've got a contact in Veles. Now listen closely. When you speak to him, he will say \"Nice breeze we're having\". Your response must be this phrase: \"There is no breeze among the stars\". Understand so far?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00014",
          "Conditions": []
        }
      ]
    },
    "entry-00012": {
      "Id": "entry-00012",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "He will reply with \"The stars know no bounds.\" Your reply must be \"But bounds we must cross.\" Still with me?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00015",
          "Conditions": []
        }
      ]
    },
    "entry-00013": {
      "Id": "entry-00013",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "For the final test he will ask you who sent you. You must use my name - Denam Reyholm - and no one else's. He'll give you what you need. Bring it back to me and we'll continue your little initiation process. Don't screw this up. Understand?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00016",
          "Conditions": []
        }
      ]
    },
    "entry-00014": {
      "Id": "entry-00014",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "How goes your little project?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00021",
          "Conditions": [
            {
              "Key": "condition-on-quest-state",
              "Arguments": [
