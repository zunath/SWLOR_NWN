      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "A speeder would save time between districts. In these lanes it spends half the journey waiting for someone to move a cart. Besides, walking gives me a chance to notice who needs a hand.",
          "Style": 0,
          "Color": null
        }
      ],
