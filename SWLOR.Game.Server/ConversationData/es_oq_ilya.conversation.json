      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The shutters need oil and the roofs always need one more repair. But when my mother hurt her ankle, three neighbors took turns bringing supper. I would miss that if I moved.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
