      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The bathing rooms are through the western passage. The guest suites lie farther inside, along the quiet corridor. Our attendants can help you find your room; please leave the treatment doors to the staff.",
          "Style": 0,
          "Color": null
        }
      ],
