      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "A slight bow and an open hand will do. Many guests have spent the morning sparring. Here we give each other room to recover; staring at a bruise tells you much less than seeing how its owner carries it.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "return",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
