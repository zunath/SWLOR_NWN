      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Ask the stewards and working households in Highcrest. Fresh ingredients, sound tools and repaired equipment have to come from somewhere. Carrying a useful parcel can earn a warmer welcome than boasting about a fight.",
          "Style": 0,
          "Color": null
        }
      ],
