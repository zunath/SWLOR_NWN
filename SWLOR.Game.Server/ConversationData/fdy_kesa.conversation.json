      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Here, it is what the salvage brings in. The foundry will rebuild what you broke, so if you have the time, come back and knock it down again.",
          "Style": 0,
          "Color": null
        }
      ],
