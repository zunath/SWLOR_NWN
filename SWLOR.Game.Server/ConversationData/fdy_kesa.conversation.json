      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You came up through the test site? Then you have heard it too. That hum under the deck is the old droid foundry. It woke up on its own, and it is building war droids again. Its patrols already try these doors at night.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00000",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00001",
