      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The supplies are all here. Now there is less excuse for making an injured porter wait outside. Let me pay you before someone mistakes the delivery for a household donation.",
          "Style": 0,
          "Color": null
        }
