      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Four Kolto Injections and two Medi Syringes. I will count partial deliveries. Search Medical Piles in the Abandoned Warehouse on Dantooine, or buy the supplies from someone who already has them.",
          "Style": 0,
          "Color": null
        }
      ],
