      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Warrior families send their children as a matter of course. For everyone else, someone must vouch for them. I have watched excellent hands turned away for lack of a familiar surname.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "return",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
          "Conditions": []
        }
      ]
    },
    "topic-2": {
      "Id": "topic-2",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I taught a mason to protect a damaged wrist. The elders called it instruction beneath my station. She called it being able to work again. Hers was the more useful judgment.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "return",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
          "Conditions": []
        }
      ]
    },
    "supply-offer": {
      "Id": "supply-offer",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "A practice bout should teach control, not leave a hand useless for a week. Some of the service workers have the same trouble from hauling stone. Bring me three Dantooine Starwort for their compresses. The Dantooine Herbs in the Crystal Fields are the source; you will need Scavenging rank 5, or a gatherer willing to trade. I have 1,500 credits set aside. This is a supply errand, not a hunt.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "supply-accept",
          "Conditions": [
            {
              "Key": "condition-can-accept-quest",
              "Arguments": [
                "eshan_starwort_hands"
              ],
              "IsNegated": false
            },
            {
              "Key": "condition-has-quest",
              "Arguments": [
                "eshan_starwort_hands"
              ],
              "IsNegated": true
            }
          ]
        },
        {
          "ChoiceId": "return",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
          "Conditions": []
        }
      ]
    },
    "supply-accepted": {
      "Id": "supply-accepted",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Thank you. Wrap the herbs dry. I will be here in Highcrest when you return, and the workers will use the same treatment as my students.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "return",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
          "Conditions": []
        }
      ]
    },
    "supply-active": {
      "Id": "supply-active",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I still need three Dantooine Starwort. Bring whatever you have gathered and I will count it toward the order. The Crystal Fields on Dantooine have the herbs; Scavenging rank 5 is needed to gather them yourself.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
