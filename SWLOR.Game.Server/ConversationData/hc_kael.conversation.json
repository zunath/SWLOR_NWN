      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "That is enough Starwort. I can prepare the compresses without turning anyone away. You have earned the payment we agreed on.",
          "Style": 0,
          "Color": null
        }
      ],
