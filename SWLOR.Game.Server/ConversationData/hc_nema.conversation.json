      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "A steward once returned perfectly good bread because the wrapping lacked his house color. His cook bought it back before noon. Hunger has better judgment than pedigree.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
