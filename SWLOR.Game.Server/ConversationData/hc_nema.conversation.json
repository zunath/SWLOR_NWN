      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The late shift misses the household supper and gets hungry all the same. Six Eshan Silverwood Greens and four Eshan Scallions will make a decent pot. Search the Veylan Greens Patches in the Veylan Groves with Scavenging rank 1, or trade for the ingredients. Leave the wolves out of it. I have 400 credits for one delivery a day.",
          "Style": 0,
          "Color": null
        },
        {
          "Text": "Repeat order: available 24 real-world hours after completion. Abandoning a repeat order restarts the 24-hour wait.",
          "Style": 3,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "supply-accept",
          "Conditions": [
