      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "From here you can see the stalls without hearing anyone bargain. My family thinks that is the best feature of the terrace.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "topic-1",
          "Conditions": []
        },
        {
          "ChoiceId": "topic-2",
          "Conditions": []
        },
        {
          "ChoiceId": "supply-topic",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
          "Conditions": []
        }
      ]
    },
    "topic-1": {
      "Id": "topic-1",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I think it makes it easy to imagine the market as decoration. Nema remembered my order after one visit. A servant in our house has worked here for years and my uncle still calls her girl.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "return",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
          "Conditions": []
        }
      ]
    },
    "topic-2": {
      "Id": "topic-2",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I started by learning her name. That is a small thing, I know. Next I want our accounts to show the hours we actually ask people to work. I expect considerably more resistance to that.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "return",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
          "Conditions": []
        }
      ]
    },
    "supply-offer": {
      "Id": "supply-offer",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "A gardener told me the edges of the Veylan Groves are wearing bare. I would rather pay to mend them than commission a painting of how they used to look. Bring six Eshan Silverwood Seeds from the Silverwood Seed Bushes there, and four Good Quality Fiberplast for seedling wraps. The seeds need Scavenging rank 1; the fiberplast shrubs need rank 3. Trade is fine. Leave the standing trees alone. I have 350 credits for one delivery a day.",
          "Style": 0,
          "Color": null
        },
        {
          "Text": "Repeat order: available 24 real-world hours after completion. Abandoning a repeat order restarts the 24-hour wait.",
          "Style": 3,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "supply-accept",
          "Conditions": [
            {
              "Key": "condition-can-accept-quest",
              "Arguments": [
                "eshan_grove_seedlings"
              ],
              "IsNegated": false
            },
            {
              "Key": "condition-has-quest",
              "Arguments": [
                "eshan_grove_seedlings"
              ],
              "IsNegated": true
            }
          ]
        },
        {
          "ChoiceId": "return",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
          "Conditions": []
        }
      ]
    },
    "supply-accepted": {
      "Id": "supply-accepted",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Bring them to me here in Highcrest. The gardener gets the seeds, and the account records her hours as well as your delivery.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "return",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
          "Conditions": []
        }
      ]
    },
    "supply-active": {
