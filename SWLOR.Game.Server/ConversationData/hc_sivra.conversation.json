      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Six Eshan Silverwood Seeds and four Good Quality Fiberplast. Search Silverwood Seed Bushes and fiberplast shrubs in the Veylan Groves, or trade for the supplies. I can take a partial delivery while you gather the rest.",
          "Style": 0,
          "Color": null
        },
        {
          "Text": "Repeat order: available 24 real-world hours after completion. Abandoning a repeat order restarts the 24-hour wait.",
          "Style": 3,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
