        },
        {
          "ChoiceId": "return",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
          "Conditions": []
        }
      ]
    },
    "supply-reward": {
      "Id": "supply-reward",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "That will wrap the next set of seedlings. It is a small repair, but at least the grove will benefit from it. Your payment is ready.",
          "Style": 0,
          "Color": null
        },
        {
          "Text": "Repeat order: available 24 real-world hours after completion. Abandoning a repeat order restarts the 24-hour wait.",
