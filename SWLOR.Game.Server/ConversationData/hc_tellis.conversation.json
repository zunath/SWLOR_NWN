      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I will keep the water running until you return. Bring the parts here in Highcrest; please do not leave them on a household doorstep.",
