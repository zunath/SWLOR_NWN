      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The pump's casing is sound; its controller is not. Six Scrap Metal and four Good Quality Electronics will let me repair it instead of ordering a gilded replacement. CZ-220's junk piles have scrap. Tier-three supply crates aboard the Abandoned Station can yield good electronics if you have Scavenging rank 3. You can also trade for both. The station is dangerous, but I am asking for parts, not bodies. The repair fund has 1,400 credits for you.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "supply-accept",
          "Conditions": [
