      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "When a fountain fails, yes. When it runs, it is a credit to the household. I would settle for them noticing the leak before it ruins another wall.",
          "Style": 0,
          "Color": null
        }
      ],
