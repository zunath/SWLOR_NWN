                "eshan_practice_sleeves"
              ],
              "IsNegated": true
            }
          ]
        },
        {
          "ChoiceId": "return",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
          "Conditions": []
        }
      ]
    },
    "supply-accepted": {
      "Id": "supply-accepted",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Bring the material back to my stall here in Highcrest. I will keep the ordinary sleeves on the same workbench as the house orders.",
          "Style": 0,
          "Color": null
        }
