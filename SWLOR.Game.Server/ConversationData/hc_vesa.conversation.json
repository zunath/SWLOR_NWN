      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "For the length of a greeting. Then they ask your house, your tutor, your address. I can alter a hem. I cannot alter the answer they expect.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
