      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I could afford a room. No household will sponsor the lease. So I rent above a shop and mend sleeves for people who tell me trade is vulgar.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "return",
          "Conditions": []
        },
        {
          "ChoiceId": "farewell",
          "Conditions": []
        }
      ]
    },
    "supply-offer": {
