      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The practice halls send me sleeves with the seams torn open. They ought to give before a wrist does, but someone still has to sew the next set. Bring eight Good Quality Fiberplast. The fiberplast shrubs in the Veylan Groves yield it with Scavenging rank 3; bought material is just as useful. I can set aside 400 credits for one batch each day.",
          "Style": 0,
          "Color": null
        },
        {
          "Text": "Repeat order: available 24 real-world hours after completion. Abandoning a repeat order restarts the 24-hour wait.",
          "Style": 3,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "supply-accept",
          "Conditions": [
            {
              "Key": "condition-can-accept-quest",
              "Arguments": [
                "eshan_practice_sleeves"
              ],
              "IsNegated": false
            },
