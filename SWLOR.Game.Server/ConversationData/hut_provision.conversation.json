    "entry-00003": {
      "Id": "entry-00003",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "A Qion Tiger sleeps in the snow at forty below and wakes up fine, because something in its blood keeps it from freezing. I cook that blood into a tonic for frostbite, and I have nine cases this week and one dose left. I need you to hunt Qion Tigers and bring me five Tiger Blood. Bring it back to me here.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00007",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00006",
          "Conditions": []
        }
      ]
    },
    "entry-00004": {
      "Id": "entry-00004",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good. Hunt Qion Tigers and bring five Tiger Blood straight back to me here at the Hutlar Outpost. It keeps well in the cold, but it does not keep forever.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00004",
          "Conditions": []
        }
      ]
    },
    "entry-00005": {
      "Id": "entry-00005",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "It works better than anything Hutlar City sends me. Do not ask me why it works, because I am a storekeeper with a medical kit and not a chemist.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00006",
          "Conditions": []
        }
      ]
    },
    "entry-00006": {
      "Id": "entry-00006",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I still need five Tiger Blood from the Qion Tigers. They roam the Qion Tundra, the Qion Valley and the Frozen Wastes. Bring all five back to me here.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00009",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00010",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        }
      ]
    },
