      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "That is full weight, and I can have two heaters running by nightfall. The barracks will be warm tonight because of you. Here is your pay from the stores.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
