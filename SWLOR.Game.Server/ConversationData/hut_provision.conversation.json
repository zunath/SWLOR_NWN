      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Two of our six heaters have burned out their coils. Verruchi keeps the power structures running, but power is no use to a heater without a coil. I can wind new coils from Keromber and Plagionite. I need you to mine the veins out on the ice and bring me ten Raw Keromber and ten Raw Plagionite. Bring the ore back to me here.",
          "Style": 0,
          "Color": null
