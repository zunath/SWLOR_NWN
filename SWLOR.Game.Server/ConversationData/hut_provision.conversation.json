      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You are back from the ice. Do you have the ten Raw Keromber and ten Raw Plagionite for the coils?",
          "Style": 0,
          "Color": null
