      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You are back from the tundra. Do you have the six Byysk Meat and six Byysk Tails for the locker?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00012",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00013",
          "Conditions": []
        }
