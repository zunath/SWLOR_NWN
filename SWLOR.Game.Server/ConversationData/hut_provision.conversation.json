      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The supply run from Hutlar City is two weeks late and the meat locker is nearly empty. I will say this quietly, but Byysk is good eating, and nobody here asks what is in the meatballs. I need you to kill Byysk and bring me six Byysk Meat and six Byysk Tails. Bring them back to me here and I will pay you.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00017",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00015",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00016",
          "Conditions": []
        }
      ]
    },
    "entry-00010": {
