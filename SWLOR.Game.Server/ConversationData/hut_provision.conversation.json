      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good. Kill Byysk on the Qion Tundra and bring me six Byysk Meat and six Byysk Tails here at the Hutlar Outpost. Keeping the meat cold will be the easy part.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00014",
          "Conditions": []
        }
      ]
    },
