    "entry-00002": {
      "Id": "entry-00002",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You are back from the hunt. Do you have the five Tiger Blood for my tonic?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00002",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00003",
          "Conditions": []
        }
