    "entry-00001": {
      "Id": "entry-00001",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "These are long fangs from old cats, and they will hold. Here is your pay. It is fur money, so it is not much, but the outpost eats because of it.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00000",
          "Conditions": []
        }
      ]
    },
    "entry-00002": {
      "Id": "entry-00002",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You are back from the hunt. Do you have the six Qion Tiger Fangs for my traps?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00002",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00003",
          "Conditions": []
        }
      ]
    },
    "entry-00003": {
      "Id": "entry-00003",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Steel trap jaws go brittle and snap in this cold, but a tiger's fang does not, so I set fangs into the jaws and the traps hold all winter. I am short of fangs and I am not as fast as I was. I need you to hunt Qion Tigers and bring me six Qion Tiger Fangs. Bring them back to me here and I will pay you.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00007",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00008",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00006",
          "Conditions": []
        }
      ]
    },
    "entry-00004": {
      "Id": "entry-00004",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good. Hunt the Qion Tigers and bring me six Qion Tiger Fangs here at the Hutlar Outpost. Not every tiger gives up a good fang, so expect to kill more than six.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00004",
          "Conditions": []
        }
      ]
    },
    "entry-00005": {
      "Id": "entry-00005",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "No, I trap the smaller animals that the tigers eat, and the fangs just keep the jaws from breaking. The tigers themselves I leave to people like you.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00008",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00006",
          "Conditions": []
        }
      ]
    },
    "entry-00006": {
      "Id": "entry-00006",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "They hunt on the Qion Tundra, in the Qion Valley and in the Frozen Wastes beyond it. You will not have to look hard, because they will find you first.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00007",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00006",
          "Conditions": []
        }
      ]
    },
    "entry-00007": {
      "Id": "entry-00007",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I still need six Qion Tiger Fangs. The tigers are on the Qion Tundra, in the Qion Valley and in the Frozen Wastes. Bring all six fangs back to me here.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00010",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00011",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        }
      ]
    },
    "entry-00008": {
      "Id": "entry-00008",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "These have good edges, and she will get a season of cutting out of them. Everyone who drinks from the cisterns owes you for that. Here is your pay.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00000",
          "Conditions": []
        }
      ]
    },
    "entry-00009": {
      "Id": "entry-00009",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You are back from the slug grounds. Do you have the eight Slug Teeth for the toolmaker?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00013",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00014",
          "Conditions": []
        }
      ]
    },
    "entry-00010": {
      "Id": "entry-00010",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The toolmaker does. She cuts ice blocks for the cisterns, and the only thing that stays sharp against tundra ice is a Qion Slug's tooth. She pays me to supply her, and I will pay you. I need you to kill Qion Slugs and bring me eight Slug Teeth. Come back to me here when you have them.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00018",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00016",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00017",
          "Conditions": []
        }
      ]
    },
    "entry-00011": {
      "Id": "entry-00011",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good. Kill Qion Slugs on the Qion Tundra or in the Qion Valley and bring me eight Slug Teeth here. They are slow, but do not let one roll on you.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00015",
          "Conditions": []
        }
      ]
    },
    "entry-00012": {
      "Id": "entry-00012",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "That is Deine, who cooks with it, and I have tasted the result. He has his own arrangements. I only need the teeth, so bring those to me and leave him to his soup.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00016",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00017",
          "Conditions": []
        }
      ]
    },
    "entry-00013": {
      "Id": "entry-00013",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I still need eight Slug Teeth for the toolmaker. They come from the Qion Slugs on the Qion Tundra and in the Qion Valley. Bring all eight teeth back to me here.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00020",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00021",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        }
      ]
    },
    "entry-00014": {
      "Id": "entry-00014",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Then they got the message, at least for now. Here is your pay. They will come back down in time, and I hope you will come back too.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00000",
          "Conditions": []
        }
      ]
    },
    "entry-00015": {
      "Id": "entry-00015",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You are back, and I walked the north line yesterday and found every trap where I left it. Did you kill all twelve Byysk?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00023",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00024",
          "Conditions": []
        }
      ]
    },
    "entry-00016": {
      "Id": "entry-00016",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The Byysk have pushed down out of the Qion Foothills, and they break every trap they find. They leave the catch and stand the broken trap upright in the snow so I will see it. That is a message, and I would like to send one back. I need you to kill twelve Byysk, then come back to me here for your pay.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00028",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00026",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00027",
          "Conditions": []
        }
      ]
    },
    "entry-00017": {
      "Id": "entry-00017",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good. Kill twelve Byysk on the Qion Tundra, in the Qion Foothills or in the Frozen Caves, then come back to me here. They fight in pairs, one up close and one with a rifle.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00025",
          "Conditions": []
        }
      ]
    },
    "entry-00018": {
      "Id": "entry-00018",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "They want the tundra without us on it. They had it first, and I know that. I also know the outpost starves without the trap lines, so I cannot give it to them.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00026",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00027",
          "Conditions": []
        }
      ]
    },
    "entry-00019": {
      "Id": "entry-00019",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You still owe me twelve dead Byysk. They hold the Qion Tundra, the Qion Foothills and the Frozen Caves. Come back to me when you have killed all twelve.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00030",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        }
      ]
    },
    "entry-00020": {
      "Id": "entry-00020",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Then here is the watch rate. Sit by the heater for a minute before you go back out, and come back whenever you want the work again.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00000",
          "Conditions": []
        }
      ]
    },
    "entry-00021": {
      "Id": "entry-00021",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You look frozen through. Are the lines clear, with ten Qion Tigers and ten Qion Slugs dead?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00032",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00033",
          "Conditions": []
        }
      ]
    },
    "entry-00022": {
      "Id": "entry-00022",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I do, every week. The tigers take my catch and the slugs bury my traps, so I pay a watch rate out of the fur money to keep the lines clear. I need you to kill ten Qion Tigers and ten Qion Slugs, then come back to me for the rate. You can do it as often as the cold lets you.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00035",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00036",
          "Conditions": []
        }
      ]
    },
    "entry-00023": {
      "Id": "entry-00023",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good. Kill ten Qion Tigers and ten Qion Slugs out on the tundra, then come back to me here at the Hutlar Outpost for the watch rate.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00034",
          "Conditions": []
        }
      ]
    },
    "entry-00024": {
      "Id": "entry-00024",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The watch is ten Qion Tigers and ten Qion Slugs, killed out on the tundra. Come back to me when you have killed all of them and I will pay the rate.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00038",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        }
      ]
    }
  },
  "Choices": {
    "reply-00000": {
      "Id": "reply-00000",
      "Text": {
        "Text": "Stay warm, Brannoc. I will see you later.",
        "Style": 4,
        "Color": null
      },
      "SoundResref": "",
      "Animation": 0,
