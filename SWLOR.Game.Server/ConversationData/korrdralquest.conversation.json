      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The artifact is imbued with the power of the dark side--a fragment of knowledge essential to our strength. It belongs to the Sith, not to traitorous fools.",
