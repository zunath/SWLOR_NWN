      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good. Kill the rogues, and retrieve the artifact. Return to me when the deed is done. And remember failure is not an option.",
          "Style": 0,
          "Color": null
        }
