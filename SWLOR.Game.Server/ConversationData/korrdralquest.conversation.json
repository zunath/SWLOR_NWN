      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I see potential in you, but potential alone is worthless without action. Your next task will test your resourcefulness and strength.",
