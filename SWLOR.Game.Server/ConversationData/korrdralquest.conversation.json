      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The Dark Side is a power beyond the weak-minded. Some embrace it, others are consumed. This one failed to control it. Fear, doubt, delusions--their mind shattered like brittle glass. And now they wander the training grounds, lashing out in blind terror. A pathetic sight.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
