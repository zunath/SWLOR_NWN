      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "A Sith artifact of great importance has been stolen by a group of rogue initiates. They skulk in the temples in the valley, defiling their training by clinging to weakness. You will hunt them down and retrieve what they have taken.",
          "Style": 0,
          "Color": null
