      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The Force is the ultimate ally, a limitless source of energy waiting to be harnessed. It bends to the will of the powerful. Mastery of the Force is the key to breaking every chain and achieving true freedom.",
          "Style": 0,
          "Color": null
        }
      ],
