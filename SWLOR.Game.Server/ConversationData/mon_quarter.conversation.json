      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "No, she will not. Here is the archive's payment. Somewhere down there, a treaty is going to outlast both of us because of you.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00000",
          "Conditions": []
        }
      ]
    },
    "entry-00008": {
      "Id": "entry-00008",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You are back, and the ink has good color. The head archivist checks every bottle. Is that all five Tench Ink and five Tench Mantles?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00012",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00013",
          "Conditions": []
        }
      ]
    },
    "entry-00009": {
      "Id": "entry-00009",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The city archive keeps its permanent record by hand, in Tench ink on cured mantle, because it does not fade or burn and no slicer can change it. They are down to their last bottle. I need you to go to the Sunkenhedge Swamps and bring me five Tench Ink and five Tench Mantles. Bring them to me here and the archive will pay you.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00017",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00015",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00016",
          "Conditions": []
        }
      ]
    },
    "entry-00010": {
      "Id": "entry-00010",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good. Collect five Tench Ink and five Tench Mantles in the Sunkenhedge Swamps, then bring them to me here in the Elite Hotel. The Octotench carry the ink, and any Tench will do for mantle.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00014",
          "Conditions": []
        }
      ]
    },
    "entry-00011": {
