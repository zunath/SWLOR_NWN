      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good. Mine ten Raw Plagionite and ten Raw Scordspar from the veins scattered across the Coral Isles, then bring them to me here in the Elite Hotel. Take a decent harvester.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00034",
          "Conditions": []
        }
      ]
    },
