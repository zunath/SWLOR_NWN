      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "So does the harbor. Here is your payment. If the sensor arrays start working, I will pretend it was my idea.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00000",
          "Conditions": []
        }
      ]
    },
    "entry-00014": {
      "Id": "entry-00014",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You are back, and none of them are scorched. She will be insufferable about it. Is that all six Scorchellus Antennae?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00022",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00023",
          "Conditions": []
