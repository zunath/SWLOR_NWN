      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The archive still needs five Tench Ink and five Tench Mantles from the Tench in the Sunkenhedge Swamps. Bring them here to me when you have them all.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00019",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00020",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        }
      ]
