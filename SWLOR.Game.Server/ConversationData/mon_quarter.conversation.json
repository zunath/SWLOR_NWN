    "entry-00020": {
      "Id": "entry-00020",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You are back, and the yard foreman has been at my desk twice a day. Is that all ten Raw Plagionite and ten Raw Scordspar?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00032",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00033",
          "Conditions": []
        }
