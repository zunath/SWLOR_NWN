      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "It holds land titles, treaties and births, the things you want to still be true in three hundred years. The datacores get a copy, but the mantle holds the real record.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00015",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00016",
          "Conditions": []
        }
      ]
    },
