    "entry-00015": {
      "Id": "entry-00015",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The harbor sensors keep losing ships in the thermal layer. A technician upstairs swears that Scorchellus feel heat through their antennae better than her arrays do, and she wants some to take apart. I need you to go to the Sunkenhedge Swamps and bring me six Scorchellus Antennae. Bring them to me here and you will be paid.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00027",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00025",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00026",
          "Conditions": []
        }
      ]
    },
    "entry-00016": {
      "Id": "entry-00016",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good. Collect six Scorchellus Antennae from the Scorchellus on the dry ground of the Sunkenhedge Swamps, then bring them to me here in the Elite Hotel. They burn, so mind your hands.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00024",
          "Conditions": []
        }
      ]
    },
