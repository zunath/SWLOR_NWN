    },
    "entry-00003": {
      "Id": "entry-00003",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The chef has decided the guests want to taste Mon Cala instead of frozen imports, and he put Aradile on the menu without asking where Aradile comes from. I need you to go to the Coral Isles and bring me six Aradile Tails and four Viper Meat. Bring them to me here, fresh, and the hotel will pay you.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00007",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00006",
          "Conditions": []
        }
      ]
    },
    "entry-00004": {
      "Id": "entry-00004",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good. Collect six Aradile Tails and four Viper Meat from the Aradile and Vipers on the Coral Isles, then bring them to me here in the Elite Hotel. Keep them fresh, because he can tell.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00004",
          "Conditions": []
        }
      ]
    },
    "entry-00005": {
      "Id": "entry-00005",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "People who have never met one eat Aradile. The tail is the only part worth putting on a plate, which is why I am only asking for tails.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00006",
          "Conditions": []
        }
      ]
    },
    "entry-00006": {
      "Id": "entry-00006",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The kitchen still needs six Aradile Tails and four Viper Meat. Both come from the Coral Isles. Bring them here to me when you have them all.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00009",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00010",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        }
