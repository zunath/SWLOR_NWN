      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "The shipwrights patch hulls with an alloy of Plagionite and Scordspar, and the freighter that brings it is late because the Krakenborne are in orbit. There are veins of both on the Coral Isles. I need you to mine ten Raw Plagionite and ten Raw Scordspar there. Bring the ore to me here and the yard will pay you.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00037",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00035",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00036",
          "Conditions": []
        }
