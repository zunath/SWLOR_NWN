    },
    "entry-00003": {
      "Id": "entry-00003",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good, good. I knew I could count on you. The slugs in Qion have a spectacular bile. It's used in many medicines and, when cooked properly, tastes stupendious! Or should I say SOUP-PEN-DOUS? [He laughs hysterically for several minutes.]\n\nTell you what. If you go out to the Qion Tundra and bring me back five biles, I'll cook you up a spectacular remedy. Oh, and I'll throw in a few credits, too! What do you say? Interested?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00004",
          "Conditions": []
        }
      ]
    },
    "entry-00004": {
