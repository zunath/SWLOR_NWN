      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "A connoisseur of the finer things in life, eh? That's great, just really great. Then you must know of the Qion Slugs that traverse the Tundra, no?",
          "Style": 0,
          "Color": null
        }
      ],
