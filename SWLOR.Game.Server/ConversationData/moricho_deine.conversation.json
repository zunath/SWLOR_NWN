      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Slugs! We're talking about slugs. The finest slugs this side of Hutlar! They can be found throughout the Qion Tundra. You really MUST see them. They're spectacular - and quite tasty, too, I must admit.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00003",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00000",
          "Conditions": []
        }
