      "Text": [
        {
          "Text": "[SF-91021 looks you over. Although he has no iris or pupil, you can tell a sudden hope comes over his face. He raises his left hand and begins to speak.]",
          "Style": 1,
          "Color": null
        },
        {
          "Text": " \"Minii khelsniig oilgoj chadna gej kheleerei! Bi yarianykhaa programyg tokhiruulakh khen negend ünekheer kheregtei baina, tegeed bi niitleg yarij chadna!\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00000",
          "Conditions": []
        }
      ]
    },
    "entry-00001": {
      "Id": "entry-00001",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"Chi yaagaad nad shig kharj baina ve? Chi nadad tuslakh kheregtei! ... Bi aimshigtai süireld orson ... Bi khümüüstei dakhin yariltsaj, naiz nökhödteigee yarikh bolomjtoi baikhyg khüsch baina ... Ta nadad tusalj chadna gej kheleerei.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        }
      ]
    },
    "entry-00002": {
