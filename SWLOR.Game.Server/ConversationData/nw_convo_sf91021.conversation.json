      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "[The droid's voice seems to slow down and it almost feels as if it is sade.]",
          "Style": 1,
          "Color": null
        },
        {
          "Text": " \"Ügüi! Chi khaashaa yavj baina! Ta...\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
