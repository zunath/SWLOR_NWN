    },
    "entry-00001": {
      "Id": "entry-00001",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Dammit. He really needs to stop letting the riff-raff in here. Well, he wouldn't have done that if he didn't trust you to get some work done.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00007",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00003",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00002",
          "Conditions": []
        }
      ]
    },
    "entry-00002": {
      "Id": "entry-00002",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "As a matter of fact, I do. This will be a good test of your loyalty. Ready to hear some more?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00004",
          "Conditions": []
        }
      ]
    },
    "entry-00003": {
      "Id": "entry-00003",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "We've got a good rapport with a family that lives in the southwest of the mountain range. They supply us with intel on faction movements across Viscara and in return we protect them. \n\nThey notified us that they need help with something a couple days ago but all my boys are out on other jobs. I want you to go down and help them with whatever nonsense is troubling them. Help them out and then I'll answer any questions you may have.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00006",
          "Conditions": []
        }
      ]
    },
    "entry-00004": {
      "Id": "entry-00004",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "No questions yet. You need to prove your worth to me first.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00003",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00002",
          "Conditions": []
        }
      ]
    },
    "entry-00005": {
      "Id": "entry-00005",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Have you helped the family like I asked?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00011",
          "Conditions": [
            {
              "Key": "condition-on-quest-state",
              "Arguments": [
                "help_talyron_family",
                "4"
              ],
              "IsNegated": false
            }
          ]
        },
        {
          "ChoiceId": "reply-00009",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00008",
          "Conditions": []
        }
      ]
    },
    "entry-00006": {
      "Id": "entry-00006",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You need to listen better! Now pay attention...\n\nWe've got a good rapport with a family that lives in the southwest of the mountain range. They supply us with intel on faction movements across Viscara and in return we protect them. \n\nThey notified us that they need help with something a couple days ago but all my boys are out on other jobs. I want you to go down and help them with whatever nonsense is troubling them. Help them out and then I'll answer any questions you may have.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00010",
          "Conditions": []
        }
      ]
    },
    "entry-00007": {
      "Id": "entry-00007",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Excellent. If you were able to pull that off, I suppose I could use your muscle on some of the other jobs I need done. Take these credits. When you're ready for more work let me know.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00025",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00014",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00012",
          "Conditions": []
        }
      ]
    },
    "entry-00008": {
      "Id": "entry-00008",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Ready to get your hands dirty again?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00025",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00014",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00013",
          "Conditions": []
        }
      ]
    },
    "entry-00009": {
      "Id": "entry-00009",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "What do you want to know?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00022",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00019",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00015",
          "Conditions": []
        }
      ]
    },
    "entry-00010": {
      "Id": "entry-00010",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Tristan supplies us with information. He's been an employee with Czerka for a long time and he's privvy to their movements. So if there's a shipment they're moving from one side of the planet to another he informs us and in return we \"protect\" him.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00017",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00016",
          "Conditions": []
        }
      ]
    },
    "entry-00011": {
      "Id": "entry-00011",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Oh, no. I would never stoop to that level [he smirks for a moment]. He and his family live a good life thanks to our protection.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00018",
          "Conditions": []
        }
      ]
    },
    "entry-00012": {
      "Id": "entry-00012",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "This building was used by Czerka in the early days - you know, when they first arrived on Viscara. It was used as a manufacturing plant for a variety of drugs and stims. Once they discovered the numerous raw resources on Viscara they scrapped the project, deciding to focus entirely on harvesting them instead.\n\nThe teams assigned here were let go or relocated to CZ-220 which orbits the planet. I take it you've been there already?\n\nWe came across it and decided to use it as our base of operations while we establish ourselves on Viscara.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00021",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00020",
          "Conditions": []
        }
      ]
    },
    "entry-00013": {
      "Id": "entry-00013",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "I am Reid Coxxion, leader of this rag-tag band of smugglers. I'm from Tatooine originally but a series of... unfortunate events led me to the life I live now. \n\nMy boys and I relocated here a few months ago once word got out about the raw materials found on this planet. We don't care much for the materials themselves, mind you, but there's plenty of credits to be made.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00023",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00021",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00020",
          "Conditions": []
        }
      ]
    },
    "entry-00014": {
      "Id": "entry-00014",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "As you probably know, Czerka controls the majority of the planet. Between Veles Colony and the asteroid base orbiting above the planet, they have things on lock down pretty well. But there have been several competing factions who have shown up to lay claim to the raw materials found on this planet. \n\nYou can imagine that the tension has begun heating up.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00024",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00021",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00020",
          "Conditions": []
        }
      ]
    },
    "entry-00015": {
      "Id": "entry-00015",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Well, where there is conflict, there's money to be made. I'm not about to divulge all of my secrets, mind you, but let's just say that we do a little bit of work for all of the factions. Stealing weapons from Czerka, supplying them to competing factions, that sort of thing. It's dirty, but it pays the bills.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00021",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00020",
          "Conditions": []
        }
      ]
    },
    "entry-00016": {
      "Id": "entry-00016",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good. This one is going to require some effort on your part.\n\nWe've gotten word that a group of Vellen has taken over one of our hideouts deeper in the mountains. I need you to sneak in and run them out of our territory.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00029",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00027",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00026",
          "Conditions": []
        }
      ]
    },
    "entry-00017": {
      "Id": "entry-00017",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Vellen are a nasty group of cannibals. They're native to Viscara and haven't taken too kindly to their planet being invaded by groups like Czerka. They don't care much for us, either, it seems. If you take this job you're going to need to watch yourself. I'd hate for them to gnaw off one of your limbs.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00028",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00026",
          "Conditions": []
        }
      ]
    },
    "entry-00018": {
      "Id": "entry-00018",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You better watch yourself. These aren't ordinary fighters. Our base is located deeper in the mountains. Head north west from here and you'll find it.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00030",
          "Conditions": []
        }
      ]
    },
    "entry-00019": {
      "Id": "entry-00019",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "How goes your Vellen hunt?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00032",
          "Conditions": [
            {
              "Key": "condition-on-quest-state",
              "Arguments": [
                "vanquish_vellen",
                "2"
              ],
              "IsNegated": false
            }
          ]
        },
        {
          "ChoiceId": "reply-00031",
          "Conditions": []
        }
      ]
    },
    "entry-00020": {
      "Id": "entry-00020",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Excellent work. I trust you didn't have any problems with them?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00033",
          "Conditions": []
        }
      ]
    },
    "entry-00021": {
      "Id": "entry-00021",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "That much is true. Who was the ringleader in all of this?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00034",
          "Conditions": []
        }
      ]
    },
    "entry-00022": {
      "Id": "entry-00022",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Lightsabers? Where on Viscara would they get a hold of those? This is very peculiar indeed. Take a rest for now. I might have more work for you later.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00035",
          "Conditions": []
        }
      ]
    },
    "entry-00023": {
      "Id": "entry-00023",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You're back again, eh? I don't have anything for you right now. Check with me later, yeah?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": []
    }
  },
