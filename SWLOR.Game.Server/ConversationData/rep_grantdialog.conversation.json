      "Text": [
        {
          "Text": "Primly dressed and with an almost haughty demeanour, Lieutenant Marbury Grant stands surveying the atrium of Outpost Hope with a blandly attentive expression.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
