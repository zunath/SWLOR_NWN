      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"It's... Viscara. I was with a scouting party, on an expedition across the deep mountains. We found a cave, and it went deep, deeper than we thought it would. And there, we just... there are things beneath the earth, things that I don't... I don't understand.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
