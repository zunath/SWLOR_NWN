      "Actions": [],
      "Next": [],
      "EndsConversation": true,
      "IsAutomatic": false
    },
    "reply-00002": {
      "Id": "reply-00002",
      "Text": {
        "Text": "Indicate readiness and bade the training program to continue.",
        "Style": 4,
        "Color": null
      },
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Actions": [],
      "Next": [
        {
          "TargetNodeId": "entry-00002",
          "Conditions": []
        }
      ],
      "EndsConversation": false,
      "IsAutomatic": false
    },
    "reply-00003": {
      "Id": "reply-00003",
      "Text": {
        "Text": "\"Accept their surrender, and have them kept in prisoner-of-war camps until they can be tried for their actions and punished in accordance with the laws of the Republic, sir!\"",
        "Style": 4,
        "Color": null
      },
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Actions": [],
      "Next": [
        {
          "TargetNodeId": "entry-00003",
          "Conditions": []
        }
      ],
      "EndsConversation": false,
      "IsAutomatic": false
    },
    "reply-00004": {
