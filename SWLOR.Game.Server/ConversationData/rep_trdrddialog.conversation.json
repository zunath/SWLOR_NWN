      "EndsConversation": false,
      "IsAutomatic": false
    },
    "reply-00001": {
      "Id": "reply-00001",
      "Text": {
        "Text": "\"Nope. Nope. Can't deal with this. Nope.\"",
        "Style": 4,
        "Color": null
