      "Text": {
        "Text": "Continue the test...",
        "Style": 4,
        "Color": null
      },
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Actions": [],
      "Next": [
