      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": " *He is standing at attention next to the Republic flag in Outpost Hope's parade square. He does not seem very keen on being disturbed at all.*",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "oath-reply-00000",
          "Conditions": [
            {
              "Key": "condition-on-quest-state",
