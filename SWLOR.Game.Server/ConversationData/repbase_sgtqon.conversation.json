          "Conditions": []
        }
      ]
    },
    "entry-00001": {
      "Id": "entry-00001",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "*After a moment you can hear the Sergeant mutter reverently under his breath* \n\"Kriff... I love democracy...\" \n*Is that... a tear in his eye?*\n",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00002",
          "Conditions": []
        }
      ]
    },
    "oath-entry-00001": {
      "Id": "oath-entry-00001",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "He offers an appraising look, before nodding tersely. Placing a clenched fist over his chest, he speaks in a low rumble of a voice. \"Repeat after me, recruit, when you are ready.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "oath-reply-00013",
          "Conditions": []
        },
        {
          "ChoiceId": "oath-reply-00001",
          "Conditions": []
        }
      ]
    },
    "oath-entry-00002": {
      "Id": "oath-entry-00002",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Sergeant Qon, beneath the flag, recites the oath with an air of solemn severity. \"I do solemnly affirm that as a soldier of the Galactic Republic, I shall serve the Republic, the Senate, and its People.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "oath-reply-00003",
          "Conditions": []
        },
        {
          "ChoiceId": "oath-reply-00002",
          "Conditions": []
        }
      ]
    },
    "oath-entry-00003": {
      "Id": "oath-entry-00003",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"I shall obey the lawful orders of duly commissioned officers, elected officials of rank, and the Supreme chancellor.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "oath-reply-00005",
          "Conditions": []
        },
        {
          "ChoiceId": "oath-reply-00004",
          "Conditions": []
        }
      ]
    },
    "oath-entry-00004": {
      "Id": "oath-entry-00004",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"Should the orders I be given be illegal, unlawful, or a violation of the rights of a sentient being, I am duty bound to protest, disobey, and even fight against them.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "oath-reply-00007",
          "Conditions": []
        },
        {
          "ChoiceId": "oath-reply-00006",
          "Conditions": []
        }
      ]
    },
