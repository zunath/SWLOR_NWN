      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"I shall safeguard and defend the Galactic Constitution and its ideals against all foes within and without, and to do according to the laws and regulations of the Republic, even at the sacrifice of my life.\"",
          "Style": 0,
          "Color": null
        }
      ],
