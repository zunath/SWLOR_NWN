      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Drink, I guess. There is not much to do here if you are not working for Czerka, and these criminals don't deserve our sweat. My friend and I hunt a bit in the Wildlands and the furs are enough to earn money, rent an apartment here in Veles and spend our nights at the bar.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
