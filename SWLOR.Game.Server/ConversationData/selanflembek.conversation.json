      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "As a matter of fact, I do. Visitors are quite careless with their belongings around here. You may as well take it - I have no need for it.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        }
      ]
    },
    "entry-00002": {
      "Id": "entry-00002",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "[Her eyes narrow slightly] Yes, yes it is. Welcome to CZ-220, the latest mining venture from Czerka Corporation, [she says, dryly] What can I do for you today?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00004",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00002",
          "Conditions": []
        }
      ]
    },
    "entry-00003": {
      "Id": "entry-00003",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Now that you mention it, there is. [She lifts her datapad from the desk, and hands it to you] This is my workload. As you can see it's rather hectic. I'm the facilities manager here, but with our reception droid out of commission, I'm stuck at this bloody desk for the foreseeable future! Pick three things on the list, get receipts from my staff, and bring them back. I'll make sure you're paid for your time.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00006",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
        }
      ]
    },
    "entry-00004": {
      "Id": "entry-00004",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "You're back. Have you gotten three receipts yet?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00008",
          "Conditions": [
            {
              "Key": "condition-all-key-items",
              "Arguments": [
                "1",
