      "Text": [
        {
          "Text": "[Selan sighs, throwing her datapad onto her desk with a clatter] Great, just great! Another thing to worry about. [She looks up to you with irritation in her eyes] Hm? What is it?",
          "Style": 0,
          "Color": null
        }
      ],
