      "Choices": [
        {
          "ChoiceId": "reply-00003",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00002",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00000",
          "Conditions": [
            {
              "Key": "condition-has-completed-tutorial",
              "Arguments": [],
              "IsNegated": false
            },
            {
              "Key": "condition-all-key-items",
              "Arguments": [
                "5"
              ],
              "IsNegated": true
            }
          ]
        }
