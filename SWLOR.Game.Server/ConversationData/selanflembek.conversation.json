      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Good, good. Well, as promised, here are your credits. Czerka thanks you for your assistance. \n\nI believe a shuttle headed to Viscara has just arrived. If you would like to head down to the planet, go to the hangar and talk to the staff member there. I believe Galatea Allerti is the person on duty right now. [She hands you a shuttle pass] You'll need this to get on board. Now if you'll excuse me, I'm very busy.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00009",
          "Conditions": []
        }
      ]
