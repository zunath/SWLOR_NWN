      "JournalQuest": "",
      "Text": [
        {
          "Text": "Hello, I am Szaan Synko. I work for the Czerka Refugees Care Foundation.\n\nWe try to provide help to all the refugees arriving here in Veles Colony.\n\nSince the end of the war, thousands of people are in constant need for food, housing and clothes.\n\nIt's a hard job, but the Czerka Corporation is proud to offer help to those in need.\n",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00000",
