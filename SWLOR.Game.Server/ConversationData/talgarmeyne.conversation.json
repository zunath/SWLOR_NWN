      "Text": [
        {
          "Text": "We have reports there is a Mandalorian facility located somewhere in the Wildwoods but we don't know where it is. I sent out a search party a few days ago but they haven't come back yet.\n\nYou will have to leave the city, go into the Wildlands and head east. I just want you to recon the Wildwoods, find that facility and come back to me. Got it?",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00007",
          "Conditions": []
