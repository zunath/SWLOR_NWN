      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "My wagers are simple. I say a thing cannot be done, you do it, and I pay. The Sand Worm lives under the Flatlands and comes up for anything heavy, and four people have died trying. I need you to kill the Sand Worm. Come back to me here at the spaceport when it is dead and I will pay out.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
