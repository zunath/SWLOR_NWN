      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Excellent. Kill the Sand Worm, which surfaces in the Flatlands and the Southern Pass, then come back to me here at the Anchorhead Spaceport to collect.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
