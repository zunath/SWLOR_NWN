      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "They're crawling all over the place. It's really frightening my family, too. One of them got close to our home and scared the kids.",
          "Style": 0,
          "Color": null
