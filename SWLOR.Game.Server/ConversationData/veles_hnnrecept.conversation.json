      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"Why, nothing boring at all! Adventure around and find news, then let us know about said news, and even better, write news article about what you may have found! We'll then help edit and publish them, and in time, you may even come to earn both great fame and rich rewards from head office!\"",
          "Style": 0,
          "Color": null
        }
