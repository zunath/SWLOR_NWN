      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"You start off as a reporter with a very, very lax mandate; to go forth be it on this world or another world in the galaxy altogether, to find the news, and report it to the good people of said galaxy! If you do very well, you could then be promoted to an editor, and maybe even someday, manager of a branch of the HoloNet News! Furthermore, it's always a good launching pad for a person who wants to make a name for himself in Veles itself, and such a reputation could well springboard someone to a political office or beyond.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00003",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00002",
          "Conditions": []
        }
