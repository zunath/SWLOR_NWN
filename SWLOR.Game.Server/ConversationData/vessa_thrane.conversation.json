      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "One last rebuild. After this, no locker in the galaxy holds more, and I'll have built it.\n\nA master's archive deserves master's materials. Don't bring me anything ordinary.",
          "Style": 0,
          "Color": null
