          "Conditions": [
            {
              "Key": "condition-has-quest",
              "Arguments": [
                "wardrobe_expansion_4"
              ],
              "IsNegated": false
            }
          ]
        },
        {
          "ChoiceId": "reply-00001",
          "Conditions": [
            {
              "Key": "condition-has-quest",
              "Arguments": [
                "wardrobe_expansion_4"
              ],
              "IsNegated": true
            }
          ]
        }
      ]
    },
    "entry-00018": {
      "Id": "entry-00018",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "Ghal and Urrok. You'll earn this one.",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
