    "entry-00001": {
      "Id": "entry-00001",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
