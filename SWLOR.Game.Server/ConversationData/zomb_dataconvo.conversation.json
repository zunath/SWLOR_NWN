      "Text": [
        {
          "Text": "RESTRICTED ACCESS | ACCESS LEVEL \"DIRECTOR\" REQUIRED",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
