  "Nodes": {
    "entry-00000": {
      "Id": "entry-00000",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "[He glances up from his datapad.] \"You look like someone who does not scare easily. A few weeks back I picked up a distress beacon in orbit over Viscara. It is coming from a research station that should have been empty for years.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00000",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00002",
          "Conditions": []
        }
      ]
    },
    "entry-00001": {
      "Id": "entry-00001",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"Enough to wish I had not looked. The station was running trials on bringing the dead back, and the logs I pulled stop halfway through a sentence. Their Colicoid specimens got loose when containment failed. Now the corridors are full of those things and crew who should have stayed dead.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00001",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00003",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00002",
          "Conditions": []
        }
      ]
    },
    "entry-00002": {
      "Id": "entry-00002",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"Not on any shuttle line, that's for sure. You will need someone with a ship. Look for the Abandoned Station in Viscara orbit and use its docking point. The Viscara planetary dock will not take you there. And if your ride leaves without you, the docking bay has escape pods. They are all set to come back to the Veles starport.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00003",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00002",
          "Conditions": []
        }
      ]
    },
    "entry-00003": {
      "Id": "entry-00003",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"Still going back up there? Twenty of them. Find a pilot, and watch the dark corners.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00008",
          "Conditions": []
        },
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
        }
      ]
    },
    "entry-00004": {
      "Id": "entry-00004",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "[He sets the datapad down as you approach.] \"You made it back. Tell me.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00006",
          "Conditions": []
        }
      ]
    },
    "entry-00005": {
      "Id": "entry-00005",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"Twenty of them. Put them down for good, then come find me here. I cannot pay much, but I will not forget it.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00004",
          "Conditions": []
        }
      ]
    },
    "entry-00006": {
      "Id": "entry-00006",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "\"Not on any shuttle line, that's for sure. You will need someone with a ship. Look for the Abandoned Station in Viscara orbit and use its docking point. The Viscara planetary dock will not take you there. And if your ride leaves without you, the docking bay has escape pods. They are all set to come back to the Veles starport.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00005",
          "Conditions": []
        }
      ]
    },
    "entry-00007": {
      "Id": "entry-00007",
      "SpeakerName": "",
      "SpeakerTag": "",
      "PortraitResref": "",
      "SoundResref": "",
      "Animation": 0,
      "AnimationLoops": true,
      "Delay": 4294967295,
      "Comment": "",
      "JournalQuest": "",
      "Text": [
        {
          "Text": "[He listens without interrupting, then nods slowly.] \"Then it is done, for now. That station keeps making more of them. If you go back, I will pay again.\"",
          "Style": 0,
          "Color": null
        }
      ],
      "OnEnterActions": [],
      "Choices": [
        {
          "ChoiceId": "reply-00007",
          "Conditions": []
        }
      ]
    }
  },
