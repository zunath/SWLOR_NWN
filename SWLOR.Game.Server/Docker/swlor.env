NWNX_TWEAKS_SEND_TLK_OVERRIDE_BEFORE_CHARGEN=true
NWNX_TWEAKS_ALWAYS_RETURN_FULL_DEX_STAT=true
NWNX_METRICS_INFLUXDB_HOST=influxdb
NWNX_METRICS_INFLUXDB_PORT=8089
NWNX_OPTIMIZATIONS_GAME_OBJECT_LOOKUP=true
NWNX_OPTIMIZATIONS_PLAYER_LOOKUP=true
NWNX_OPTIMIZATIONS_LUO_LOOKUP=true
NWNX_TWEAKS_HIDE_PLAYERS_ON_CHAR_LIST=3

# SWLOR Application Environment Variables
SWLOR_APP_LOG_DIRECTORY=/nwn/home/app_logs/
SWLOR_SUPER_ADMIN_CD_KEY=
SWLOR_BUG_GITHUB_REPOSITORY=
SWLOR_BUG_GITHUB_TOKEN=
SWLOR_BUG_CODEX_REVIEW_ENABLED=false
SWLOR_BUG_DISCORD_WEBHOOK_URL=
SWLOR_HOLONET_WEBHOOK_URL=
SWLOR_DM_SHOUT_WEBHOOK_URL=
SWLOR_PROPERTY_BROADCAST_WEBHOOK_URL=
SWLOR_SERVER_NOTIFICATION_WEBHOOK_URL=
# SWLOR_ENVIRONMENT expects either 'dev', 'test' or 'production' values
SWLOR_ENVIRONMENT=dev

# RP XP out-of-character (OOC) chat settings.
# Blank or invalid values use the built-in defaults. Allowances reset daily at the scheduled
# restart time, not on every boot. Changes apply when the container is recreated
# (docker compose up -d); a plain restart keeps the old values.

# Free OOC messages per character per day.
# Valid values: a whole number, 0 or greater. 0 means every OOC message is penalized.
SWLOR_RPXP_OOC_DAILY_ALLOWANCE=

# Extra free OOC messages per day while a DM or DM-possessed creature is in the player's area.
# Used before the daily allowance.
# Valid values: a whole number, 0 or greater. 0 disables the extra allowance.
SWLOR_RPXP_OOC_DM_ALLOWANCE=

# Free OOC messages per day in event areas. Used before the DM and daily allowances.
# Valid values: 'unlimited' or -1 for no limit (blank also means no limit), or a whole
# number, 0 or greater. 0 disables the extra allowance.
SWLOR_RPXP_OOC_EVENT_ALLOWANCE=

# Percent of the next RP XP award removed for each OOC message past the allowances.
# Valid values: a whole number from 0 to 100. 0 disables the penalty; values above 100 are
# treated as 100.
SWLOR_RPXP_OOC_PENALTY_PERCENT=

# Path, inside the container, of the OOC detection file. Blank uses the default below, which is
# the rpxp-ooc-detection.json file in the server home next to this swlor.env. The file is optional;
# without it only the built-in word list is used. It is read at server start, so editing the file
# only needs a server restart.
# Valid values: an absolute file path, e.g. /nwn/home/rpxp-ooc-detection.json.
# File format (JSON, every field optional):
#   "terms":     words and emoticons that mark text outside quotes as OOC; replaces the built-in list.
#                Leave the field out to keep the built-in list; an empty list [] turns word matching off.
#                Matching ignores case, and each entry must match a whole word or emoticon. Stretched
#                laughter (extra letters) matches only when its base word is listed.
#   "weights":   message-scoring weights produced by tools/TrainRoleplayOOCModel.py.
#   "threshold": number from 0 to 1 at or above which a scored message counts as OOC (default 0.5).
#                A file with a threshold or weight that is not a finite number is rejected at start.
#                Lower catches more OOC but also flags more in-character messages.
SWLOR_RPXP_OOC_DETECTION_FILE=
