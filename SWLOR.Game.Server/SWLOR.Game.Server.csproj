<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>10</LangVersion>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\SpaceActivities.json" LogicalName="SWLOR.SpaceActivities.json" />
    <EmbeddedResource Include="Data\SpaceEconomy.json" LogicalName="SWLOR.SpaceEconomy.json" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NRediSearch" Version="2.2.79" />
    <PackageReference Include="NReJSON" Version="4.0.0" />
    <PackageReference Include="NWN.Core" Version="8193.37.4" />
    <PackageReference Include="NWN.Native" Version="8193.37.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SWLOR.NWN.API\SWLOR.NWN.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ConversationData\**\*.conversation.json" />
    <EmbeddedResource Include="Data\ShipFitting.json" LogicalName="SWLOR.ShipFitting.json" />
    <EmbeddedResource Include="Data\SpaceIndustry.json" LogicalName="SWLOR.SpaceIndustry.json" />
    <EmbeddedResource Include="Data\ShipTechniques.json" LogicalName="SWLOR.ShipTechniques.json" />
    <EmbeddedResource Include="Data\SpaceEncounters.json" LogicalName="SWLOR.SpaceEncounters.json" />
  </ItemGroup>

  <Target Name="NWN" AfterTargets="Build">
    <ItemGroup>
      <AllOutputs Include="$(OutputPath)$(MSBuildProjectName).dll" />
      <AllOutputs Include="$(OutputPath)$(MSBuildProjectName).pdb" />
      <AllOutputs Include="$(OutputPath)$(MSBuildProjectName).runtimeconfig.json" />
      <AllOutputs Include="$(OutputPath)$(MSBuildProjectName).deps.json" />
    </ItemGroup>
  </Target>

  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' AND '$(RunPostBuildEvent)' != 'Never'">
    <Exec Command="call &quot;..\tools\SWLOR.CLI\RunCLI.cmd&quot; -o --server-output &quot;$(TargetDir).&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\..\Build" />
  </Target>
</Project>
