<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>10</LangVersion>
    <OutputType>Library</OutputType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NRediSearch" Version="2.2.79" />
    <PackageReference Include="NReJSON" Version="4.0.0" />
    <PackageReference Include="NWN.Core" Version="8193.37.7" />
    <PackageReference Include="NWN.Native" Version="8193.37.8" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SWLOR.Game.Contracts\SWLOR.Game.Contracts.csproj" />
    <ProjectReference Include="..\SWLOR.NWN.API\SWLOR.NWN.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ConversationData\**\*.conversation.json" />
    <!-- The order script handlers run in (see Core/ScriptHandlerManifest.cs). Embedded so it is deployed inside the server assembly. -->
    <EmbeddedResource Include="Core\ScriptHandlerOrder.txt" LogicalName="ScriptHandlerOrder.txt" />
    <EmbeddedResource Include="Feature\AppearanceDefinition\Preview\AppearancePartNames.json" />
  </ItemGroup>

  <Target Name="NWN" AfterTargets="Build">
    <ItemGroup>
      <AllOutputs Include="$(OutputPath)$(MSBuildProjectName).dll" />
      <AllOutputs Include="$(OutputPath)$(MSBuildProjectName).pdb" />
      <AllOutputs Include="$(OutputPath)$(MSBuildProjectName).runtimeconfig.json" />
      <AllOutputs Include="$(OutputPath)$(MSBuildProjectName).deps.json" />
    </ItemGroup>
  </Target>

  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' AND '$(RunPostBuildEvent)' != 'Never'">
    <!-- The host entry (swlor.env SWLOR_DOTNET_ENTRY=host) also deploys SWLOR.Game.Host of the same configuration. It is
         built here, with this build's global properties, so a build of this project alone deploys a current host too; in
         a solution build the solution has already built it (ProjectDependencies in SWLOR.Game.Server.sln) and MSBuild
         returns that result. The host has no post-build step, so this does not recurse. This project does not reference
         the host, so a build of it alone has not restored the host's packages: restore them first, in an evaluation of
         its own (the session id), so the build evaluation below reads the restored assets. -->
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\SWLOR.Game.Host\SWLOR.Game.Host.csproj" Targets="Restore"
             Properties="MSBuildRestoreSessionId=$([System.Guid]::NewGuid())" />
    <MSBuild Projects="$(MSBuildProjectDirectory)\..\SWLOR.Game.Host\SWLOR.Game.Host.csproj" Targets="Build">
      <Output TaskParameter="TargetOutputs" ItemName="SwlorHostAssembly" />
    </MSBuild>
    <Exec Command="call &quot;..\tools\SWLOR.CLI\RunCLI.cmd&quot; -o --server-output &quot;$(TargetDir).&quot; --host-output &quot;@(SwlorHostAssembly->'%(RootDir)%(Directory)').&quot;" WorkingDirectory="$(MSBuildProjectDirectory)\..\Build" />
  </Target>
</Project>
