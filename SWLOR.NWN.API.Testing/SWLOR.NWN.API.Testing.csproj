<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test doubles for the engine seam in SWLOR.NWN.API. Referenced only by test projects: nothing in the game server
    references it, so it never ships. Generated/ holds FakeNWScript, written by tools/Refactor/SWLOR.EngineSeamGenerator.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SWLOR.NWN.API\SWLOR.NWN.API.csproj" />
  </ItemGroup>

</Project>
