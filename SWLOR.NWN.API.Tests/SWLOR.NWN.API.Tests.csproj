<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proofs for the engine seam in SWLOR.NWN.API: every static wrapper forwards to the engine interface, the runtime swaps
    and restores the engine, and the checked-in generated output is exactly what tools/Refactor/SWLOR.EngineSeamGenerator
    produces. These tests need no game engine and no hak data.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SWLOR.NWN.API\SWLOR.NWN.API.csproj" />
    <ProjectReference Include="..\SWLOR.NWN.API.Testing\SWLOR.NWN.API.Testing.csproj" />
    <ProjectReference Include="..\tools\Refactor\SWLOR.EngineSeamGenerator\SWLOR.EngineSeamGenerator.csproj" />
  </ItemGroup>

</Project>
