<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SWLOR.ProcgenReview</AssemblyName>
    <RootNamespace>SWLOR.ProcgenReview</RootNamespace>
  </PropertyGroup>

  <!--
    Links the pure (engine-free) generation sources and theme definitions directly, so the
    review module always reflects the exact production solver and dungeon definitions.
  -->
  <ItemGroup>
    <Compile Include="..\SWLOR.Game.Server\Service\AreaGenerationService\TilesetModel.cs" Link="Generation\TilesetModel.cs" />
    <Compile Include="..\SWLOR.Game.Server\Service\AreaGenerationService\TilesetSetParser.cs" Link="Generation\TilesetSetParser.cs" />
    <Compile Include="..\SWLOR.Game.Server\Service\AreaGenerationService\AreaLayout.cs" Link="Generation\AreaLayout.cs" />
    <Compile Include="..\SWLOR.Game.Server\Service\AreaGenerationService\LayoutParameterConstraints.cs" Link="Generation\LayoutParameterConstraints.cs" />
    <Compile Include="..\SWLOR.Game.Server\Service\AreaGenerationService\MacroLayoutGenerator.cs" Link="Generation\MacroLayoutGenerator.cs" />
    <Compile Include="..\SWLOR.Game.Server\Service\AreaGenerationService\TileResolver.cs" Link="Generation\TileResolver.cs" />
    <Compile Include="..\SWLOR.Game.Server\Service\AreaGenerationService\TileDoorPlanner.cs" Link="Generation\TileDoorPlanner.cs" />
    <Compile Include="..\SWLOR.Game.Server\Service\AreaGenerationService\TileDoorGeometry.cs" Link="Generation\TileDoorGeometry.cs" />
    <Compile Include="..\SWLOR.Game.Server\Service\AreaGenerationService\GroupExitPlanner.cs" Link="Generation\GroupExitPlanner.cs" />
    <Compile Include="..\SWLOR.Game.Server\Service\AreaGenerationService\DungeonDefinition.cs" Link="Generation\DungeonDefinition.cs" />
    <Compile Include="..\SWLOR.Game.Server\Service\AreaGenerationService\Layouts\*.cs" Link="Generation\Layouts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\SWLOR.Game.Server\Feature\DungeonDefinition\IDungeonListDefinition.cs" Link="Definitions\IDungeonListDefinition.cs" />
    <Compile Include="..\SWLOR.Game.Server\Feature\DungeonDefinition\IDungeonTilesetProfileListDefinition.cs" Link="Definitions\IDungeonTilesetProfileListDefinition.cs" />
    <Compile Include="..\SWLOR.Game.Server\Feature\DungeonDefinition\IDungeonLayoutProfileListDefinition.cs" Link="Definitions\IDungeonLayoutProfileListDefinition.cs" />
    <Compile Include="..\SWLOR.Game.Server\Feature\DungeonDefinition\StandardTilesetProfiles.cs" Link="Definitions\StandardTilesetProfiles.cs" />
    <Compile Include="..\SWLOR.Game.Server\Feature\DungeonDefinition\StandardLayoutProfiles.cs" Link="Definitions\StandardLayoutProfiles.cs" />
    <Compile Include="..\SWLOR.Game.Server\Feature\DungeonDefinition\MineCaveDungeonDefinition.cs" Link="Definitions\MineCaveDungeonDefinition.cs" />
    <Compile Include="..\SWLOR.Game.Server\Feature\DungeonDefinition\SciFiBaseDungeonDefinition.cs" Link="Definitions\SciFiBaseDungeonDefinition.cs" />
    <Compile Include="..\SWLOR.Game.Server\Feature\DungeonDefinition\SewerDungeonDefinition.cs" Link="Definitions\SewerDungeonDefinition.cs" />
    <Compile Include="..\SWLOR.Game.Server\Feature\DungeonDefinition\AlienRuinDungeonDefinition.cs" Link="Definitions\AlienRuinDungeonDefinition.cs" />
  </ItemGroup>

</Project>
