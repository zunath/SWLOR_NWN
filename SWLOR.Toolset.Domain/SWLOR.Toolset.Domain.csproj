<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SWLOR.Toolset.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\External\Radoub\Radoub.Formats\Radoub.Formats\Radoub.Formats.csproj" />
    <ProjectReference Include="..\SWLOR.Game.Server\SWLOR.Game.Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- BioWare's proprietary DDS variant needs conversion to standard DDS before Pfim can
         decode it (see Render/TextureLoader.cs). Version pinned to match Radoub.UI's own pin. -->
    <PackageReference Include="Pfim" Version="0.11.4" />
  </ItemGroup>

</Project>
