<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SWLOR.Toolset.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SWLOR.NWN.Formats\SWLOR.NWN.Formats.csproj" />
    <ProjectReference Include="..\SWLOR.Game.Server\SWLOR.Game.Server.csproj"
                      AdditionalProperties="RunPostBuildEvent=Never" />
  </ItemGroup>

  <ItemGroup>
    <!-- BioWare's proprietary DDS variant is wrapped as standard DXT before Pfim decodes it. -->
    <PackageReference Include="Pfim" Version="0.11.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

</Project>
