<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SWLOR.Toolset"
             xmlns:core="using:Dock.Model.Core"
             xmlns:editors="using:SWLOR.Toolset.Editors"
             xmlns:triggers="using:SWLOR.Toolset.Editors.Triggers"
             xmlns:placeables="using:SWLOR.Toolset.Editors.Placeables"
             x:Class="SWLOR.Toolset.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <!-- Shared editor field templates: one app-wide copy for every blueprint/area field
         editor, formerly duplicated verbatim in BlueprintEditorView and AreaEditorView. Listed
         before the ViewLocator catch-all. -->
    <DataTemplate DataType="editors:LocStringFieldViewModel">
      <Grid ColumnDefinitions="180,*,Auto" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Top" Margin="0,5,0,0"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}"
                 IsVisible="{Binding IsSingleLine}" />
        <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}"
                 IsVisible="{Binding IsMultiline}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="120" VerticalContentAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        <TextBlock Grid.Column="2" Text="{Binding StrRefDisplay}" Classes="count"
                   VerticalAlignment="Top" Margin="6,5,0,0" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:CheckFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:IntegerFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <NumericUpDown Grid.Column="1" Value="{Binding Value, Mode=TwoWay}"
                       FormatString="0" Increment="1" IsEnabled="{Binding !IsReadOnly}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:FloatFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <NumericUpDown Grid.Column="1" Value="{Binding Value, Mode=TwoWay}"
                       Increment="0.5" IsEnabled="{Binding !IsReadOnly}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:DropdownFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <ComboBox Grid.Column="1" IsVisible="{Binding HasOptions}"
                  ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                  MaxDropDownHeight="400" />
        <NumericUpDown Grid.Column="1" IsVisible="{Binding !HasOptions}"
                       Value="{Binding RawValue, Mode=TwoWay}" FormatString="0" Increment="1" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:ScriptFieldViewModel">
      <StackPanel Margin="0,2">
        <Grid ColumnDefinitions="180,*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                     Classes="dim" TextTrimming="CharacterEllipsis" />
          <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}"
                   FontFamily="{DynamicResource MonoFont}" />
          <Button Grid.Column="2" Content="..." Margin="4,0,0,0" Padding="8,4"
                  Command="{Binding BrowseCommand}" IsVisible="{Binding CanBrowse}"
                  ToolTip.Tip="Browse module scripts" />
          <Button Grid.Column="3" Content="Open" Margin="4,0,0,0" Padding="8,4"
                  Command="{Binding OpenScriptCommand}" IsVisible="{Binding CanBrowse}"
                  ToolTip.Tip="Open this script in an editor tab" />
        </Grid>
        <!-- A slot naming a script that does not exist is a live, otherwise invisible bug across the
             2,250 module resources that name one. -->
        <TextBlock Margin="184,2,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource AmberBrush}"
                   IsVisible="{Binding IsMissing}" Text="{Binding MissingMessage}" />
      </StackPanel>
    </DataTemplate>

    <!-- A resref that names another module resource. Editable text with the real list attached, so
         a value from a hak stays typeable and an unknown one says so rather than being rejected. -->
    <DataTemplate DataType="editors:ResourcePickerFieldViewModel">
      <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <AutoCompleteBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}"
                         ItemsSource="{Binding Choices}" FilterMode="Contains"
                         FontFamily="Consolas,monospace" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UnknownHint}" Classes="label"
                   Foreground="{DynamicResource AmberBrush}" Margin="0,3,0,0"
                   IsVisible="{Binding IsUnknown}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:TextFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}" />
      </Grid>
    </DataTemplate>

    <!-- Trigger editor rows. One template for every kind: each row is a label and a value, and only
         the control in the value cell changes, so the alternative was nine near-identical copies. -->
    <DataTemplate DataType="triggers:TriggerRowViewModel">
      <Grid ColumnDefinitions="*,340" Margin="16,0" MinHeight="32" RowDefinitions="Auto,Auto">
        <!-- "required" sits under the label rather than beside it: side by side it was the first
             thing to be squeezed out at narrow pane widths, which is exactly when it matters. -->
        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" ClipToBounds="True">
          <TextBlock Text="{Binding Label}" Classes="dim" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="required" FontSize="10" Margin="0,1,0,0"
                     Foreground="{DynamicResource AmberBrush}"
                     IsVisible="{Binding IsRequired}" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,3">
          <TextBlock Text="{Binding Status}" Classes="label" VerticalAlignment="Center"
                     Foreground="{DynamicResource AmberBrush}"
                     IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding Counter}" Classes="label" VerticalAlignment="Center"
                     IsVisible="{Binding HasCounter}" />
          <TextBox Text="{Binding Text, Mode=TwoWay}" MinWidth="210"
                   MaxLength="{Binding MaxLength}" IsVisible="{Binding IsTextEntry}" />
          <TextBox Text="{Binding Text, Mode=TwoWay}" MinWidth="210" AcceptsReturn="True"
                   TextWrapping="Wrap" MaxHeight="90" MaxLength="{Binding MaxLength}"
                   IsVisible="{Binding IsParagraph}" />
          <NumericUpDown Value="{Binding Number, Mode=TwoWay}" MinWidth="150"
                         IsVisible="{Binding IsNumber}" />
          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsVisible="{Binding IsCheck}" />
          <!-- Plain choice rows stay a list. -->
          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice, Mode=TwoWay}"
                    MinWidth="180" IsVisible="{Binding IsPlainChoice}" />

          <!-- Artwork-bearing rows (the load screens) show the chosen picture at a size worth
               looking at, and open a gallery rather than a dropdown of names. -->
          <StackPanel IsVisible="{Binding IsGallery}" Spacing="6" HorizontalAlignment="Right">
            <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" CornerRadius="3"
                    Background="{DynamicResource FieldBrush}" ClipToBounds="True"
                    Width="256" Height="192">
              <Panel>
                <TextBlock Text="{Binding Choice.Display}" FontSize="15"
                           Foreground="{DynamicResource InkBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="10" />
                <Image Source="{Binding SelectedPreview}" Stretch="UniformToFill" />
              </Panel>
            </Border>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{Binding Choice.Display}" Classes="mono"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <Button Grid.Column="1" x:Name="ChooseScreenButton" Content="Choose&#x2026;" Padding="10,4"
                      Command="{Binding OpenGalleryCommand}" />
              <Popup Grid.Column="1" IsOpen="{Binding IsGalleryOpen, Mode=TwoWay}"
                     PlacementTarget="{Binding #ChooseScreenButton}" Placement="Left"
                     IsLightDismissEnabled="True">
                <Border Background="{DynamicResource PanelBrush}" CornerRadius="4" Padding="4"
                        BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1">
                  <ScrollViewer MaxHeight="520" MaxWidth="680">
                      <ItemsControl ItemsSource="{Binding Choices}" Margin="4">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel MaxWidth="640" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="triggers:TriggerChoiceViewModel">
                            <Button Classes="behavior" Margin="3" Padding="4"
                                    Command="{Binding $parent[ItemsControl].((triggers:TriggerRowViewModel)DataContext).PickChoiceCommand}"
                                    CommandParameter="{Binding}">
                              <StackPanel Width="192" Spacing="4">
                                <Border Height="144" ClipToBounds="True" CornerRadius="2"
                                        Background="{DynamicResource FieldBrush}"
                                        BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1">
                                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding Display}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Note}" Classes="label"
                   TextWrapping="Wrap" Margin="0,0,0,7" IsVisible="{Binding HasNote}" />
      </Grid>
    </DataTemplate>

    <!-- One behavior field. Six shapes over the same row so the label column stays aligned with
         the schema fields above: toggle, number, name-valued picker, id-valued picker, preview
         gallery, and free text.
         A name picker is an AutoCompleteBox rather than a combo because the tag source alone offers
         five figures of options and a stored value the source does not know must stay visible. -->
    <DataTemplate DataType="placeables:BehaviorFieldViewModel">
      <Grid ColumnDefinitions="220,*,Auto" RowDefinitions="Auto,Auto" Margin="0,2">
        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Label}" Classes="dim" TextWrapping="Wrap" />
          <TextBlock Text="required" Classes="count" IsVisible="{Binding IsRequired}" />
        </StackPanel>

        <CheckBox Grid.Column="1" IsVisible="{Binding IsToggle}" IsChecked="{Binding Flag, Mode=TwoWay}" />

        <NumericUpDown Grid.Column="1" IsVisible="{Binding IsInteger}" FormatString="0" Increment="1"
                       Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                       Value="{Binding Number, Mode=TwoWay}" />

        <AutoCompleteBox Grid.Column="1" IsVisible="{Binding IsNameChoice}"
                         ItemsSource="{Binding Options}"
                         ValueMemberBinding="{Binding Value}"
                         FilterMode="Contains" MaxDropDownHeight="360"
                         Text="{Binding Text, Mode=TwoWay}" />

        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8"
              IsVisible="{Binding IsSearchableIdChoice}">
          <AutoCompleteBox Grid.Column="0"
                           ItemsSource="{Binding Options}"
                           ValueMemberBinding="{Binding Display}"
                           SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                           FilterMode="Contains" MaxDropDownHeight="400"
                           Text="{Binding ChoiceSearchText, Mode=TwoWay}"
                           Watermark="Search key items" />
          <Button Grid.Column="1" Content="Clear" Padding="10,4"
                  Command="{Binding ClearChoiceCommand}"
                  IsVisible="{Binding CanClearChoice}" />
        </Grid>

        <ComboBox Grid.Column="1" IsVisible="{Binding IsIdChoice}"
                  ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                  MaxDropDownHeight="400" HorizontalAlignment="Stretch" />

        <TextBox Grid.Column="1" IsVisible="{Binding IsText}" Text="{Binding Text, Mode=TwoWay}" />

        <StackPanel Grid.Column="1" IsVisible="{Binding IsGalleryChoice}" Spacing="6"
                    HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedDisplay}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding SelectedDetails}" Classes="dim" FontSize="11"
                         TextWrapping="Wrap" MaxLines="2" IsVisible="{Binding HasSelectedDetails}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Clear" Padding="10,4"
                    Command="{Binding ClearChoiceCommand}"
                    IsVisible="{Binding CanClearChoice}" />
          </Grid>
          <TextBox Text="{Binding GalleryQuery, Mode=TwoWay}"
                   Watermark="Search by name, resref, group, color, or location" />
          <TextBlock Text="{Binding GallerySummary}" Classes="count" />
          <!-- Gallery choices live on the form. They remain paged internally so opening a behavior
               does not create hundreds of preview controls at once; scrolling publishes each next
               page before the builder reaches the end. -->
          <ScrollViewer Height="480" VerticalScrollBarVisibility="Auto"
                        ScrollChanged="OnBehaviorGalleryScrollChanged">
            <ItemsControl ItemsSource="{Binding GalleryTiles}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="placeables:BehaviorGalleryTileViewModel">
                  <Button Classes="behavior" Classes.on="{Binding IsSelected}"
                          Margin="3" Padding="4"
                          Command="{Binding $parent[ItemsControl].((placeables:BehaviorFieldViewModel)DataContext).PickChoiceCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Width="158" Spacing="3">
                      <Border Height="112" ClipToBounds="True" CornerRadius="2"
                              Background="{DynamicResource FieldBrush}"
                              BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1">
                        <Panel>
                          <TextBlock Text="{Binding Glyph}" FontSize="28" Classes="dim"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <Image Source="{Binding Preview}" Stretch="Uniform" />
                        </Panel>
                      </Border>
                      <TextBlock Text="{Binding Display}" FontSize="11"
                                 TextTrimming="CharacterEllipsis" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Details}" Classes="mono"
                                   FontSize="10" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{Binding Group}" Classes="count"
                                   FontSize="10" IsVisible="{Binding HasGroup}" />
                      </Grid>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>

        <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Classes="count"
                   Text="{Binding StatusText}"
                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Description}" Classes="dim"
                   FontSize="11" TextWrapping="Wrap" Margin="0,3,0,3"
                   IsVisible="{Binding HasDescription}" />
      </Grid>
    </DataTemplate>

    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Dock.Avalonia.Themes.Fluent/Presets/Ide/Default.axaml" />
        <!-- Last so the Toolset's icon aliases replace every close geometry consumed by Dock. -->
        <ResourceInclude Source="avares://SWLOR.Toolset/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <!-- AvaloniaEdit ships no default style: without this the script editor's TextEditor renders
         as an unstyled blank control. Must precede ToolsetTheme so our overrides still win. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <DockFluentTheme DensityStyle="Compact" />

    <Style Selector="ToolControl">
      <Setter Property="HeaderTemplate">
        <DataTemplate DataType="core:IDockable">
          <TextBlock Text="{Binding Title}" Padding="2" />
        </DataTemplate>
      </Setter>
    </Style>

    <!-- Last, so it wins over both Fluent and the Dock preset. -->
    <StyleInclude Source="avares://SWLOR.Toolset/Styles/ToolsetTheme.axaml" />
  </Application.Styles>

</Application>
