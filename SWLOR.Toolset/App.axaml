<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SWLOR.Toolset"
             xmlns:core="using:Dock.Model.Core"
             xmlns:editors="using:SWLOR.Toolset.Editors"
             xmlns:triggers="using:SWLOR.Toolset.Editors.Triggers"
             x:Class="SWLOR.Toolset.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <!-- Shared editor field templates: one app-wide copy for every blueprint/area field
         editor, formerly duplicated verbatim in BlueprintEditorView and AreaEditorView. Listed
         before the ViewLocator catch-all. -->
    <DataTemplate DataType="editors:LocStringFieldViewModel">
      <Grid ColumnDefinitions="180,*,Auto" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}" />
        <TextBlock Grid.Column="2" Text="{Binding StrRefDisplay}" Classes="count"
                   VerticalAlignment="Center" Margin="6,0,0,0" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:CheckFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:IntegerFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <NumericUpDown Grid.Column="1" Value="{Binding Value, Mode=TwoWay}"
                       FormatString="0" Increment="1" IsEnabled="{Binding !IsReadOnly}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:FloatFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <NumericUpDown Grid.Column="1" Value="{Binding Value, Mode=TwoWay}"
                       Increment="0.5" IsEnabled="{Binding !IsReadOnly}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:DropdownFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <ComboBox Grid.Column="1" IsVisible="{Binding HasOptions}"
                  ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                  MaxDropDownHeight="400" />
        <NumericUpDown Grid.Column="1" IsVisible="{Binding !HasOptions}"
                       Value="{Binding RawValue, Mode=TwoWay}" FormatString="0" Increment="1" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:ScriptFieldViewModel">
      <StackPanel Margin="0,2">
        <Grid ColumnDefinitions="180,*,Auto,Auto">
          <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                     Classes="dim" TextTrimming="CharacterEllipsis" />
          <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}"
                   FontFamily="{DynamicResource MonoFont}" />
          <Button Grid.Column="2" Content="..." Margin="4,0,0,0" Padding="8,4"
                  Command="{Binding BrowseCommand}" IsVisible="{Binding CanBrowse}"
                  ToolTip.Tip="Browse module scripts" />
          <Button Grid.Column="3" Content="Open" Margin="4,0,0,0" Padding="8,4"
                  Command="{Binding OpenScriptCommand}" IsVisible="{Binding CanBrowse}"
                  ToolTip.Tip="Open this script in an editor tab" />
        </Grid>
        <!-- A slot naming a script that does not exist is a live, otherwise invisible bug across the
             2,250 module resources that name one. -->
        <TextBlock Margin="184,2,0,0" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource AmberBrush}"
                   IsVisible="{Binding IsMissing}" Text="{Binding MissingMessage}" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="editors:TextFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                   Classes="dim" TextTrimming="CharacterEllipsis" />
        <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}" />
      </Grid>
    </DataTemplate>

    <!-- Trigger editor rows. One template for every kind: each row is a label and a value, and only
         the control in the value cell changes, so the alternative was nine near-identical copies. -->
    <DataTemplate DataType="triggers:TriggerRowViewModel">
      <Grid ColumnDefinitions="*,340" Margin="16,0" MinHeight="32" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding Label}" Classes="dim" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="required" FontWeight="Bold" FontSize="11"
                     Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"
                     IsVisible="{Binding IsRequired}" />
          <TextBlock Text="per placement" Classes="label"
                     Foreground="{DynamicResource AmberBrush}" VerticalAlignment="Center"
                     IsVisible="{Binding IsPerPlacement}" />
        </StackPanel>

        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,3">
          <TextBlock Text="{Binding Status}" Classes="label" VerticalAlignment="Center"
                     Foreground="{DynamicResource AmberBrush}"
                     IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBox Text="{Binding Text, Mode=TwoWay}" MinWidth="210"
                   MaxLength="{Binding MaxLength}" IsVisible="{Binding IsTextEntry}" />
          <TextBox Text="{Binding Text, Mode=TwoWay}" MinWidth="210" AcceptsReturn="True"
                   TextWrapping="Wrap" MaxHeight="90" MaxLength="{Binding MaxLength}"
                   IsVisible="{Binding IsParagraph}" />
          <NumericUpDown Value="{Binding Number, Mode=TwoWay}" MinWidth="150"
                         IsVisible="{Binding IsNumber}" />
          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsVisible="{Binding IsCheck}" />
          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice, Mode=TwoWay}"
                    MinWidth="180" IsVisible="{Binding IsChoice}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Note}" Classes="label"
                   TextWrapping="Wrap" Margin="0,0,0,7" IsVisible="{Binding HasNote}" />
      </Grid>
    </DataTemplate>

    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Dock.Avalonia.Themes.Fluent/Presets/Ide/Default.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <!-- AvaloniaEdit ships no default style: without this the script editor's TextEditor renders
         as an unstyled blank control. Must precede ToolsetTheme so our overrides still win. -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <DockFluentTheme DensityStyle="Compact" />

    <Style Selector="ToolControl">
      <Setter Property="HeaderTemplate">
        <DataTemplate DataType="core:IDockable">
          <TextBlock Text="{Binding Title}" Padding="2" />
        </DataTemplate>
      </Setter>
    </Style>

    <!-- Last, so it wins over both Fluent and the Dock preset. -->
    <StyleInclude Source="avares://SWLOR.Toolset/Styles/ToolsetTheme.axaml" />
  </Application.Styles>

</Application>
