<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SWLOR.Toolset.Editors.Animation"
             xmlns:viewport="using:SWLOR.Toolset.Viewport"
             x:Class="SWLOR.Toolset.Editors.Animation.AnimationEditorDocumentView"
             x:DataType="local:AnimationEditorDocumentViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="8" RowSpacing="6" IsEnabled="{Binding !IsBusy}">
    <WrapPanel>
      <Button Content="Open project" Command="{Binding OpenProjectCommand}" />
      <Button Content="Save" Command="{Binding SaveProjectCommand}" />
      <Button Content="Save as" Command="{Binding SaveAsCommand}" />
      <Button Content="Import MDL" Command="{Binding ImportMdlCommand}" />
      <Button Content="Export MDL" Command="{Binding ExportMdlCommand}" />
      <TextBlock Text="{Binding PathDisplay}" Margin="12,0" VerticalAlignment="Center" />
    </WrapPanel>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,150,Auto,Auto,*,Auto">
      <TextBlock Text="Rig model" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Text="{Binding RigResource}" Watermark="a_ba" />
      <Button Grid.Column="2" Content="Load rig" Command="{Binding LoadRigCommand}" />
      <Button Grid.Column="3" Content="Load rig file" Command="{Binding LoadRigFileCommand}" />
      <TextBlock Grid.Column="5" Text="Working…" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
    </Grid>
    <Grid Grid.Row="2" ColumnDefinitions="165,5,*,5,290">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="RIG JOINTS" FontWeight="Bold" Margin="0,0,0,8" />
        <ListBox ItemsSource="{Binding JointNames}" SelectedIndex="{Binding SelectedJoint}" />
      </DockPanel>
      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
      <TabControl x:Name="PreviewTabs" Grid.Column="2" SelectionChanged="OnPreviewTabChanged">
        <TabItem Header="Pose rig">
          <Grid RowDefinitions="Auto,*">
            <WrapPanel Margin="0,4">
              <ComboBox ItemsSource="{Binding EditModes}" SelectedItem="{Binding EditMode}" Width="95" />
              <ComboBox ItemsSource="{Binding Axes}" SelectedItem="{Binding Axis}" Width="65" />
              <Button Content="Frame rig" Click="OnFrameRig" />
              <Button Content="Reset pose" Command="{Binding ResetPoseCommand}" />
            </WrapPanel>
            <local:AnimationRigControl x:Name="Rig" Grid.Row="1" />
          </Grid>
        </TabItem>
        <TabItem Header="Model preview">
          <DockPanel>
            <Button DockPanel.Dock="Top" Content="Attach matching preview model" Command="{Binding AttachPreviewCommand}" />
            <viewport:ModelPreviewControl x:Name="ModelPreview" />
          </DockPanel>
        </TabItem>
      </TabControl>
      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />
      <TabControl Grid.Column="4">
        <TabItem Header="Pose">
          <ScrollViewer><StackPanel Spacing="6" Margin="4">
            <TextBlock Text="Animation name" />
            <TextBox Text="{Binding AnimationName}" />
            <TextBlock Text="Duration (seconds; resizes keys)" />
            <NumericUpDown Value="{Binding Duration}" Minimum="0.01" Maximum="600" Increment="0.1" />
            <TextBlock Text="Transition (seconds)" />
            <NumericUpDown Value="{Binding Transition}" Minimum="0" Maximum="600" Increment="0.05" />
            <TextBlock Text="Local position X / Y / Z (metres)" />
            <Grid ColumnDefinitions="*,*,*">
              <NumericUpDown Value="{Binding PositionX}" ShowButtonSpinner="False" FormatString="0.###" Increment="0.01" />
              <NumericUpDown Grid.Column="1" Value="{Binding PositionY}" ShowButtonSpinner="False" FormatString="0.###" Increment="0.01" />
              <NumericUpDown Grid.Column="2" Value="{Binding PositionZ}" ShowButtonSpinner="False" FormatString="0.###" Increment="0.01" />
            </Grid>
            <TextBlock Text="Set local rotation X / Y / Z (degrees)" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,*,*">
              <NumericUpDown Value="{Binding RotationX}" ShowButtonSpinner="False" FormatString="0.###" Minimum="-360" Maximum="360" />
              <NumericUpDown Grid.Column="1" Value="{Binding RotationY}" ShowButtonSpinner="False" FormatString="0.###" Minimum="-360" Maximum="360" />
              <NumericUpDown Grid.Column="2" Value="{Binding RotationZ}" ShowButtonSpinner="False" FormatString="0.###" Minimum="-360" Maximum="360" />
            </Grid>
            <Button Content="Apply rotation" Command="{Binding RotateCommand}" />
            <TextBlock Text="Local scale" />
            <NumericUpDown Value="{Binding JointScale}" Minimum="0.001" Maximum="100" Increment="0.01" />
            <TextBlock Text="IK pole X / Y / Z (world metres)" TextWrapping="Wrap" />
            <CheckBox Content="Anchor hands and feet when moving body" IsChecked="{Binding AnchorLimbs}" />
            <Grid ColumnDefinitions="*,*,*">
              <NumericUpDown Value="{Binding PoleX}" ShowButtonSpinner="False" FormatString="0.###" Increment="0.1" />
              <NumericUpDown Grid.Column="1" Value="{Binding PoleY}" ShowButtonSpinner="False" FormatString="0.###" Increment="0.1" />
              <NumericUpDown Grid.Column="2" Value="{Binding PoleZ}" ShowButtonSpinner="False" FormatString="0.###" Increment="0.1" />
            </Grid>
            <TextBlock Text="Event at playhead" />
            <TextBox Text="{Binding EventName}" />
            <WrapPanel>
              <Button Content="Add event" Command="{Binding AddEventCommand}" />
              <Button Content="Remove events" Command="{Binding RemoveEventsCommand}" />
            </WrapPanel>
            <TextBlock Text="{Binding EventsDisplay}" TextWrapping="Wrap" />
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Retarget">
          <ScrollViewer><StackPanel Spacing="6" Margin="4">
            <Button Content="Load GLB / glTF" Command="{Binding LoadSourceCommand}" />
            <ComboBox ItemsSource="{Binding SourceClips}" SelectedIndex="{Binding SourceClip}" HorizontalAlignment="Stretch" />
            <TextBlock Text="Map joints, pose a matching frame, lock the offsets, then bake." TextWrapping="Wrap" />
            <TextBlock Text="Root motion scale" />
            <NumericUpDown Value="{Binding RootScale}" Minimum="0.001" Maximum="1000" Increment="0.1" />
            <TextBlock Text="Bake frames per second" />
            <NumericUpDown Value="{Binding BakeRate}" Minimum="1" Maximum="60" />
            <WrapPanel>
              <Button Content="Lock" Command="{Binding LockCalibrationCommand}" />
              <Button Content="Bake" Command="{Binding BakeCommand}" />
              <Button Content="Load map" Command="{Binding LoadMappingCommand}" />
              <Button Content="Save map" Command="{Binding SaveMappingCommand}" />
            </WrapPanel>
            <ItemsControl ItemsSource="{Binding Mappings}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="local:BoneMappingRow">
                  <StackPanel Margin="0,3">
                    <TextBlock Text="{Binding Target}" />
                    <ComboBox ItemsSource="{Binding $parent[UserControl].((local:AnimationEditorDocumentViewModel)DataContext).SourceBones}"
                              SelectedItem="{Binding Source}" HorizontalAlignment="Stretch" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Install">
          <StackPanel Spacing="8" Margin="4">
            <TextBlock Text="Target model files" FontWeight="Bold" />
            <TextBlock Text="Choose each model that should inherit this animation. Installation creates a named animation and a typed C# reference." TextWrapping="Wrap" />
            <TextBox Text="{Binding TargetPaths}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
            <Button Content="Add target model" Command="{Binding AddTargetCommand}" />
            <Button Content="Preview installation…" Command="{Binding InstallCommand}" />
            <TextBlock Text="Review the affected files before applying. Rebuild and deploy the HAKs, then rebuild C# to use the generated constant." TextWrapping="Wrap" />
          </StackPanel>
        </TabItem>
      </TabControl>
    </Grid>
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto,Auto">
      <WrapPanel>
        <Button Content="Play / pause" Command="{Binding PlayCommand}" />
        <Button Content="Set key" Command="{Binding SetKeyCommand}" />
        <Button Content="Remove key" Command="{Binding RemoveKeyCommand}" />
        <Button Content="Copy pose" Command="{Binding CopyPoseCommand}" />
        <Button Content="Paste pose" Command="{Binding PastePoseCommand}" />
        <TextBlock Text="{Binding Playhead, StringFormat='  {0:0.000} seconds'}" VerticalAlignment="Center" />
      </WrapPanel>
      <Slider Grid.Row="1" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Playhead}" />
      <local:AnimationTimelineControl Grid.Row="2" ToolTip.Tip="Click a gold marker to select its exact keyframe; drag to scrub." />
    </Grid>
    <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
