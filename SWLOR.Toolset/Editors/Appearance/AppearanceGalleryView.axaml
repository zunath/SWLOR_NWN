<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:appearance="using:SWLOR.Toolset.Editors.Appearance"
             xmlns:controls="using:SWLOR.Toolset.Shell.Controls"
             x:Class="SWLOR.Toolset.Editors.Appearance.AppearanceGalleryView"
             x:DataType="appearance:AppearanceGallerySectionViewModel">

  <!-- The appearance grid every editor that picks one draws. Search, count, then pictures - and
       highlighting a tile is the pick, because a confirm button in between only asks a builder to
       say twice what they already said once. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="14,10">
    <TextBox Grid.Row="0" Text="{Binding Query, Mode=TwoWay}"
             Watermark="{Binding SearchWatermark}" />

    <TextBlock Grid.Row="1" Text="{Binding MatchSummary}" Classes="count" Margin="2,7" />

    <TextBlock Grid.Row="2" Text="{Binding CurrentDescription}" Classes="mono" FontSize="11"
               TextWrapping="Wrap" Margin="2,0,2,7" />

    <ListBox Grid.Row="3" ItemsSource="{Binding Tiles}"
             SelectedItem="{Binding Highlighted, Mode=TwoWay}"
             ScrollViewer.ScrollChanged="OnGalleryScrollChanged"
             Background="Transparent" BorderThickness="0" Padding="2">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <!-- Reuse the palette's viewport virtualization so a 2,000-row appearance table creates
               and requests previews only for the cells the builder can actually see. -->
          <controls:VirtualizingWrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="3" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="appearance:AppearanceTileViewModel">
          <Border Width="{Binding TileSize}"
                  Padding="4" CornerRadius="3" Loaded="OnTileLoaded"
                  Classes.current="{Binding IsCurrent}"
                  Background="{DynamicResource PanelRaisedBrush}"
                  BorderThickness="2" BorderBrush="{DynamicResource RuleBrush}">
            <Border.Styles>
              <Style Selector="Border.current">
                <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}" />
              </Style>
            </Border.Styles>
            <StackPanel Spacing="3">
              <Panel Height="{Binding TileImageHeight}">
                <!-- The letter stands in until the render lands, so the grid is never a field of
                     empty boxes while it fills. -->
                <TextBlock Text="{Binding Glyph}" FontSize="26" Classes="dim"
                           IsVisible="{Binding !HasPreview}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image Source="{Binding Preview}" Stretch="Uniform"
                       IsVisible="{Binding HasPreview}" />
              </Panel>
              <TextBlock Text="{Binding Caption}" FontSize="10.5"
                         TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Detail}" Classes="mono" FontSize="9.5"
                         TextTrimming="CharacterEllipsis" HorizontalAlignment="Center"
                         IsVisible="{Binding HasDetail}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
