<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="using:SWLOR.Toolset.Editors.Behaviors"
             x:Class="SWLOR.Toolset.Editors.Behaviors.SearchableChoicePickerView"
             x:Name="Root"
             x:DataType="behaviors:BehaviorRowViewModel">
  <!-- Long catalogs use this one deferred, virtualized picker everywhere. Compact mode lets a
       dense editor row reuse the exact interaction without repeating the behavior field label. -->
  <StackPanel Spacing="6">
    <StackPanel Spacing="6" IsVisible="{Binding !Compact, ElementName=Root}">
      <TextBlock Text="{Binding SelectedChoiceDisplay}" TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
      <TextBlock Text="{Binding SearchSummary}" Classes="count" />
      <StackPanel IsVisible="{Binding !IsInlineSearchChoice}">
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsSearchExpanded}">
          <Button Content="Choose..." Command="{Binding OpenSearchCommand}" />
          <Button Content="Clear" Command="{Binding ClearChoiceCommand}"
                  IsVisible="{Binding CanClearChoice}" />
        </StackPanel>
      </StackPanel>
    </StackPanel>

    <Button IsVisible="{Binding Compact, ElementName=Root}"
            Content="{Binding SelectedChoiceDisplay}"
            Command="{Binding OpenSearchCommand}"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            ToolTip.Tip="Choose a value" />

    <StackPanel IsVisible="{Binding IsSearchExpanded}" Spacing="6">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <TextBox Text="{Binding ChoiceSearchText, Mode=TwoWay}"
                 Watermark="{Binding SearchWatermark}" />
        <Button Grid.Column="1" Content="Close" Command="{Binding CloseSearchCommand}"
                IsVisible="{Binding !IsInlineSearchChoice}" />
      </Grid>
      <TextBlock Text="{Binding SearchSummary}" Classes="count"
                 IsVisible="{Binding Compact, ElementName=Root}" />
      <Border BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" CornerRadius="2"
              ClipToBounds="True">
        <ListBox ItemsSource="{Binding FilteredChoices}" MaxHeight="220"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="behaviors:BehaviorChoiceViewModel">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="behavior" Classes.on="{Binding IsSelected}"
                        Content="{Binding Display}" Margin="2" Padding="8,5"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Command="{Binding $parent[ListBox].((behaviors:BehaviorRowViewModel)DataContext).PickChoiceCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="1" Content="▶" Margin="2" Padding="8,5"
                        IsVisible="{Binding CanPreviewAudio}" ToolTip.Tip="Preview sound set"
                        Command="{Binding $parent[ListBox].((behaviors:BehaviorRowViewModel)DataContext).PreviewAudioCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <Button Content="Load more" HorizontalAlignment="Left"
              Command="{Binding LoadMoreSearchResultsCommand}"
              IsVisible="{Binding CanLoadMoreSearchResults}" />
    </StackPanel>
  </StackPanel>
</UserControl>
