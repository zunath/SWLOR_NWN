<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:items="using:SWLOR.Toolset.Editors.Items"
             x:Class="SWLOR.Toolset.Editors.Items.PaletteColorPickerView"
             x:DataType="items:ItemDyeCellViewModel">

  <!-- Shared by the item and creature appearance editors. Aurora stores a palette row index, but
       builders edit the rendered color: the index is kept behind each swatch and never becomes a
       creature-facing number field. -->
  <UserControl.Styles>
    <Style Selector="Border.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource InkBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
               Foreground="{DynamicResource InkSecondaryBrush}"
               TextTrimming="CharacterEllipsis" />

    <Button Grid.Column="1" Padding="3" Command="{Binding TogglePickerCommand}"
            IsVisible="{Binding HasColorPicker}" ToolTip.Tip="Pick a preset or custom colour">
      <Border Width="46" Height="18" CornerRadius="2"
              Background="{Binding DisplayBrush}"
              BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" />
      <Button.Flyout>
        <Flyout Placement="Bottom" ShowMode="Standard">
          <StackPanel Width="292" Spacing="8">
            <ScrollViewer MaxHeight="260" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding HasPalette}">
              <ItemsControl ItemsSource="{Binding Swatches}" Width="272">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="items:ItemDyeSwatchViewModel">
                    <Button Padding="0" Margin="1" Background="Transparent"
                            Command="{Binding $parent[ItemsControl].((items:ItemDyeCellViewModel)DataContext).PickCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{Binding Tooltip}">
                      <Border Classes.selected="{Binding IsSelected}"
                              Width="20" Height="20" CornerRadius="2"
                              Background="{Binding Brush}" BorderThickness="2" />
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <Separator IsVisible="{Binding HasCustomOption}" />
            <ToggleButton IsVisible="{Binding HasCustomOption}"
                          IsChecked="{Binding IsCustomEditorOpen, Mode=TwoWay}"
                          HorizontalContentAlignment="Stretch" Padding="8,5">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Text="Custom…" VerticalAlignment="Center" />
                <Border Grid.Column="1" Width="46" Height="18" CornerRadius="2"
                        Background="{Binding CustomBrush}"
                        BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" />
              </Grid>
            </ToggleButton>
            <!-- ColorPicker is itself a collapsed button, which made Custom require a second
                 click. ColorView is the picker surface, so selecting Custom reveals it directly. -->
            <ColorView Color="{Binding CustomColor, Mode=TwoWay}"
                       IsAlphaEnabled="False"
                       IsColorPaletteVisible="False"
                       IsVisible="{Binding IsCustomEditorOpen}" />
          </StackPanel>
        </Flyout>
      </Button.Flyout>
    </Button>

    <!-- Existing item documents remain editable without base-game palette artwork. Creature rows
         disable this path at construction, so they can never regress to a numeric color control. -->
    <NumericUpDown Grid.Column="1" Value="{Binding Number, Mode=TwoWay}"
                   Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                   Increment="1" FormatString="0" Width="116"
                   IsVisible="{Binding HasNumericFallback}" />
    <TextBlock Grid.Column="1" Text="Palette unavailable" Classes="dim"
               VerticalAlignment="Center" IsVisible="{Binding IsPaletteUnavailable}" />
  </Grid>
</UserControl>
