<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="using:SWLOR.Toolset.Editors"
             x:Class="SWLOR.Toolset.Editors.BlueprintEditorView"
             x:DataType="editors:BlueprintEditorViewModel">

  <!-- Field editor DataTemplates (LocString/Check/Integer/Float/Dropdown/Script/Text) are shared
       app-wide from App.axaml's Application.DataTemplates. -->
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="8,6">
      <Button Content="Save" Command="{Binding SaveCommand}" />
      <Button Content="Undo" Command="{Binding UndoCommand}" />
      <Button Content="Redo" Command="{Binding RedoCommand}" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel Margin="8" Spacing="4">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="editors:EditorGroup">
              <Expander Header="{Binding Title}" IsExpanded="True" Margin="0,0,0,6"
                        HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Fields}" Margin="8,4" />
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Expander Header="Local Variables" IsExpanded="True"
                  IsVisible="{Binding VarTableSection, Converter={x:Static ObjectConverters.IsNotNull}}"
                  HorizontalAlignment="Stretch">
          <StackPanel Margin="8,4" Spacing="6" DataContext="{Binding VarTableSection}">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="240"
                      GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="*" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
            <Grid ColumnDefinitions="2*,Auto,*,2*,Auto,Auto" ColumnSpacing="6">
              <AutoCompleteBox Grid.Column="0" Text="{Binding NewName, Mode=TwoWay}"
                               ItemsSource="{Binding KnownKeys}" Watermark="Variable name" />
              <TextBlock Grid.Column="1" Text="=" VerticalAlignment="Center" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding TypeChoices}"
                        SelectedItem="{Binding NewType, Mode=TwoWay}" />
              <TextBox Grid.Column="3" Text="{Binding NewValue, Mode=TwoWay}" Watermark="Value" />
              <Button Grid.Column="4" Content="Set" Command="{Binding SetVariableCommand}" />
              <Button Grid.Column="5" Content="Remove" Command="{Binding RemoveSelectedCommand}" />
            </Grid>
            <TextBlock Text="{Binding ValidationHint}" Foreground="Orange"
                       IsVisible="{Binding ValidationHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
