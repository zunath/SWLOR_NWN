<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="using:SWLOR.Toolset.Editors"
             x:Class="SWLOR.Toolset.Editors.BlueprintEditorView"
             x:DataType="editors:BlueprintEditorViewModel">

  <UserControl.DataTemplates>
    <DataTemplate DataType="editors:LocStringFieldViewModel">
      <Grid ColumnDefinitions="180,*,Auto" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}" />
        <TextBlock Grid.Column="2" Text="{Binding StrRefDisplay}" Opacity="0.6"
                   VerticalAlignment="Center" Margin="6,0,0,0" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:CheckFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
        <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:IntegerFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" Value="{Binding Value, Mode=TwoWay}"
                       FormatString="0" Increment="1" IsEnabled="{Binding !IsReadOnly}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:FloatFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
        <NumericUpDown Grid.Column="1" Value="{Binding Value, Mode=TwoWay}"
                       Increment="0.5" IsEnabled="{Binding !IsReadOnly}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:DropdownFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" IsVisible="{Binding HasOptions}"
                  ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                  MaxDropDownHeight="400" />
        <NumericUpDown Grid.Column="1" IsVisible="{Binding !HasOptions}"
                       Value="{Binding RawValue, Mode=TwoWay}" FormatString="0" Increment="1" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:ScriptFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" FontFamily="Consolas,monospace" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="editors:TextFieldViewModel">
      <Grid ColumnDefinitions="180,*" Margin="0,2">
        <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" IsReadOnly="{Binding IsReadOnly}" />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="8,6">
      <Button Content="Save" Command="{Binding SaveCommand}" />
      <Button Content="Undo" Command="{Binding UndoCommand}" />
      <Button Content="Redo" Command="{Binding RedoCommand}" />
    </StackPanel>

    <ScrollViewer>
      <StackPanel Margin="8" Spacing="4">
        <ItemsControl ItemsSource="{Binding Groups}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="editors:EditorGroup">
              <Expander Header="{Binding Title}" IsExpanded="True" Margin="0,0,0,6"
                        HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Fields}" Margin="8,4" />
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Expander Header="Local Variables" IsExpanded="True"
                  IsVisible="{Binding VarTableSection, Converter={x:Static ObjectConverters.IsNotNull}}"
                  HorizontalAlignment="Stretch">
          <StackPanel Margin="8,4" Spacing="6" DataContext="{Binding VarTableSection}">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="240"
                      GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="*" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
            <Grid ColumnDefinitions="2*,Auto,*,2*,Auto,Auto" ColumnSpacing="6">
              <AutoCompleteBox Grid.Column="0" Text="{Binding NewName, Mode=TwoWay}"
                               ItemsSource="{Binding KnownKeys}" Watermark="Variable name" />
              <TextBlock Grid.Column="1" Text="=" VerticalAlignment="Center" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding TypeChoices}"
                        SelectedItem="{Binding NewType, Mode=TwoWay}" />
              <TextBox Grid.Column="3" Text="{Binding NewValue, Mode=TwoWay}" Watermark="Value" />
              <Button Grid.Column="4" Content="Set" Command="{Binding SetVariableCommand}" />
              <Button Grid.Column="5" Content="Remove" Command="{Binding RemoveSelectedCommand}" />
            </Grid>
            <TextBlock Text="{Binding ValidationHint}" Foreground="Orange"
                       IsVisible="{Binding ValidationHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
