<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="using:SWLOR.Toolset.Editors"
             xmlns:placeables="using:SWLOR.Toolset.Editors.Placeables"
             x:Class="SWLOR.Toolset.Editors.BlueprintEditorView"
             x:DataType="editors:BlueprintEditorViewModel">

  <!-- Field editor DataTemplates (LocString/Check/Integer/Float/Dropdown/Script/Text/Behavior) are
       shared app-wide from App.axaml's Application.DataTemplates. The four templates below are tab
       CONTENTS, which only this editor hosts. -->
  <!-- No per-document toolbar: File > Save (Ctrl+S) and Edit > Undo/Redo (Ctrl+Z/Ctrl+Y) act on the
       active document tab. -->
  <UserControl.DataTemplates>

    <!-- A schema-driven tab: its groups, as expanders. -->
    <DataTemplate DataType="editors:FieldGroupsViewModel">
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Groups}" Margin="8">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="editors:EditorGroup">
              <Expander Header="{Binding Title}" IsExpanded="True" Margin="0,0,0,6"
                        HorizontalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding Fields}" Margin="8,4" />
              </Expander>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DataTemplate>

    <!-- The Appearance tab: search, filters, model grid, and what is picked right now. The grid is
         paged rather than virtualized, matching the palette: a WrapPanel in a ListBox holds
         everything it is given, so it is only ever given a page. -->
    <DataTemplate DataType="placeables:AppearanceSectionViewModel">
      <Grid ColumnDefinitions="*,270" Margin="8">
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" Margin="0,0,8,0">
          <TextBox Grid.Row="0" Text="{Binding Query, Mode=TwoWay}"
                   Watermark="Search models by name or resref" />

          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="2,7">
            <CheckBox Content="Used in module" IsChecked="{Binding UsedInModuleOnly, Mode=TwoWay}" />
            <CheckBox Content="Named only" IsChecked="{Binding NamedOnly, Mode=TwoWay}" />
            <TextBlock Text="{Binding MatchSummary}" Classes="count" VerticalAlignment="Center" />
          </StackPanel>

          <!-- Paging is driven by the scroll position rather than a button: a builder looking for a
               model scrolls, and stopping to ask for more is an interruption in the middle of the one
               thing this tab is for. The handler loads the next page as the end comes into view. -->
          <!-- Shown until the background catalog read lands, so a builder who opens this tab early
               sees it filling in rather than an empty grid that looks like no models exist. -->
          <StackPanel Grid.Row="2" IsVisible="{Binding IsLoading}" Spacing="8"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Loading models..." HorizontalAlignment="Center" />
            <ProgressBar IsIndeterminate="True" Width="180" />
          </StackPanel>

          <ListBox Grid.Row="2" ItemsSource="{Binding Tiles}" SelectedItem="{Binding Highlighted, Mode=TwoWay}"
                   ScrollViewer.ScrollChanged="OnAppearanceScrollChanged"
                   IsVisible="{Binding !IsLoading}"
                   Background="Transparent" BorderThickness="0" Padding="2">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="3" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="placeables:AppearanceTileViewModel">
                <Border Width="92" Padding="3" CornerRadius="3"
                        Classes.current="{Binding IsCurrent}"
                        Background="{DynamicResource PanelRaisedBrush}"
                        BorderThickness="2" BorderBrush="{DynamicResource RuleBrush}">
                  <Border.Styles>
                    <Style Selector="Border.current">
                      <Setter Property="BorderBrush" Value="{DynamicResource GoldBrush}" />
                    </Style>
                  </Border.Styles>
                  <StackPanel Spacing="3">
                    <Panel Height="66">
                      <Image Source="{Binding Preview}" Stretch="Uniform" />
                    </Panel>
                    <TextBlock Text="{Binding Caption}" FontSize="10.5" TextTrimming="CharacterEllipsis"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

        </Grid>

        <StackPanel Grid.Column="1" Spacing="8">
          <TextBlock Text="CURRENT" Classes="label" />
          <TextBlock Text="{Binding CurrentDescription}" TextWrapping="Wrap" FontSize="11.5" />
          <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="Orange"
                     IsVisible="{Binding CurrentIsUnknown}"
                     Text="This row has no model in placeables.2da. The stored value is kept as it is." />

          <Border Height="1" Background="{DynamicResource RuleBrush}" Margin="0,4" />

          <TextBlock Text="MODEL" Classes="label" />
          <!-- The live 3D: drag to orbit, wheel to zoom. Shows the highlighted model while
               browsing, and the placeable's own model when nothing is highlighted. -->
          <Border Height="190" Background="{DynamicResource PanelRaisedBrush}" CornerRadius="3">
            <ContentControl Content="{Binding PreviewView}" />
          </Border>
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"
                IsVisible="{Binding HasAnimationControls}">
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding AnimationStates}"
                      SelectedItem="{Binding SelectedAnimation, Mode=TwoWay}"
                      IsVisible="{Binding HasAnimationStatePicker}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="placeables:PlaceableAnimationOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="{Binding AnimationToggleText}"
                    Command="{Binding ToggleAnimationCommand}"
                    IsEnabled="{Binding CanAnimateSelected}" MinWidth="62" />
          </Grid>
          <TextBlock Text="Left-drag to turn &#x00B7; right-drag to move &#x00B7; wheel to zoom" Classes="dim" FontSize="10.5" />

          <StackPanel Spacing="4" IsVisible="{Binding HasHighlight}">
            <TextBlock Text="{Binding Highlighted.Caption}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Highlighted.ModelName}" Classes="mono" FontSize="11" />
            <TextBlock Text="{Binding Highlighted.UsageText}" Classes="count" />
          </StackPanel>

        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- The Behavior tab: every option on screen, the selected one's fields beside it. -->
    <DataTemplate DataType="placeables:PlaceableBehaviorSectionViewModel">
      <Grid ColumnDefinitions="230,*" Margin="8">
        <ListBox Grid.Column="0" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="1" Margin="0,0,8,0"
                 BorderBrush="{DynamicResource RuleBrush}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,3" />
              <!-- Category headings share the flat item source so the list stays compact, but
                   they are labels rather than behavior choices. Bind the container—not merely
                   its text—so mouse and keyboard selection both skip every heading. -->
              <Setter Property="IsEnabled" Value="{ReflectionBinding IsSelectable}" />
              <Setter Property="Focusable" Value="{ReflectionBinding IsSelectable}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="placeables:BehaviorListItemViewModel">
              <Grid>
                <TextBlock Text="{Binding Text}" Classes="label" FontSize="10.5"
                           Margin="0,5,0,1" IsVisible="{Binding IsHeader}" />
                <TextBlock Text="{Binding Text}" FontSize="12.5"
                           TextTrimming="CharacterEllipsis" IsVisible="{Binding IsSelectable}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ScrollViewer Grid.Column="1">
          <StackPanel Spacing="10">
            <TextBlock Text="{Binding CurrentName}" FontSize="15" FontWeight="SemiBold" />

            <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding HasFields}" />
            <ItemsControl ItemsSource="{Binding EditableFlagFields}"
                          IsVisible="{Binding HasEditableFlags}" />
            <StackPanel Spacing="6" IsVisible="{Binding ShowsCustomFlags}">
              <TextBlock Text="FLAGS" Classes="label" />
              <ItemsControl ItemsSource="{Binding CustomFlagFields}" />
            </StackPanel>
            <StackPanel Spacing="6" IsVisible="{Binding ShowsCustomScripts}">
              <TextBlock Text="SCRIPTS" Classes="label" />
              <ItemsControl ItemsSource="{Binding CustomScriptFields}" />
            </StackPanel>
            <TextBlock Text="This behavior has no settings of its own." Classes="dim" FontSize="11.5"
                       IsVisible="{Binding !HasSettings}" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </DataTemplate>

    <!-- The Variables tab: the raw grid, present only when the behavior leaves something to edit. -->
    <DataTemplate DataType="editors:VarTableSectionViewModel">
      <StackPanel Margin="10" Spacing="6">
        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="320"
                  GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
            <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="*" />
            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
          </DataGrid.Columns>
        </DataGrid>
        <!-- Type sizes to its content: as a star column it shrank with the pane until the
             drop-down was narrower than the word inside it. -->
        <Grid ColumnDefinitions="2*,Auto,Auto,2*,Auto,Auto" ColumnSpacing="6">
          <AutoCompleteBox Grid.Column="0" Text="{Binding NewName, Mode=TwoWay}"
                           ItemsSource="{Binding KnownKeys}" Watermark="Variable name" />
          <TextBlock Grid.Column="1" Text="=" VerticalAlignment="Center" />
          <ComboBox Grid.Column="2" MinWidth="96" ItemsSource="{Binding TypeChoices}"
                    SelectedItem="{Binding NewType, Mode=TwoWay}" />
          <TextBox Grid.Column="3" Text="{Binding NewValue, Mode=TwoWay}" Watermark="Value" />
          <Button Grid.Column="4" Content="Set" Command="{Binding SetVariableCommand}" />
          <Button Grid.Column="5" Content="Remove" Command="{Binding RemoveSelectedCommand}" />
        </Grid>
        <TextBlock Text="{Binding ValidationHint}" Foreground="Orange"
                   IsVisible="{Binding ValidationHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
    <!-- One page for the types whose fields fit one; a strip only when there is somewhere to go. -->
    <ContentControl Content="{Binding SingleTabContent}" IsVisible="{Binding !HasMultipleTabs}" />

    <TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                IsVisible="{Binding HasMultipleTabs}">
      <TabControl.ItemTemplate>
        <DataTemplate DataType="editors:EditorTabViewModel">
          <TextBlock Text="{Binding Title}" />
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate DataType="editors:EditorTabViewModel">
          <ContentControl Content="{Binding Content}" />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </Panel>
</UserControl>
