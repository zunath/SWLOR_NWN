<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:creatures="using:SWLOR.Toolset.Editors.Creatures"
             xmlns:behaviors="using:SWLOR.Toolset.Editors.Behaviors"
             xmlns:appearance="using:SWLOR.Toolset.Editors.Appearance"
             xmlns:items="using:SWLOR.Toolset.Editors.Items"
             xmlns:cdom="using:SWLOR.Toolset.Domain.Editors.Creatures"
             x:Class="SWLOR.Toolset.Editors.Creatures.CreatureEditorView"
             x:DataType="creatures:CreatureEditorViewModel">

  <UserControl.Resources>
    <!-- The same compact left/right value cell used by the item armor part grid. The row owns the
         label; each side only needs its independent value editor. -->
    <DataTemplate x:Key="CreaturePartValueTemplate" DataType="items:ItemFieldCellViewModel">
      <Grid>
        <ComboBox ItemsSource="{Binding Options}"
                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                  IsEnabled="{Binding IsEnabled}" IsVisible="{Binding HasOptions}" />
        <NumericUpDown Value="{Binding Number, Mode=TwoWay}"
                       Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                       IsEnabled="{Binding IsEnabled}" IsVisible="{Binding !HasOptions}"
                       Increment="1" FormatString="0" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.DataTemplates>
    <DataTemplate DataType="behaviors:BehaviorRowViewModel">
      <behaviors:BehaviorRowView />
    </DataTemplate>

    <DataTemplate DataType="creatures:CreatureStatCellViewModel">
      <Grid ColumnDefinitions="*,116" ColumnSpacing="8" Margin="0,2">
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                   Foreground="{DynamicResource InkSecondaryBrush}" />
        <NumericUpDown Grid.Column="1" Value="{Binding Number, Mode=TwoWay}"
                       Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                       MinWidth="110" Increment="1" FormatString="0" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="items:ItemFieldCellViewModel">
      <Grid ColumnDefinitions="*,116" ColumnSpacing="8" Margin="0,2">
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                   Foreground="{DynamicResource InkSecondaryBrush}" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                  IsEnabled="{Binding IsEnabled}" IsVisible="{Binding HasOptions}" />
        <NumericUpDown Grid.Column="1" Value="{Binding Number, Mode=TwoWay}"
                       Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                       IsEnabled="{Binding IsEnabled}" IsVisible="{Binding !HasOptions}"
                       Increment="1" FormatString="0" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="creatures:CreatureOptionCellViewModel">
      <Grid ColumnDefinitions="*,160" ColumnSpacing="8" Margin="0,2">
        <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                   Foreground="{DynamicResource InkSecondaryBrush}" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}"
                  SelectedItem="{Binding Selected, Mode=TwoWay}" />
      </Grid>
    </DataTemplate>

    <DataTemplate DataType="creatures:CreatureWeaponViewModel">
      <Border Classes="card" Margin="0,0,0,8" Padding="12">
        <StackPanel Spacing="5">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Label}" Classes="section" />
            <Button Grid.Column="1" Content="Create weapon" Command="{Binding EnsureExistsCommand}"
                    IsVisible="{Binding !Exists}" />
          </Grid>
          <ContentControl Content="{Binding Damage}" />
          <ContentControl Content="{Binding Delay}" />
          <ContentControl Content="{Binding DamageType}" />
          <ContentControl Content="{Binding DamageStat}" />
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="creatures:CreatureAbilityEntryViewModel">
      <Border Classes="card" Margin="0,0,0,8" Padding="12">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Text="{Binding Name}" Classes="section" />
          <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveCommand}" />
          <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}"
                     Classes="dim" TextWrapping="Wrap" Margin="0,4,0,4" />
          <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,116" ColumnSpacing="8"
                IsVisible="{Binding HasEffectiveLevel}">
            <StackPanel>
              <TextBlock Text="{Binding EffectiveLevelLabel}" />
              <TextBlock Text="{Binding EffectiveLevelHelp}" Classes="dim" FontSize="11" />
            </StackPanel>
            <NumericUpDown Grid.Column="1" Value="{Binding EffectiveLevel, Mode=TwoWay}"
                           Minimum="1" Maximum="{Binding MaximumLevel}" Increment="1" FormatString="0" />
          </Grid>
        </Grid>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="creatures:CreatureLootEntryViewModel">
      <Border Classes="card" Margin="0,0,0,8" Padding="10">
        <StackPanel Spacing="8">
          <!-- Loot table selection is the same deferred, virtualized, paged picker used by the
               behavior and equipment editors. Do not replace this with an eager combo box. -->
          <behaviors:BehaviorRowView DataContext="{Binding TablePicker}" />
          <Grid ColumnDefinitions="Auto,92,Auto,92,*,Auto" ColumnSpacing="7">
            <TextBlock Text="Chance %" Classes="dim" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding Chance, Mode=TwoWay}"
                           Minimum="1" Maximum="100" Increment="1" FormatString="0" />
            <TextBlock Grid.Column="2" Text="Pulls" Classes="dim" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="3" Value="{Binding Pulls, Mode=TwoWay}"
                           Minimum="1" Maximum="100" Increment="1" FormatString="0" />
            <TextBlock Grid.Column="4" Text="{Binding ExpectedDrops}" Classes="dim"
                       FontSize="11" Margin="4,0" VerticalAlignment="Center" />
            <Button Grid.Column="5" Content="Remove" Command="{Binding RemoveCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="creatures:CreatureEquipmentPickerViewModel">
      <behaviors:BehaviorRowView />
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
    <behaviors:BehaviorEditorHeader DockPanel.Dock="Top"
                                    BehaviorName="{Binding HeaderName}"
                                    Kind="{Binding HeaderKind}"
                                    Owner="{Binding HeaderOwner}"
                                    IsDirty="{Binding IsDirty}" />

    <Grid ColumnDefinitions="230,*">
      <Border Grid.Column="0" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,1,0"
              Padding="10">
        <Grid RowDefinitions="*,Auto">
          <Border Grid.Row="0" MinHeight="280" Background="{DynamicResource PanelRaisedBrush}"
                  BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1" CornerRadius="3">
            <ContentControl Content="{Binding PreviewView}" />
          </Border>
          <StackPanel Grid.Row="1" Margin="0,9,0,0" Spacing="5">
            <ListBox Classes="segmented"
                     ItemsSource="{Binding PreviewAnimations}"
                     SelectedItem="{Binding SelectedPreviewAnimation, Mode=TwoWay}">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="creatures:CreatureAnimationOption">
                  <TextBlock Text="{Binding Display}" HorizontalAlignment="Center" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="{Binding CreatureName}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding TemplateResRef}" Classes="resref" />
            <TextBlock Text="Left-drag to move · right-drag to turn · wheel to zoom"
                       Classes="dim" FontSize="10" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </Border>

      <TabControl x:Name="CreatureTabs" Grid.Column="1">
        <TabItem Header="Basic">
          <ScrollViewer>
            <StackPanel Margin="14,10">
              <ItemsControl ItemsSource="{Binding BasicRows}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Behavior">
          <Grid ColumnDefinitions="210,*">
            <behaviors:BehaviorRailView Items="{Binding RoleList}" ChooseCommand="{Binding ChooseRoleCommand}" />
            <ScrollViewer Grid.Column="1" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1,0,0,0">
              <StackPanel Margin="12" Spacing="8">
                <Border Classes="card" Padding="12">
                  <StackPanel>
                    <TextBlock Text="{Binding SelectedRole.DisplayName}" Classes="section" />
                    <TextBlock Text="{Binding SelectedRole.Summary}" Classes="dim" TextWrapping="Wrap"
                               Margin="0,3,0,8" />
                    <ItemsControl ItemsSource="{Binding RoleRows}" />
                    <TextBlock Text="{Binding QuestUsage}" Classes="dim" TextWrapping="Wrap"
                               Margin="8,4" IsVisible="{Binding HasQuestUsage}" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </TabItem>

        <TabItem Header="Variables" IsVisible="{Binding ShowsVariablesTab}">
          <behaviors:VariablesSectionView DataContext="{Binding Variables}" />
        </TabItem>

        <TabItem Header="Appearance">
          <!-- The old page realized the model gallery, portrait gallery, body controls and four
               100-row item lists as one scroll surface. These sections now use the same focused,
               progressive surfaces as the door/placeable and behavior editors. -->
          <TabControl x:Name="CreatureAppearanceSections"
                      SelectedIndex="{Binding SelectedAppearanceSectionIndex, Mode=TwoWay}">
            <TabItem Header="Model">
              <Grid>
                <Panel IsVisible="{Binding HasAppearanceGallery}">
                  <appearance:AppearanceGalleryView DataContext="{Binding AppearanceGallery}" />
                </Panel>
                <TextBlock Text="Creature appearance data is not available."
                           Classes="dim" Margin="14,10"
                           IsVisible="{Binding !HasAppearanceGallery}" />
              </Grid>
            </TabItem>

            <TabItem Header="Details">
              <ScrollViewer>
                <Border Classes="card" Padding="8" Margin="14,10">
                  <ItemsControl ItemsSource="{Binding AppearanceRows}" />
                </Border>
              </ScrollViewer>
            </TabItem>

            <TabItem Header="Body">
              <ScrollViewer>
                <Border Classes="card" Padding="12" Margin="14,10">
                  <StackPanel Spacing="6">
                    <TextBlock Text="Body" Classes="section" />
                    <ProgressBar IsIndeterminate="True" Height="3"
                                 IsVisible="{Binding BodyParts.IsLoading}" />
                    <TextBlock Text="{Binding BodyParts.ModelSummary}" Classes="dim" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding BodyParts.FullBodyDetails}" Classes="mono"
                               IsVisible="{Binding BodyParts.IsFullBody}" />
                    <Grid ColumnDefinitions="*,230" ColumnSpacing="18"
                          IsVisible="{Binding BodyParts.IsDynamic}">
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="Structure" Classes="section" Margin="0,6" />
                        <ItemsControl ItemsSource="{Binding BodyParts.Structure}" />

                        <Grid ColumnDefinitions="120,*,*" ColumnSpacing="10" Margin="0,12,0,2">
                          <TextBlock Grid.Column="1" Text="Left" Classes="section" />
                          <TextBlock Grid.Column="2" Text="Right" Classes="section" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding BodyParts.Limbs}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="items:BodyPartPairViewModel">
                              <Grid ColumnDefinitions="120,*,*" ColumnSpacing="10" Margin="0,2">
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource InkSecondaryBrush}" />
                                <ContentControl Grid.Column="1" Content="{Binding Left}"
                                                ContentTemplate="{StaticResource CreaturePartValueTemplate}" />
                                <ContentControl Grid.Column="2" Content="{Binding Right}"
                                                ContentTemplate="{StaticResource CreaturePartValueTemplate}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox IsChecked="{Binding BodyParts.MirrorRightFromLeft, Mode=TwoWay}"
                                  Content="Mirror right from left" Margin="0,8,0,4" />
                      </StackPanel>

                      <StackPanel Grid.Column="1">
                        <TextBlock Text="Colors" Classes="section" Margin="0,6" />
                        <ItemsControl ItemsSource="{Binding BodyParts.Colors}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="items:ItemDyeCellViewModel">
                              <items:PaletteColorPickerView />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>
              </ScrollViewer>
            </TabItem>

          </TabControl>
        </TabItem>

        <!-- Equipment is a creature-level task, not a subsection of body appearance. The merchant
             editor's category/work-pane layout is reused here: all four slots remain visible as
             compact summaries, while only the selected slot owns a chooser and published results. -->
        <TabItem Header="Equipment">
          <Grid>
            <Grid ColumnDefinitions="210,*" IsVisible="{Binding BodyParts.IsDynamic}">
              <Border Grid.Column="0" BorderBrush="{DynamicResource RuleBrush}"
                      BorderThickness="0,0,1,0" Padding="10">
                <StackPanel Spacing="8">
                  <TextBlock Text="Equipment slots" Classes="section" Margin="4,2,4,0" />
                  <TextBlock Text="Select a slot to view or replace its item."
                             Classes="dim" TextWrapping="Wrap" Margin="4,0,4,4" />
                  <ListBox x:Name="CreatureEquipmentSlots"
                           ItemsSource="{Binding VisibleEquipment.Slots}"
                           SelectedItem="{Binding VisibleEquipment.SelectedSlot, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="creatures:CreatureEquipmentPickerViewModel">
                        <StackPanel Margin="4,5" Spacing="2">
                          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding SelectedChoiceDisplay}" Classes="dim"
                                     FontSize="10.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>

              <ScrollViewer Grid.Column="1">
                <StackPanel Margin="14,10,22,16" Spacing="10">
                  <Border Classes="card" Padding="12">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Visible Equipment" Classes="section" />
                      <TextBlock Text="Armor, weapons, helmets and cloaks are linked item blueprints. Choose one slot at a time; search results load only when its chooser is opened."
                                 Classes="dim" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                  <Border Classes="card" Padding="12">
                    <behaviors:BehaviorRowView DataContext="{Binding VisibleEquipment.SelectedSlot}" />
                  </Border>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <Border Classes="card" Padding="14" Margin="14,10"
                    IsVisible="{Binding BodyParts.IsFullBody}">
              <StackPanel Spacing="5">
                <TextBlock Text="Equipment" Classes="section" />
                <TextBlock Text="This full-body model supplies its visible equipment as part of the model and has no segmented equipment slots."
                           Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="Stats">
          <ScrollViewer>
            <StackPanel Margin="14,10" Spacing="8">
              <Border Classes="card" Padding="12">
                <StackPanel Spacing="5">
                  <TextBlock Text="Combat Rules" Classes="section" />
                  <ItemsControl ItemsSource="{Binding CombatRuleRows}" />
                  <TextBlock Text="{Binding StatWarning}" Foreground="{DynamicResource AmberBrush}"
                             TextWrapping="Wrap" IsVisible="{Binding HasStatWarning}" />
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel>
                  <Border Classes="card" Padding="12" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="Level &amp; Vitals" Classes="section" Margin="0,0,0,6" />
                      <ItemsControl ItemsSource="{Binding Stats.Vitals}" /></StackPanel>
                  </Border>
                  <Border Classes="card" Padding="12" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="Offense" Classes="section" Margin="0,0,0,6" />
                      <ItemsControl ItemsSource="{Binding Stats.Offense}" />
                      <ItemsControl ItemsSource="{Binding Stats.SkillOverrides}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="creatures:CreatureSkillOverrideViewModel">
                            <ContentControl Content="{Binding Level}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,7,0,0">
                        <ComboBox ItemsSource="{Binding Stats.AvailableSkills}"
                                  SelectedItem="{Binding Stats.SelectedSkillToAdd, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Add override"
                                Command="{Binding Stats.AddSkillOverrideCommand}" />
                      </Grid>
                      <TextBlock Text="A skill override replaces NPC Level for that skill only."
                                 Classes="dim" FontSize="11" Margin="0,6,0,0" /></StackPanel>
                  </Border>
                  <Border Classes="card" Padding="12" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="Defense" Classes="section" Margin="0,0,0,6" />
                      <ItemsControl ItemsSource="{Binding Stats.Defense}" /></StackPanel>
                  </Border>
                  <ItemsControl ItemsSource="{Binding Stats.Weapons}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <Border Classes="card" Padding="12" Margin="0,0,0,8">
                    <StackPanel><TextBlock Text="Resistances (−100 … 100)" Classes="section" Margin="0,0,0,6" />
                      <ItemsControl ItemsSource="{Binding Stats.Resistances}" />
                      <TextBlock Text="Negative values are vulnerabilities." Classes="dim" FontSize="11" /></StackPanel>
                  </Border>
                  <Border Classes="card" Padding="12">
                    <StackPanel><TextBlock Text="Attributes" Classes="section" Margin="0,0,0,6" />
                      <ItemsControl ItemsSource="{Binding Stats.Attributes}" /></StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Abilities">
          <Grid ColumnDefinitions="*,310" ColumnSpacing="10" Margin="14,10">
            <ScrollViewer>
              <StackPanel>
                <TextBlock Text="Assigned Abilities" Classes="section" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Abilities.Assigned}" />
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Classes="card" Padding="10">
              <Grid RowDefinitions="Auto,Auto,*">
                <TextBox Text="{Binding Abilities.SearchText, Mode=TwoWay}"
                         Watermark="Search registered abilities" />
                <TextBlock Grid.Row="1" Text="{Binding Abilities.SearchSummary}" Classes="count" Margin="0,5" />
                <ScrollViewer Grid.Row="2">
                  <ItemsControl ItemsSource="{Binding Abilities.Matching}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="cdom:CreatureAbilityInfo">
                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,2"
                                Command="{Binding $parent[ItemsControl].((creatures:CreatureEditorViewModel)DataContext).Abilities.AddCommand}"
                                CommandParameter="{Binding}">
                          <StackPanel><TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding Description}" Classes="dim" FontSize="10"
                                       TextWrapping="Wrap" MaxWidth="270" /></StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="AI">
          <ScrollViewer>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="14,10">
              <StackPanel Spacing="8">
                <Border Classes="card" Padding="12">
                  <StackPanel Spacing="5">
                    <TextBlock Text="Disposition" Classes="section" />
                    <ItemsControl ItemsSource="{Binding AiRows}" />
                  </StackPanel>
                </Border>
                <Border Classes="card" Padding="12">
                  <StackPanel Spacing="7">
                    <TextBlock Text="Decision Profile" Classes="section" />
                    <ComboBox ItemsSource="{Binding Ai.Profiles}" SelectedItem="{Binding Ai.Profile, Mode=TwoWay}" />
                    <CheckBox Content="Random Walk" IsChecked="{Binding Ai.RandomWalk, Mode=TwoWay}" />
                    <CheckBox Content="Return Home" IsChecked="{Binding Ai.ReturnHome, Mode=TwoWay}" />
                    <TextBlock Text="Hand-placed creatures always return home. Spawned creatures use these flags."
                               Classes="dim" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <Border Grid.Column="1" Classes="card" Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="Runtime Behavior" Classes="section" />
                  <TextBlock Text="Aggro range" Classes="dim" /><TextBlock Text="8.5m" Classes="mono" />
                  <TextBlock Text="Return range" Classes="dim" /><TextBlock Text="15m" Classes="mono" />
                  <TextBlock Text="Leash range" Classes="dim" /><TextBlock Text="45m" Classes="mono" />
                  <TextBlock Text="Decision cadence" Classes="dim" /><TextBlock Text="0.25s" Classes="mono" />
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Loot">
          <Grid ColumnDefinitions="*,320" ColumnSpacing="10" Margin="14,10">
            <StackPanel>
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock Text="Per-Kill Loot" Classes="section" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Add table" Command="{Binding Loot.AddCommand}" />
              </Grid>
              <TextBlock Text="{Binding Loot.Warning}" Foreground="{DynamicResource AmberBrush}"
                         TextWrapping="Wrap" Margin="0,0,0,8" IsVisible="{Binding Loot.HasWarning}" />
              <ScrollViewer><ItemsControl ItemsSource="{Binding Loot.Entries}" /></ScrollViewer>
            </StackPanel>
            <Border Grid.Column="1" Classes="card" Padding="12">
              <StackPanel>
                <TextBlock Text="{Binding Loot.PreviewTitle}" Classes="section" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Loot.ExpectedDrops}" Classes="dim" Margin="0,4,0,8" />
                <Button Content="Open table definition" Command="{Binding Loot.OpenDefinitionCommand}"
                        IsVisible="{Binding Loot.CanOpenDefinition}" HorizontalAlignment="Left"
                        Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Loot.PreviewItems}" AutoGenerateColumns="False"
                          IsReadOnly="True" GridLinesVisibility="Horizontal">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Item" Binding="{Binding ResRef}" Width="2*" />
                    <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="*" />
                    <DataGridTextColumn Header="Max" Binding="{Binding MaximumQuantity}" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</UserControl>
