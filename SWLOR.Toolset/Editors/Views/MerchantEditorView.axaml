<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:merchants="using:SWLOR.Toolset.Editors.Merchants"
             x:Class="SWLOR.Toolset.Editors.Merchants.MerchantEditorView"
             x:DataType="merchants:MerchantEditorViewModel">

  <TabControl>
    <TabItem Header="Details">
      <ScrollViewer>
        <Grid ColumnDefinitions="2*,*" Margin="14,10,22,16" ColumnSpacing="12">
          <Border Grid.Column="0" Classes="card" Padding="8,6,8,10" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Merchant" Classes="section" Margin="8,6,8,4" />
              <ItemsControl ItemsSource="{Binding DetailRows}" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="card" Padding="8,6,8,10" VerticalAlignment="Top">
            <StackPanel>
              <TextBlock Text="Pricing" Classes="section" Margin="8,6,8,4" />
              <ItemsControl ItemsSource="{Binding PricingRows}" />
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </TabItem>

    <TabItem Header="Inventory">
      <Grid ColumnDefinitions="190,2*,260" RowDefinitions="*" Margin="0">
        <Border Grid.Column="0" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,1,0"
                Padding="10">
          <StackPanel Spacing="8">
            <TextBlock Text="Categories" Classes="section" Margin="4,2,4,0" />
            <ListBox ItemsSource="{Binding InventoryCategories}"
                     SelectedItem="{Binding SelectedInventoryCategory, Mode=TwoWay}">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="merchants:MerchantInventoryCategoryViewModel">
                  <TextBlock Text="{Binding Display}" Margin="4,5" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12" RowSpacing="8">
          <TextBlock Grid.Row="0" Text="{Binding SelectedInventoryCategory.Name}"
                     Classes="section" FontSize="15" />
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Grid.Column="0" Text="{Binding InventorySearchText, Mode=TwoWay}"
                     Watermark="Search this category" />
            <TextBlock Grid.Column="1" Text="{Binding InventorySummary}" Classes="dim"
                       VerticalAlignment="Center" />
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <CheckBox Grid.Column="0" Content="Select shown" IsThreeState="True"
                      IsChecked="{Binding ShownInventorySelectionState, Mode=OneWay}"
                      IsEnabled="{Binding CanToggleShownInventoryItems}"
                      Command="{Binding ToggleShownInventorySelectionCommand}"
                      ToolTip.Tip="Select or clear shown items" />
            <TextBlock Grid.Column="1" Text="{Binding CheckedInventorySummary}" Classes="dim"
                       VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="{Binding RemoveCheckedInventoryLabel}"
                    Command="{Binding RemoveCheckedInventoryItemsCommand}" />
          </Grid>

          <ListBox Grid.Row="3" ItemsSource="{Binding InventoryItems}"
                   SelectedItem="{Binding SelectedInventoryItem, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="merchants:MerchantInventoryItemViewModel">
                <Grid ColumnDefinitions="Auto,46,*,Auto" Margin="6,6" ColumnSpacing="10">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                  <Border Grid.Column="1" Width="42" Height="42"
                          Background="{DynamicResource PanelRaisedBrush}"
                          BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1"
                          CornerRadius="3">
                    <Image Source="{Binding Preview}" Stretch="Uniform" Margin="3" />
                  </Border>
                  <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ResRef}" Classes="resref" FontSize="10.5" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                    <TextBlock Text="{Binding SellPrice}" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding BuyPrice}" Classes="dim" FontSize="10.5"
                               HorizontalAlignment="Right" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="4" Classes="card" Padding="10">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
              <TextBox Grid.Column="0" Grid.Row="0" Text="{Binding ItemSearchText, Mode=TwoWay}"
                       Watermark="Find an item blueprint to add" />
              <Button Grid.Column="1" Grid.Row="0" Content="Add item"
                      Command="{Binding AddInventoryItemCommand}" />
              <ComboBox Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Margin="0,8,0,0"
                        ItemsSource="{Binding ItemCandidates}"
                        SelectedItem="{Binding SelectedItemCandidate, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="merchants:MerchantItemDefinition">
                    <TextBlock Text="{Binding Display}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
        </Grid>

        <Border Grid.Column="2" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1,0,0,0"
                Padding="14">
          <StackPanel Spacing="9">
            <TextBlock Text="Selected item" Classes="section" />
            <Border Height="112" Background="{DynamicResource PanelRaisedBrush}"
                    BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1"
                    CornerRadius="3">
              <Image Source="{Binding SelectedInventoryItem.Preview}"
                     Stretch="Uniform" Margin="8" />
            </Border>
            <TextBlock Text="{Binding SelectedItemName}" FontSize="16"
                       FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding SelectedItemResRef}" Classes="resref" />
            <Separator Margin="0,3" />
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBlock Grid.Column="0" Grid.Row="0" Text="Store sells for" Classes="dim" />
              <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding SelectedItemSellPrice}" />
              <TextBlock Grid.Column="0" Grid.Row="1" Text="Store buys for" Classes="dim" />
              <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding SelectedItemBuyPrice}" />
            </Grid>
            <CheckBox Content="Unlimited stock"
                      IsChecked="{Binding SelectedItemInfinite, Mode=TwoWay}"
                      IsEnabled="{Binding HasSelectedInventoryItem}" />
            <Button Content="Remove from inventory" Margin="0,8,0,0"
                    Command="{Binding RemoveInventoryItemCommand}"
                    CommandParameter="{Binding SelectedInventoryItem}"
                    IsEnabled="{Binding HasSelectedInventoryItem}" />
          </StackPanel>
        </Border>
      </Grid>
    </TabItem>

    <TabItem Header="Buying rules">
      <Grid RowDefinitions="Auto,Auto,*" Margin="16,12,22,16" RowSpacing="10">
        <Border Grid.Row="0" Classes="card" Padding="12">
          <StackPanel Spacing="7">
            <TextBlock Text="What will this merchant buy?" Classes="section" />
            <RadioButton Content="Buy every base item type except those selected below"
                         GroupName="BuyingPolicy"
                         IsChecked="{Binding BuyAllExceptSelected, Mode=TwoWay}" />
            <RadioButton Content="Buy only the base item types selected below"
                         GroupName="BuyingPolicy"
                         IsChecked="{Binding BuyOnlySelected, Mode=TwoWay}" />
            <TextBlock Text="{Binding BuyingRuleError}"
                       Foreground="{DynamicResource AmberBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox Grid.Column="0" Text="{Binding BuyingRuleSearchText, Mode=TwoWay}"
                   Watermark="Search base item types from baseitems.2da" />
          <TextBlock Grid.Column="1" Text="{Binding BuyingRuleSummary}" Classes="dim"
                     VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="2" Classes="card" Padding="8">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding BuyingRules}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemWidth="260" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="merchants:MerchantBuyingRuleViewModel">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="6,5">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="{Binding Name}" />
                      <TextBlock Text="{Binding IdDisplay}" Classes="dim" FontSize="10.5" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </Grid>
    </TabItem>

    <TabItem Header="Placed instances">
      <Grid RowDefinitions="Auto,Auto,*" Margin="16,12,22,16" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
          <StackPanel Grid.Column="0">
            <TextBlock Text="Placed instances" Classes="section" />
            <TextBlock Text="{Binding InstanceSummary}" Classes="dim" Margin="0,3,0,0" />
          </StackPanel>
          <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshPlacedInstancesCommand}" />
          <Button Grid.Column="2" Content="Update out-of-date" Classes="primary"
                  Command="{Binding UpdateOutOfDateInstancesCommand}" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="5">
          <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingInstances}" />
          <TextBlock Text="{Binding InstanceError}" Foreground="{DynamicResource AmberBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding PlacedInstances}"
                  AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Area" Binding="{Binding AreaName}" Width="2*" />
            <DataGridTextColumn Header="Area ResRef" Binding="{Binding AreaResRef}" Width="*" />
            <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="*" />
            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </TabItem>
  </TabControl>
</UserControl>
