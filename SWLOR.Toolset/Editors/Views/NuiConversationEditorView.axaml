<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:editors="using:SWLOR.Toolset.Editors"
             x:Class="SWLOR.Toolset.Editors.NuiConversationEditorView"
             x:DataType="editors:NuiConversationEditorViewModel">
  <Grid RowDefinitions="Auto,*" Background="#0C1118">
    <Border Grid.Row="0" Padding="12,8" Background="#111923" BorderBrush="#2C3A4B" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,220,*,Auto,Auto,Auto" ColumnSpacing="10">
        <TextBlock Grid.Column="0" Text="NPC BEHAVIOR" Classes="dim" VerticalAlignment="Center" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding BehaviorOptions}" SelectedItem="{Binding SelectedBehavior}" />
        <TextBlock Grid.Column="2" Text="{Binding ValidationSummary}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <Button Grid.Column="3" Content="Undo" Command="{Binding UndoCommand}" />
        <Button Grid.Column="4" Content="Redo" Command="{Binding RedoCommand}" />
        <Button Grid.Column="5" Content="Save" Command="{Binding SaveCommand}" Classes="accent" />
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Margin="12">
      <TabItem Header="Write">
        <Grid>
          <ScrollViewer IsVisible="{Binding IsMerchant}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26" Spacing="16" MaxWidth="840" HorizontalAlignment="Center">
              <StackPanel Spacing="4">
                <TextBlock Text="Merchant dialogue" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="A merchant needs a greeting and a shop choice. Goodbye is included automatically."
                           Classes="dim" TextWrapping="Wrap" />
              </StackPanel>
              <Border Padding="16" CornerRadius="6" BorderBrush="#34465A" BorderThickness="1" Background="#111821">
                <StackPanel Spacing="10">
                  <TextBlock Text="Greeting" Classes="dim" />
                  <TextBox Text="{Binding MerchantGreeting, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <ComboBox Grid.Column="0" ItemsSource="{Binding DynamicTextTokens}"
                              SelectedItem="{Binding DynamicTextToInsert}" />
                    <Button Grid.Column="1" Content="Insert" Command="{Binding InsertDynamicTextCommand}" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Padding="16" CornerRadius="6" BorderBrush="#34465A" BorderThickness="1" Background="#111821">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="150,*" RowSpacing="10" ColumnSpacing="12">
                  <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Shop" Classes="dim" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Store tag" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MerchantStoreTag, Mode=TwoWay}" Watermark="Nearest store when blank" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Player choice" VerticalAlignment="Center" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MerchantChoiceText, Mode=TwoWay}" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Included" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="Opens the shop  •  Goodbye." Classes="dim" VerticalAlignment="Center" />
                </Grid>
              </Border>
              <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="editors:NuiConversationProblem">
                    <Border Padding="8" Margin="0,2" Background="#23171A" CornerRadius="4">
                      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <Grid IsVisible="{Binding IsGeneral}" ColumnDefinitions="285,*" ColumnSpacing="12">
            <Border Grid.Column="0" BorderBrush="#2D3C4D" BorderThickness="1" CornerRadius="5" Padding="10" Background="#101720">
              <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
                <TextBlock Grid.Row="0" Text="{Binding OutlineTitle}" FontWeight="SemiBold" FontSize="16" />
                <TextBlock Grid.Row="1" Text="The first opening whose checks pass is used." Classes="dim" TextWrapping="Wrap" />
                <ListBox Grid.Row="2" ItemsSource="{Binding OpeningLines}" SelectedItem="{Binding SelectedOpening}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="editors:NuiConversationOpeningRow">
                      <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto" Margin="2,5" ColumnSpacing="4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" />
                        <Button Grid.Row="0" Grid.Column="1" Content="↑" IsEnabled="{Binding CanMoveUp}"
                                Command="{Binding $parent[ListBox].((editors:NuiConversationEditorViewModel)DataContext).MoveOpeningUpCommand}"
                                CommandParameter="{Binding}" Padding="5,1" />
                        <Button Grid.Row="0" Grid.Column="2" Content="↓" IsEnabled="{Binding CanMoveDown}"
                                Command="{Binding $parent[ListBox].((editors:NuiConversationEditorViewModel)DataContext).MoveOpeningDownCommand}"
                                CommandParameter="{Binding}" Padding="5,1" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Summary}" Classes="dim" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6">
                  <Button Content="+ Add opening" Command="{Binding AddOpeningCommand}" />
                  <Button Content="Remove" Command="{Binding RemoveOpeningCommand}" CommandParameter="{Binding SelectedOpening}" />
                </StackPanel>
              </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="6,0,12,18" Spacing="14" IsVisible="{Binding HasSelectedLine}">
                <StackPanel Spacing="4">
                  <TextBlock Text="NPC line" Classes="dim" />
                  <ItemsControl ItemsSource="{Binding TextBlocks}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="editors:NuiConversationTextBlockRow">
                        <Grid ColumnDefinitions="140,*" ColumnSpacing="8" Margin="0,3">
                          <ComboBox Grid.Column="0" ItemsSource="{Binding Styles}" SelectedItem="{Binding Style}" />
                          <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" AcceptsReturn="True"
                                   TextWrapping="Wrap" MinHeight="72" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="+ Add styled text" Command="{Binding AddTextBlockCommand}" />
                    <ComboBox Width="220" ItemsSource="{Binding DynamicTextTokens}" SelectedItem="{Binding DynamicTextToInsert}"
                              />
                    <Button Content="Insert" Command="{Binding InsertDynamicTextCommand}" />
                  </StackPanel>
                </StackPanel>

                <Border Padding="12" BorderBrush="#2D3C4D" BorderThickness="1" CornerRadius="5">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Player choices" Classes="dim" />
                    <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="editors:NuiConversationChoiceRow">
                          <Grid ColumnDefinitions="28,*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="5" Margin="0,4">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Number}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Text, Mode=TwoWay}" />
                            <Button Grid.Row="0" Grid.Column="2" Content="↑" IsEnabled="{Binding CanMoveUp}"
                                    Command="{Binding $parent[ListBox].((editors:NuiConversationEditorViewModel)DataContext).MoveChoiceUpCommand}"
                                    CommandParameter="{Binding}" Padding="5,1" />
                            <Button Grid.Row="0" Grid.Column="3" Content="↓" IsEnabled="{Binding CanMoveDown}"
                                    Command="{Binding $parent[ListBox].((editors:NuiConversationEditorViewModel)DataContext).MoveChoiceDownCommand}"
                                    CommandParameter="{Binding}" Padding="5,1" />
                            <Button Grid.Row="0" Grid.Column="4" Content="Remove"
                                    Command="{Binding $parent[ListBox].((editors:NuiConversationEditorViewModel)DataContext).RemoveChoiceCommand}"
                                    CommandParameter="{Binding}" />
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                              <CheckBox Content="Ends conversation" IsChecked="{Binding EndsConversation}" />
                              <Button Content="Add follow-up" IsVisible="{Binding EndsConversation}"
                                      Command="{Binding $parent[ListBox].((editors:NuiConversationEditorViewModel)DataContext).AddFollowUpCommand}"
                                      CommandParameter="{Binding}" />
                              <Button Content="Open next line" IsVisible="{Binding HasNextLine}"
                                      Command="{Binding $parent[ListBox].((editors:NuiConversationEditorViewModel)DataContext).OpenNextLineCommand}"
                                      CommandParameter="{Binding}" />
                              <TextBlock Text="Select this row to edit its checks and outcomes." Classes="dim" VerticalAlignment="Center" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="+ Add player choice" Command="{Binding AddChoiceCommand}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>

                <Border Padding="12" BorderBrush="#2D3C4D" BorderThickness="1" CornerRadius="5">
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                    <StackPanel Grid.Column="0" Spacing="7">
                      <TextBlock Text="When shown" FontWeight="SemiBold" />
                      <TextBlock Text="Add as many checks as needed. All must pass." Classes="dim" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding Conditions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="editors:GraphSnippetEditorViewModel">
                            <Border Padding="8" Margin="0,3" Background="#141E29" CornerRadius="4">
                              <StackPanel Spacing="5">
                                <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap" />
                                <CheckBox Content="Not" IsChecked="{Binding IsNegated}" IsVisible="{Binding CanNegate}" />
                                <ItemsControl ItemsSource="{Binding Arguments}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="editors:ArgumentEditorViewModel">
                                      <Grid ColumnDefinitions="120,*" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="dim" />
                                        <TextBox Grid.Column="1" Text="{Binding FreeText, Mode=TwoWay}" IsVisible="{Binding IsFreeText}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                                  IsVisible="{Binding HasOptions}" />
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <Button Content="+ More inputs" Command="{Binding AddArgumentsCommand}" />
                                  <Button Content="− Input" Command="{Binding RemoveArgumentsCommand}" />
                                </StackPanel>
                                <Button Content="Remove" Command="{Binding RemoveCommand}" HorizontalAlignment="Left" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableConditions}" SelectedItem="{Binding ConditionToAdd}"
                                  DisplayMemberBinding="{Binding Phrase}" />
                        <Button Grid.Column="1" Content="Add" Command="{Binding AddConditionCommand}" />
                      </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="7">
                      <TextBlock Text="Also do" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding ActionScopeHelp}" Classes="dim" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding Actions}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="editors:GraphSnippetEditorViewModel">
                            <Border Padding="8" Margin="0,3" Background="#141E29" CornerRadius="4">
                              <StackPanel Spacing="5">
                                <TextBlock Text="{Binding Sentence}" TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{Binding Arguments}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="editors:ArgumentEditorViewModel">
                                      <Grid ColumnDefinitions="120,*" Margin="0,2">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Classes="dim" />
                                        <TextBox Grid.Column="1" Text="{Binding FreeText, Mode=TwoWay}" IsVisible="{Binding IsFreeText}" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                                  IsVisible="{Binding HasOptions}" />
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                  <Button Content="+ More inputs" Command="{Binding AddArgumentsCommand}" />
                                  <Button Content="− Input" Command="{Binding RemoveArgumentsCommand}" />
                                </StackPanel>
                                <CheckBox Content="Only once per player" IsChecked="{Binding RunOnce}" IsVisible="{Binding CanRunOnce}" />
                                <TextBox Text="{Binding OnceMarker, Mode=TwoWay}" IsVisible="{Binding RunOnce}" Watermark="Stable once-only ID" />
                                <Button Content="Remove" Command="{Binding RemoveCommand}" HorizontalAlignment="Left" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableActions}" SelectedItem="{Binding ActionToAdd}"
                                  DisplayMemberBinding="{Binding Phrase}" />
                        <Button Grid.Column="1" Content="Add" Command="{Binding AddActionCommand}" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </Border>

                <Expander Header="Presentation">
                  <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="7" Margin="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Speaker name" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SpeakerName, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Speaker tag" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SpeakerTag, Mode=TwoWay}" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Portrait" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding PortraitResref, Mode=TwoWay}" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Sound" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SoundResref, Mode=TwoWay}" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Animation" />
                    <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding Animation, Mode=TwoWay}" Minimum="0" />
                  </Grid>
                </Expander>

                <ItemsControl ItemsSource="{Binding Problems}" IsVisible="{Binding HasProblems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="editors:NuiConversationProblem">
                      <Border Padding="8" Margin="0,2" Background="#23171A" CornerRadius="4">
                        <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                          <TextBlock Grid.Column="0" Text="{Binding Severity}" FontWeight="Bold" />
                          <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem Header="Preview">
        <Grid Margin="28" RowDefinitions="Auto,*,Auto" MaxWidth="760" HorizontalAlignment="Center">
          <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="NUI player preview" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PreviewStatus}" Classes="dim" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Row="1" Padding="20" BorderBrush="#40556D" BorderThickness="1" CornerRadius="7" Background="#111923">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
              <TextBlock Grid.Row="0" Text="{Binding PreviewSpeaker}" FontSize="18" FontWeight="SemiBold" />
              <ItemsControl Grid.Row="1" ItemsSource="{Binding PreviewTextBlocks}" Margin="0,12">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="editors:NuiConversationTextBlockRow">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ListBox Grid.Row="2" ItemsSource="{Binding PreviewChoices}">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="editors:NuiConversationChoiceRow">
                    <Button Content="{Binding Text}" HorizontalContentAlignment="Left" Margin="0,3"
                            Command="{Binding $parent[ListBox].((editors:NuiConversationEditorViewModel)DataContext).PickPreviewChoiceCommand}"
                            CommandParameter="{Binding}" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Grid.Row="3" Content="Restart preview" Command="{Binding StartPreviewCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
