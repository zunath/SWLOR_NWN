<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sounds="using:SWLOR.Toolset.Editors.Sounds"
             xmlns:editors="using:SWLOR.Toolset.Editors"
             x:Class="SWLOR.Toolset.Editors.Sounds.SoundEditorView"
             x:DataType="sounds:SoundEditorViewModel">

  <UserControl.DataTemplates>
    <DataTemplate DataType="sounds:SoundRowViewModel">
      <Grid ColumnDefinitions="180,*" Margin="16,3" RowDefinitions="Auto,Auto">
        <StackPanel Grid.Column="0" VerticalAlignment="Center" ClipToBounds="True">
          <TextBlock Text="{Binding Label}" Classes="dim" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="required" FontSize="10" Foreground="{DynamicResource AmberBrush}"
                     IsVisible="{Binding IsRequired}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="5">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding Text, Mode=TwoWay}"
                     MaxLength="{Binding MaxLength}" IsReadOnly="{Binding IsReadOnly}"
                     IsVisible="{Binding IsTextEntry}" />
            <TextBlock Grid.Column="1" Text="{Binding Counter}" Classes="label"
                       VerticalAlignment="Center" IsVisible="{Binding HasCounter}" />
          </Grid>
          <NumericUpDown Value="{Binding Number, Mode=TwoWay}" IsVisible="{Binding IsNumber}" />
          <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding !IsReadOnly}"
                    IsVisible="{Binding IsCheck}" />
          <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice, Mode=TwoWay}"
                    IsEnabled="{Binding !IsReadOnly}" IsVisible="{Binding IsChoice}" />
          <TextBlock Text="{Binding StatementText}" Classes="mono"
                     IsVisible="{Binding IsStatement}" />

          <StackPanel DataContext="{Binding SoundList}" x:DataType="sounds:SoundListEditorViewModel"
                      IsVisible="{Binding $parent[Grid].((sounds:SoundRowViewModel)DataContext).IsSoundList}"
                      Spacing="6">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <AutoCompleteBox Grid.Column="0" Text="{Binding Candidate, Mode=TwoWay}"
                               ItemsSource="{Binding AvailableSounds}" FilterMode="Contains"
                               Watermark="Filter audio resources by ResRef" />
              <Button Grid.Column="1" Content="Add" Command="{Binding AddCommand}" />
            </Grid>
            <TextBlock Text="No indexed WAV resources are available."
                       Classes="label" Foreground="{DynamicResource AmberBrush}"
                       IsVisible="{Binding !HasAudioCatalog}" />
            <TextBlock Text="{Binding Status}" Classes="label"
                       Foreground="{DynamicResource AmberBrush}"
                       IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                     MaxHeight="190">
              <ListBox.ItemTemplate>
                <DataTemplate DataType="sounds:SoundListEntryViewModel">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="4,2">
                    <TextBlock Grid.Column="0" Text="{Binding Index}" Classes="count"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ResRef}" Classes="mono"
                               VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Remove" Command="{Binding RemoveCommand}" />
              <Button Content="Move up" Command="{Binding MoveUpCommand}" />
              <Button Content="Move down" Command="{Binding MoveDownCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Note}" Classes="label"
                   TextWrapping="Wrap" Margin="0,2,0,5" IsVisible="{Binding HasNote}" />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="16,12"
            BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Text="{Binding HeaderName}" FontSize="15.5"
                   FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding HeaderKind}" Classes="dim" FontSize="13"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Text="&#x00B7;" Classes="dim" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding HeaderOwner}" Classes="resref" FontSize="13.5"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Margin="16,6,16,10" Spacing="3">
      <TextBlock Text="{Binding BehaviorChangeNotice}" Foreground="{DynamicResource AmberBrush}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding BehaviorChangeNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding Incomplete}" Foreground="{DynamicResource AmberBrush}"
                 TextWrapping="Wrap" IsVisible="{Binding IsIncomplete}" />
    </StackPanel>

    <TabControl>
      <TabItem Header="Basic">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding BasicRows}" Margin="14,10" />
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Behavior">
        <Grid ColumnDefinitions="240,*">
          <ScrollViewer Grid.Column="0">
            <ItemsControl ItemsSource="{Binding BehaviorList}" Margin="10">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="sounds:SoundBehaviorListItemViewModel">
                  <Panel>
                    <TextBlock Text="{Binding Text}" IsVisible="{Binding IsHeader}"
                               Classes="section" Margin="12,14,0,5" />
                    <Border IsVisible="{Binding IsRule}" Height="1" Margin="12"
                            Background="{DynamicResource RuleBrush}" />
                    <Button IsVisible="{Binding IsSelectable}" Classes="behavior"
                            Classes.on="{Binding IsSelected}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Content="{Binding Text}"
                            Command="{Binding $parent[TabControl].((sounds:SoundEditorViewModel)DataContext).ChooseBehaviorCommand}"
                            CommandParameter="{Binding Behavior}" />
                  </Panel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <ScrollViewer Grid.Column="1" BorderBrush="{DynamicResource RuleBrush}"
                        BorderThickness="1,0,0,0">
            <Border Classes="card" Margin="14,12">
              <StackPanel>
                <TextBlock Text="{Binding HeaderName}" Classes="section" Margin="16,12,16,4" />
                <ItemsControl ItemsSource="{Binding BehaviorRows}" Margin="0,2,0,8" />
              </StackPanel>
            </Border>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Variables" IsVisible="{Binding ShowsVariablesTab}">
        <StackPanel Margin="14,12" Spacing="8"
                    DataContext="{Binding Variables}" x:DataType="editors:VarTableSectionViewModel">
          <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                    AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="320"
                    GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
              <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="*" />
              <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
            </DataGrid.Columns>
          </DataGrid>
          <Grid ColumnDefinitions="2*,Auto,Auto,2*,Auto,Auto" ColumnSpacing="6">
            <AutoCompleteBox Grid.Column="0" Text="{Binding NewName, Mode=TwoWay}"
                             ItemsSource="{Binding KnownKeys}" Watermark="Variable name" />
            <TextBlock Grid.Column="1" Text="=" VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" MinWidth="96" ItemsSource="{Binding TypeChoices}"
                      SelectedItem="{Binding NewType, Mode=TwoWay}" />
            <TextBox Grid.Column="3" Text="{Binding NewValue, Mode=TwoWay}" Watermark="Value" />
            <Button Grid.Column="4" Content="Set" Command="{Binding SetVariableCommand}" />
            <Button Grid.Column="5" Content="Remove" Command="{Binding RemoveSelectedCommand}" />
          </Grid>
          <TextBlock Text="{Binding ValidationHint}" Foreground="Orange" TextWrapping="Wrap"
                     IsVisible="{Binding ValidationHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Advanced">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding AdvancedRows}" Margin="14,10" />
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
