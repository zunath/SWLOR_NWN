<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:waypoints="using:SWLOR.Toolset.Editors.Waypoints"
             xmlns:behaviors="using:SWLOR.Toolset.Editors.Behaviors"
             x:Class="SWLOR.Toolset.Editors.Waypoints.WaypointDocumentView"
             x:DataType="waypoints:WaypointDocumentViewModel">

  <DockPanel>
    <behaviors:BehaviorEditorHeader DockPanel.Dock="Top"
                                    BehaviorName="{Binding Editor.HeaderName}"
                                    Kind="{Binding Editor.HeaderKind}"
                                    Owner="{Binding Editor.HeaderOwner}"
                                    IsDirty="{Binding IsDirty}" />

    <Border DockPanel.Dock="Bottom" Padding="16,11"
            BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{DynamicResource AmberBrush}"
                   FontSize="12" TextTrimming="CharacterEllipsis"
                   DataContext="{Binding Editor}" x:DataType="waypoints:WaypointEditorViewModel"
                   Text="{Binding Incomplete}" IsVisible="{Binding IsIncomplete}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Revert" MinWidth="86" Command="{Binding RevertCommand}" />
          <Button Content="Save" MinWidth="86" Classes="primary" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <waypoints:WaypointEditorView DataContext="{Binding Editor}" />
  </DockPanel>
</UserControl>
