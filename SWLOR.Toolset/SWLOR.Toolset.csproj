<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SWLOR.Toolset</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Taskbar/Explorer icon for the built exe. The window's own icon is the PNG below; both come
         from the SWLOR Discord server icon. -->
    <ApplicationIcon>Assets\swlor.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- GlAreaControl uses pointer-offset DrawElements calls, matching Radoub.UI's
         ModelPreviewGLControl (which also sets this flag). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.17" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.17" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.17" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.17" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.17" Condition="'$(Configuration)' == 'Debug'" />
    <!-- App.axaml pulls in this package's Fluent theme. It used to arrive transitively through
         Radoub.UI, so dropping that reference broke the XAML compile until it was named here.
         11.3.13 is the newest published build - DataGrid trails the rest of Avalonia. -->
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <!-- The NWScript editor's text surface. Pinned to the 11.3 line to match the Avalonia pin above;
         AvaloniaEdit tracks Avalonia's minor versions, so the two must move together. MIT. -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="11.3.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.9" />
    <PackageReference Include="Dock.Avalonia" Version="11.3.12.1" />
    <PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="11.3.12.1" />
    <PackageReference Include="Dock.Model.Mvvm" Version="11.3.12.1" />
    <!-- GlAreaControl uses Silk.NET.OpenGL types directly, following Radoub.UI's
         ModelPreviewGLControl skeleton. This was already pinned explicitly rather than taken
         transitively from Radoub.UI, which is why dropping that reference did not disturb it. -->
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- No Radoub.UI reference: the one type this app used from it (MdlPartComposer) is vendored
         into SWLOR.Toolset.Domain/Render, which also frees the toolset to move Avalonia versions
         independently of Radoub.UI's pin. Radoub.Formats is still referenced from Domain. -->
    <ProjectReference Include="..\SWLOR.Toolset.Domain\SWLOR.Toolset.Domain.csproj" />
  </ItemGroup>

</Project>
