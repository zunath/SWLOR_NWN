<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:shell="using:SWLOR.Toolset.Shell"
        mc:Ignorable="d"
        x:Class="SWLOR.Toolset.Shell.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="SWLOR Toolset"
        Icon="/Assets/swlor-logo.png"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- InputGesture only draws the shortcut next to the item; the shortcuts themselves are
         registered as window KeyBindings in the code-behind (MenuItem.HotKey would not do, because
         a submenu item is not attached to a tree that reaches this window until its popup has been
         opened once, and a KeyBinding declared here has no DataContext to bind a command from). -->
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="Save _All" Command="{Binding SaveAllCommand}" InputGesture="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="E_xit" Command="{Binding ExitCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo" Command="{Binding UndoCommand}" InputGesture="Ctrl+Z" />
        <MenuItem Header="_Redo" Command="{Binding RedoCommand}" InputGesture="Ctrl+Y" />
      </MenuItem>
      <MenuItem Header="_Build">
        <MenuItem Header="_Pack Module" Command="{Binding PackModuleCommand}" />
      </MenuItem>
    </Menu>
    <DockControl Grid.Row="1" Layout="{Binding Layout}" Margin="4" IsEnabled="{Binding !IsModuleMutationLocked}" />
    <Border Grid.Row="2"
            Padding="8,4"
            Background="{DynamicResource DockThemeBackgroundLowBrush}"
            BorderBrush="{DynamicResource DockThemeBorderMidBrush}"
            BorderThickness="0,1,0,0">
      <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" />
    </Border>
  </Grid>
</Window>
