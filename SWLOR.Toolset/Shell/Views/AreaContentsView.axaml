<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:panels="using:SWLOR.Toolset.Shell.Panels" xmlns:shared="using:Nwn.Toolset.Avalonia.Areas.Contents.Views" x:Class="SWLOR.Toolset.Shell.Views.AreaContentsView" x:DataType="panels:AreaContentsViewModel">
  <shared:AreaContentsView Contents="{Binding $parent[UserControl].((panels:AreaContentsViewModel)DataContext).Contents}" />
</UserControl>
