<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:SWLOR.Toolset.Shell.Panels"
             xmlns:radoub="using:Radoub.UI.Controls"
             x:Class="SWLOR.Toolset.Shell.Views.ModelPreviewView"
             x:DataType="panels:ModelPreviewViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText}" Margin="8,6"
               TextTrimming="CharacterEllipsis" Opacity="0.8" />
    <radoub:ModelPreviewGLControl x:Name="Preview" />
  </DockPanel>
</UserControl>
