<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:panels="using:SWLOR.Toolset.Shell.Panels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="700"
             x:Class="SWLOR.Toolset.Shell.Views.ModuleExplorerView"
             x:DataType="panels:ModuleExplorerViewModel">

  <!-- One tree: type, then group, then resource. Search lives in the panel it searches, which is why
       there is no separate Search dock across the top of the window any more. -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

    <!-- The panel title is drawn here rather than by Dock's chrome, which pads it out with a dotted
         drag grip. Small-caps monospace sets furniture apart from every name and value on screen. -->
    <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}"
            BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" Padding="14,9">
      <TextBlock Classes="title" Text="MODULE CONTENTS" />
    </Border>

    <!-- Group by, with its label inside the control so the row reads as a sentence. -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="8,8,8,4" ColumnSpacing="6">
      <Border Grid.Column="0" Background="{DynamicResource FieldBrush}" CornerRadius="3"
              BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1" Padding="8,0">
        <Grid ColumnDefinitions="Auto,*">
          <TextBlock Grid.Column="0" Text="Group by" Classes="dim" FontSize="11.5"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding GroupingChoices}"
                    SelectedItem="{Binding SelectedGroupingChoice}" Background="Transparent"
                    BorderThickness="0" Padding="0,4" HorizontalAlignment="Stretch"
                    ToolTip.Tip="Automatic groups on the part of the name before the first dash" />
        </Grid>
      </Border>
      <ToggleButton Grid.Column="1" Content="Organize" IsChecked="{Binding IsOrganizing, Mode=TwoWay}"
                    FontSize="11.5" Padding="9,4" />
    </Grid>

    <TextBox Grid.Row="2" Margin="8,0,8,6" Text="{Binding Filter}" Watermark="Search areas..." />

    <!-- Folder tools appear only while organizing, so browsing cannot rearrange by accident. -->
    <StackPanel Grid.Row="3" Margin="8,0,8,6" Spacing="5" IsVisible="{Binding IsOrganizing}">
      <TextBox Text="{Binding NewFolderName}" Watermark="Folder name" />
      <StackPanel Orientation="Horizontal" Spacing="5">
        <Button Content="New Area..." Command="{Binding NewAreaCommand}" />
        <Button Content="New folder" Command="{Binding NewFolderCommand}" />
        <Button Content="File here" Command="{Binding FileSelectedCommand}"
                ToolTip.Tip="Move the selected resource into the named folder" />
      </StackPanel>
    </StackPanel>

    <Grid Grid.Row="4">
      <ListBox Background="Transparent" BorderThickness="0"
               ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
               DoubleTapped="OnItemsDoubleTapped">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0,2" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="panels:ExplorerNodeViewModel">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{Binding Indent}">
              <!-- A wide, tall hit box around a small glyph: the arrow is the thing you aim at most in
                   this panel and a 15px target is a miss waiting to happen. -->
              <Button Grid.Column="0" Content="{Binding Twisty}" Width="26" MinHeight="22" Padding="0"
                      Background="Transparent" BorderThickness="0" FontSize="11"
                      Foreground="{DynamicResource InkTertiaryBrush}"
                      Command="{Binding $parent[ListBox].((panels:ModuleExplorerViewModel)DataContext).ToggleCommand}"
                      CommandParameter="{Binding}" />

              <!-- Branch: name and count. Resource: name over its resref in monospace. -->
              <TextBlock Grid.Column="1" Classes="name" Text="{Binding Name}"
                         FontWeight="{Binding Weight}" VerticalAlignment="Center"
                         IsVisible="{Binding IsBranch}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                          IsVisible="{Binding IsResource}">
                <TextBlock Text="&#x25A1;" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource InkTertiaryBrush}" />
                <TextBlock Classes="name" Text="{Binding Name}" />
              </StackPanel>

              <!-- The resref sits at the end of the row rather than under the name: one line per
                   resource keeps a 443-area tree scannable, and the monospace still separates it. -->
              <TextBlock Grid.Column="2" Classes="resref" Margin="12,0,12,0" VerticalAlignment="Center"
                         Text="{Binding ResRef}" IsVisible="{Binding IsResource}" />
              <TextBlock Grid.Column="2" Classes="count" Margin="8,0,12,0" VerticalAlignment="Center"
                         Text="{Binding Count}" IsVisible="{Binding IsBranch}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- New-area wizard, shown inline over the tree. -->
      <Border ZIndex="1"
              IsVisible="{Binding ActiveNewArea, Converter={x:Static ObjectConverters.IsNotNull}}"
              Background="{DynamicResource PanelRaisedBrush}"
              BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1"
              Padding="12" CornerRadius="4" HorizontalAlignment="Stretch" VerticalAlignment="Top"
              Margin="8">
        <StackPanel Spacing="7" DataContext="{Binding ActiveNewArea}"
                    x:DataType="panels:NewAreaViewModel">
          <TextBlock Text="New Area" FontWeight="SemiBold" />
          <TextBox Text="{Binding ResRef, Mode=TwoWay}" Watermark="Resref (lowercase, max 16)" />
          <TextBox Text="{Binding DisplayName, Mode=TwoWay}" Watermark="Display name" />
          <ComboBox ItemsSource="{Binding Tilesets}" SelectedItem="{Binding SelectedTileset, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
          <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Text="Width" Classes="dim" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding Width, Mode=TwoWay}" Minimum="1" Maximum="32" Increment="1" />
            <TextBlock Grid.Column="2" Text="Height" Classes="dim" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="3" Value="{Binding Height, Mode=TwoWay}" Minimum="1" Maximum="32" Increment="1" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Create" Classes="primary" Command="{Binding CreateCommand}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="5" Margin="10,4,10,8" Classes="dim" FontSize="11.5" TextWrapping="Wrap"
               Text="{Binding StatusMessage}"
               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </Grid>
</UserControl>
