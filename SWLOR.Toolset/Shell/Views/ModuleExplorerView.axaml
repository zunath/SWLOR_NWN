<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:SWLOR.Toolset.Shell.Panels"
             xmlns:shared="using:Nwn.Toolset.Avalonia.Explorer.Views"
             x:Class="SWLOR.Toolset.Shell.Views.ModuleExplorerView"
             x:DataType="panels:ModuleExplorerViewModel"
             x:CompileBindings="True">
  <shared:ModuleExplorerView DataContext="{Binding Workflow}" />
</UserControl>
