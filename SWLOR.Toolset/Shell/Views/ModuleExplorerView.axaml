<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:panels="using:SWLOR.Toolset.Shell.Panels"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="700"
             x:Class="SWLOR.Toolset.Shell.Views.ModuleExplorerView"
             x:DataType="panels:ModuleExplorerViewModel">

  <!-- One tab per resource kind, then search, then that kind's folder tree. Search lives in the panel
       it searches, which is why there is no separate Search dock across the top of the window. -->
  <!-- No title row: this panel's tab is its title now that the rail's tool tabs sit above the panel
       in the same small-caps monospace (Shell/Controls/RailToolTabs.cs). A "MODULE CONTENTS"
       heading directly beneath a tab reading "Module Contents" was a row of height spent saying it
       twice. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Tabs. Each carries its own total, so the two sections you are not in still say how much is in
         them - the one thing worth knowing about a section you are not looking at. -->
    <ItemsControl Grid.Row="0" ItemsSource="{Binding Tabs}" Margin="8,8,8,0">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Rows="1" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="panels:ExplorerTabViewModel">
          <Button Padding="8,5" CornerRadius="4" Margin="0,0,4,0"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Classes.primary="{Binding IsSelected}"
                  Command="{Binding $parent[ItemsControl].((panels:ModuleExplorerViewModel)DataContext).SelectTabCommand}"
                  CommandParameter="{Binding}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />
              <TextBlock Classes="count" Text="{Binding Count}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
          Margin="8,8,8,6" ColumnSpacing="6">
      <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding Filter}" Watermark="Search contents..." />
      <!-- The button names what it makes, which is why it is bound rather than labelled. -->
      <Button Grid.Row="0" Grid.Column="1" Content="{Binding NewItemLabel}"
              Command="{Binding NewItemCommand}" IsVisible="{Binding CanCreateSelectedType}" />
      <!-- Dialogue text joins the ordinary name/ResRef results after a debounced background scan. -->
      <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Searching dialogue..."
                 Margin="2,6,0,0" VerticalAlignment="Center" Classes="dim"
                 IsVisible="{Binding IsSearchingDialogue}" />
    </Grid>

    <Grid Grid.Row="2">
      <ListBox x:Name="ModuleTree" Background="Transparent" BorderThickness="0"
               ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
               DoubleTapped="OnItemsDoubleTapped" KeyDown="OnModuleTreeKeyDown">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0,2" />
          </Style>
          <Style Selector="ListBoxItem.drag-source">
            <Setter Property="Opacity" Value="0.4" />
          </Style>
          <Style Selector="ListBoxItem.drag-target">
            <Setter Property="Background" Value="{DynamicResource AccentDimBrush}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="panels:ExplorerNodeViewModel">
            <!-- ContextRequested selects the row first: Avalonia does not select on right-click, and
                 every command on these menus acts on the selection. -->
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{Binding Indent}"
                  Background="Transparent" ContextRequested="OnRowContextRequested"
                  PointerPressed="OnRowPointerPressed"
                  PointerMoved="OnRowPointerMoved"
                  PointerReleased="OnRowPointerReleased"
                  PointerCaptureLost="OnRowPointerCaptureLost">
              <Grid.ContextMenu>
                <ContextMenu>
                  <!-- Folder actions. Hidden rather than greyed out on a resource row and on Unsorted,
                       which is generated and so has nothing to rename or delete. -->
                  <MenuItem Header="New folder..."
                            Command="{Binding $parent[ListBox].((panels:ModuleExplorerViewModel)DataContext).NewFolderCommand}" />
                  <MenuItem Header="Rename folder..."
                            Command="{Binding $parent[ListBox].((panels:ModuleExplorerViewModel)DataContext).RenameFolderCommand}"
                            IsVisible="{Binding IsFolder}" />
                  <MenuItem Header="Delete folder"
                            Command="{Binding $parent[ListBox].((panels:ModuleExplorerViewModel)DataContext).DeleteFolderCommand}"
                            IsVisible="{Binding IsFolder}" />

                  <Separator IsVisible="{Binding IsResource}" />
                  <MenuItem Header="Open"
                            Command="{Binding $parent[ListBox].((panels:ModuleExplorerViewModel)DataContext).OpenSelectedCommand}"
                            IsVisible="{Binding $parent[ListBox].((panels:ModuleExplorerViewModel)DataContext).CanOpenSelectedType}" />
                  <!-- Compile from the file, without opening it. Shown only on the Scripts tab, since
                       it is the one resource kind with a build step. -->
                  <MenuItem Header="Compile"
                            Command="{Binding $parent[ListBox].((panels:ModuleExplorerViewModel)DataContext).CompileSelectedCommand}"
                            IsVisible="{Binding $parent[ListBox].((panels:ModuleExplorerViewModel)DataContext).CanCompileSelectedType}" />
                  <!-- A submenu of folders rather than a modal picker: the tree the builder is looking
                       at is already the list of choices. -->
                  <MenuItem Header="Move to"
                            IsVisible="{Binding IsResource}"
                            ItemsSource="{Binding $parent[ListBox].((panels:ModuleExplorerViewModel)DataContext).MoveTargets}">
                    <MenuItem.Styles>
                      <!-- Command comes off the item, not the panel: a MenuItem generated from an
                           ItemsSource can bind against the item but has no route back to the panel's
                           own commands. -->
                      <Style Selector="MenuItem > MenuItem" x:DataType="panels:FolderTargetViewModel">
                        <Setter Property="Header" Value="{Binding Path}" />
                        <Setter Property="Command" Value="{Binding Command}" />
                      </Style>
                    </MenuItem.Styles>
                  </MenuItem>
                  <MenuItem Header="Remove from folder"
                            Command="{Binding $parent[ListBox].((panels:ModuleExplorerViewModel)DataContext).RemoveFromFolderCommand}"
                            IsVisible="{Binding IsResource}" />
                  <Separator IsVisible="{Binding IsResource}" />
                  <MenuItem Header="Delete"
                            Command="{Binding $parent[ListBox].((panels:ModuleExplorerViewModel)DataContext).DeleteSelectedResourceCommand}"
                            IsVisible="{Binding IsResource}" />
                </ContextMenu>
              </Grid.ContextMenu>

              <!-- A wide, tall hit box around a small glyph: the arrow is the thing you aim at most in
                   this panel and a 15px target is a miss waiting to happen. -->
              <Button Grid.Column="0" Content="{Binding Twisty}" Width="26" MinHeight="22" Padding="0"
                      Background="Transparent" BorderThickness="0" FontSize="11"
                      Foreground="{DynamicResource InkTertiaryBrush}"
                      Command="{Binding $parent[ListBox].((panels:ModuleExplorerViewModel)DataContext).ToggleCommand}"
                      CommandParameter="{Binding}" />

              <!-- Branch: name and count. Resource: name with a leading glyph. -->
              <TextBlock Grid.Column="1" Classes="name" Text="{Binding Name}"
                         FontWeight="{Binding Weight}" VerticalAlignment="Center"
                         IsVisible="{Binding IsBranch}" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                          IsVisible="{Binding IsResource}">
                <TextBlock Text="&#x25A1;" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource InkTertiaryBrush}" />
                <TextBlock Classes="name" Text="{Binding Name}" />
              </StackPanel>

              <!-- The resref sits at the end of the row rather than under the name: one line per
                   resource keeps a 443-area tree scannable, and the monospace still separates it. -->
              <TextBlock Grid.Column="2" Classes="resref" Margin="12,0,12,0" VerticalAlignment="Center"
                         Text="{Binding ResRef}" IsVisible="{Binding IsResource}" />
              <TextBlock Grid.Column="2" Classes="count" Margin="8,0,12,0" VerticalAlignment="Center"
                         Text="{Binding Count}" IsVisible="{Binding IsBranch}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- New-area wizard, shown inline over the tree. -->
      <Border ZIndex="1"
              IsVisible="{Binding ActiveNewArea, Converter={x:Static ObjectConverters.IsNotNull}}"
              Background="{DynamicResource PanelRaisedBrush}"
              BorderBrush="{DynamicResource RuleStrongBrush}" BorderThickness="1"
              Padding="12" CornerRadius="4" HorizontalAlignment="Stretch" VerticalAlignment="Top"
              Margin="8">
        <StackPanel Spacing="7" DataContext="{Binding ActiveNewArea}"
                    x:DataType="panels:NewAreaViewModel">
          <TextBlock Text="New Area" FontWeight="SemiBold" />
          <TextBox Text="{Binding ResRef, Mode=TwoWay}" Watermark="ResRef (lowercase, max 16)" />
          <TextBox Text="{Binding DisplayName, Mode=TwoWay}" Watermark="Display name" />
          <ComboBox ItemsSource="{Binding Tilesets}" SelectedItem="{Binding SelectedTileset, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
          <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
            <TextBlock Grid.Column="0" Text="Width" Classes="dim" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding Width, Mode=TwoWay}" Minimum="1" Maximum="32" Increment="1" />
            <TextBlock Grid.Column="2" Text="Height" Classes="dim" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="3" Value="{Binding Height, Mode=TwoWay}" Minimum="1" Maximum="32" Increment="1" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Create" Classes="primary" Command="{Binding CreateCommand}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3" Margin="10,4,10,8" Classes="dim" FontSize="11.5" TextWrapping="Wrap"
               Text="{Binding StatusMessage}"
               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </Grid>
</UserControl>
