<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:panels="using:SWLOR.Toolset.Shell.Panels"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="700"
             x:Class="SWLOR.Toolset.Shell.Views.PaletteView"
             x:DataType="panels:PaletteViewModel">

  <!-- Top to bottom: which type, one search box, the category tree, where you are, the grid.
       The tree and the grid split the height with a splitter between them, because how much of each
       you want depends on whether you are hunting for a folder or working out of one. -->
  <Grid RowDefinitions="Auto,Auto,Auto,220,Auto,Auto,*,Auto">

    <!-- Type chips. No counts: "8,355 placeables" answers a question nobody asks. -->
    <ItemsControl Grid.Row="0" ItemsSource="{Binding Types}" Margin="8,8,8,4">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="panels:PaletteTypeChipViewModel">
          <Button Content="{Binding Label}" Margin="0,0,4,4" CornerRadius="11" Padding="10,3"
                  FontSize="11.5"
                  Classes.primary="{Binding IsSelected}"
                  Command="{Binding $parent[ItemsControl].((panels:PaletteViewModel)DataContext).SelectTypeCommand}"
                  CommandParameter="{Binding}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBox Grid.Row="1" Margin="8,4" Text="{Binding Query}"
             Watermark="Search categories and objects..." />

    <!-- Category header doubles as the folder-editing bar when organizing. -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="8,4,8,2">
      <TextBlock Grid.Column="0" Classes="label" VerticalAlignment="Center" Text="CATEGORIES" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
        <TextBlock Classes="count" VerticalAlignment="Center" Margin="0,0,4,0"
                   IsVisible="{Binding HasCategoryMatches}"
                   Text="{Binding CategoryMatches.Count, StringFormat='{}{0} matches'}" />
        <ToggleButton Content="Organize" IsChecked="{Binding IsOrganizing, Mode=TwoWay}"
                      FontSize="11" Padding="8,2" />
      </StackPanel>
    </Grid>

    <!-- Searching swaps the tree for flattened matches, each with the path that reaches it. -->
    <Border Grid.Row="3" Margin="0,2" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1">
      <Grid>
        <ListBox IsVisible="{Binding !IsSearching}"
                 Background="Transparent" BorderThickness="0"
                 ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="panels:CategoryRowViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="{Binding Indent}">
                <Button Grid.Column="0" Content="{Binding Twisty}" Width="16" Padding="0"
                        Background="Transparent" BorderThickness="0" FontSize="9"
                        Foreground="{DynamicResource InkTertiaryBrush}"
                        Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).ToggleExpandCommand}"
                        CommandParameter="{Binding}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="&#x2605;" FontSize="10" VerticalAlignment="Center"
                             Foreground="{DynamicResource GoldBrush}"
                             IsVisible="{Binding IsPinned}" />
                  <TextBlock Classes="name" Text="{Binding Name}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Classes="count" Margin="8,0,10,0"
                           VerticalAlignment="Center" Text="{Binding Count}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <ListBox IsVisible="{Binding IsSearching}"
                 Background="Transparent" BorderThickness="0"
                 ItemsSource="{Binding CategoryMatches}">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="panels:CategoryMatchViewModel">
              <Grid ColumnDefinitions="*,Auto" Margin="4,1">
                <StackPanel Grid.Column="0" Spacing="1">
                  <TextBlock Classes="name" Text="{Binding Name}" />
                  <TextBlock Classes="dim" FontSize="11" Text="{Binding ParentPath}"
                             IsVisible="{Binding HasParentPath}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="count" VerticalAlignment="Center" Text="{Binding Count}" />
                  <Button Content="Go" FontSize="11" Padding="7,2" VerticalAlignment="Center"
                          Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).GoToCategoryCommand}"
                          CommandParameter="{Binding}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- Folder editing, only while organizing, so ordinary browsing cannot reorganize by accident. -->
    <StackPanel Grid.Row="4" Margin="8,6" Spacing="5" IsVisible="{Binding IsOrganizing}">
      <TextBox Text="{Binding NewFolderName}" Watermark="Category name" />
      <WrapPanel>
        <Button Content="New" Margin="0,0,4,4" Command="{Binding NewFolderCommand}"
                ToolTip.Tip="Add a category, nested inside the selected one" />
        <Button Content="Rename" Margin="0,0,4,4" Command="{Binding RenameFolderCommand}" />
        <Button Content="Remove" Margin="0,0,4,4" Command="{Binding RemoveFolderCommand}"
                ToolTip.Tip="Only an empty category can be removed" />
        <Button Content="Pin" Margin="0,0,4,4" Command="{Binding TogglePinCommand}" />
        <Button Content="File here" Margin="0,0,4,4" Command="{Binding FileSelectedTileCommand}"
                ToolTip.Tip="Move the selected blueprint into the selected category" />
      </WrapPanel>
    </StackPanel>

    <!-- Where you are, and whether the grid reaches into subcategories. -->
    <Grid Grid.Row="5" ColumnDefinitions="*,Auto" Margin="10,6,10,4">
      <TextBlock Grid.Column="0" Classes="dim" FontSize="11.5" Text="{Binding Breadcrumb}"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <CheckBox Grid.Column="1" Content="incl. sub" FontSize="11"
                IsChecked="{Binding IncludeSubcategories}"
                IsVisible="{Binding !IsSearching}"
                ToolTip.Tip="Show everything beneath this category too" />
    </Grid>

    <ListBox Grid.Row="6" ItemsSource="{Binding Tiles}" SelectedItem="{Binding SelectedTile}"
             Background="Transparent" BorderThickness="0" Padding="6">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="4" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="panels:PaletteTileViewModel">
          <Border Width="136" CornerRadius="4" Background="{DynamicResource PanelRaisedBrush}"
                  BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1">
            <StackPanel>
              <!-- Stands in for the rendered model until the thumbnail cache exists. -->
              <Border Height="58" CornerRadius="3,3,0,0" Background="{DynamicResource FieldBrush}">
                <TextBlock Text="{Binding Glyph}" FontSize="22" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" />
              </Border>
              <StackPanel Margin="7,5" Spacing="1">
                <TextBlock Classes="name" Text="{Binding Name}" MaxLines="2"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="resref" Text="{Binding ResRef}" />
                <TextBlock Classes="dim" FontSize="10" Text="{Binding CategoryPath, StringFormat='in {0}'}"
                           IsVisible="{Binding HasCategoryPath}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" Margin="5,0,5,6" ColumnSpacing="4">
                <Button Grid.Column="0" Content="Place" FontSize="11" Padding="0,3" Classes="primary"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).PlaceCommand}"
                        CommandParameter="{Binding}" />
                <Button Grid.Column="1" Content="Edit" FontSize="11" Padding="0,3"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).EditCommand}"
                        CommandParameter="{Binding}" />
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="7" Margin="10,4,10,8" Classes="dim" FontSize="11.5" TextWrapping="Wrap"
               Text="{Binding StatusMessage}"
               IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </Grid>
</UserControl>
