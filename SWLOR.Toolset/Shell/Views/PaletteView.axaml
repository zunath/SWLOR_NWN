<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panels="using:SWLOR.Toolset.Shell.Panels"
             xmlns:shared="using:Nwn.Toolset.Avalonia.Palettes.Views"
             x:Class="SWLOR.Toolset.Shell.Views.PaletteView"
             x:DataType="panels:PaletteViewModel"
             x:CompileBindings="True">
  <shared:PaletteView DataContext="{Binding PresentationState}" />
</UserControl>
