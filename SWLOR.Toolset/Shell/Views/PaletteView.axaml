<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:panels="using:SWLOR.Toolset.Shell.Panels"
             mc:Ignorable="d" d:DesignWidth="340" d:DesignHeight="700"
             x:Class="SWLOR.Toolset.Shell.Views.PaletteView"
             x:DataType="panels:PaletteViewModel">

  <!-- Top to bottom: which type, one search box, the category tree, then the object grid.
       The tree and the grid share the height through a draggable splitter, because how much of each
       you want depends on whether you are hunting for a category or working out of one. Everything
       category-related is grouped above the splitter and everything object-related below it, so the
       divider lands where the meaning changes rather than in the middle of a group. Both sides are
       star-sized: a GridSplitter between an Auto row and a star row has nothing to trade. -->
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,2*,Auto,3*">

    <!-- Title drawn here rather than by Dock's chrome, which pads it out with a dotted drag grip. -->
    <Border Grid.Row="0" Background="{DynamicResource PanelHeaderBrush}"
            BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,0,0,1" Padding="14,9">
      <TextBlock Classes="title" Text="PALETTE" />
    </Border>

    <!-- Type chips. No counts: "8,355 placeables" answers a question nobody asks. -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,10,10,4" Spacing="5">
      <ItemsControl ItemsSource="{Binding Types}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="5" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="panels:PaletteTypeChipViewModel">
            <Button Content="{Binding Label}" CornerRadius="12" Padding="11,4" FontSize="11.5"
                    Classes.primary="{Binding IsSelected}"
                    Command="{Binding $parent[ItemsControl].((panels:PaletteViewModel)DataContext).SelectTypeCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Content="More..." CornerRadius="12" Padding="11,4" FontSize="11.5"
              IsVisible="{Binding HasMoreTypes}" Command="{Binding ShowMoreTypesCommand}"
              ToolTip.Tip="Items, waypoints, triggers and sound sets" />
    </StackPanel>

    <TextBox Grid.Row="2" Margin="8,4" Text="{Binding Query}"
             Watermark="Search categories and objects..." />

    <!-- Category header carries the one action that belongs to the tree as a whole. -->
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="10,6,8,3">
      <TextBlock Grid.Column="0" Classes="label" VerticalAlignment="Center" Text="CATEGORIES" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="count" VerticalAlignment="Center"
                   IsVisible="{Binding HasCategoryMatches}"
                   Text="{Binding CategoryMatches.Count, StringFormat='{}{0} matches'}" />
        <Button Classes="link" Content="+ NEW" Command="{Binding NewCategoryCommand}"
                ToolTip.Tip="Add a category, nested inside the selected one" />
        <ToggleButton Content="Organize" IsChecked="{Binding IsOrganizing, Mode=TwoWay}"
                      FontSize="11" Padding="8,2" />
      </StackPanel>
    </Grid>

    <!-- Categories block. Searching swaps the tree for flattened matches, each with the path to it. -->
    <Grid Grid.Row="4" RowDefinitions="*,Auto" MinHeight="90">
      <Border Grid.Row="0" Margin="0,2" BorderBrush="{DynamicResource RuleBrush}" BorderThickness="0,1">
        <Grid>
          <ListBox IsVisible="{Binding !IsSearching}"
                   Background="Transparent" BorderThickness="0"
                   ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="panels:CategoryRowViewModel">
                <!-- ContextRequested selects the row first: Avalonia does not select on right-click,
                     and every command on this menu acts on the selection. -->
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="{Binding Indent}"
                      Background="Transparent" ContextRequested="OnCategoryContextRequested">
                  <Grid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="New category..."
                                Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).NewCategoryCommand}" />
                      <MenuItem Header="Rename..."
                                Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).RenameCategoryCommand}" />
                      <Separator />
                      <MenuItem Header="Delete category"
                                Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).DeleteCategoryCommand}" />
                    </ContextMenu>
                  </Grid.ContextMenu>
                  <Button Grid.Column="0" Content="{Binding Twisty}" Width="26" MinHeight="22" Padding="0"
                          Background="Transparent" BorderThickness="0" FontSize="11"
                          Foreground="{DynamicResource InkTertiaryBrush}"
                          Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).ToggleExpandCommand}"
                          CommandParameter="{Binding}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="&#x2605;" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource GoldBrush}"
                               IsVisible="{Binding IsPinned}" />
                    <TextBlock Classes="name" Text="{Binding Name}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="count" Margin="8,0,10,0"
                             VerticalAlignment="Center" Text="{Binding Count}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <ListBox IsVisible="{Binding IsSearching}"
                   Background="Transparent" BorderThickness="0"
                   ItemsSource="{Binding CategoryMatches}">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="panels:CategoryMatchViewModel">
                <Grid ColumnDefinitions="*,Auto" Margin="4,1">
                  <StackPanel Grid.Column="0" Spacing="1">
                    <TextBlock Classes="name" Text="{Binding Name}" />
                    <TextBlock Classes="dim" FontSize="11" Text="{Binding ParentPath}"
                               IsVisible="{Binding HasParentPath}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="count" VerticalAlignment="Center" Text="{Binding Count}" />
                    <Button Content="Go" FontSize="11" Padding="7,2" VerticalAlignment="Center"
                            Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).GoToCategoryCommand}"
                            CommandParameter="{Binding}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Filing and pinning, only while organizing, so ordinary browsing cannot reorganize by
           accident. Naming lives in the right-click menu now, which is why there is no name box. -->
      <WrapPanel Grid.Row="1" Margin="8,6" IsVisible="{Binding IsOrganizing}">
        <Button Content="Pin" Margin="0,0,4,4" Command="{Binding TogglePinCommand}"
                ToolTip.Tip="Keep this category at the top of the tree" />
        <Button Content="File here" Margin="0,0,4,4" Command="{Binding FileSelectedTileCommand}"
                ToolTip.Tip="Move the selected blueprint into the selected category" />
      </WrapPanel>
    </Grid>

    <GridSplitter Grid.Row="5" Height="5" ResizeDirection="Rows"
                  Background="{DynamicResource RuleBrush}"
                  ResizeBehavior="PreviousAndNext" />

    <!-- Objects block: where you are, the grid, and the grid's own controls. -->
    <Grid Grid.Row="6" RowDefinitions="Auto,*,Auto" MinHeight="120">

    <!-- Where you are, and whether the grid reaches into subcategories. -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,6,10,4">
      <TextBlock Grid.Column="0" Classes="dim" FontSize="11.5" Text="{Binding Breadcrumb}"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
      <CheckBox Grid.Column="1" Content="incl. sub" FontSize="11"
                IsChecked="{Binding IncludeSubcategories}"
                IsVisible="{Binding !IsSearching}"
                ToolTip.Tip="Show everything beneath this category too" />
    </Grid>

    <ListBox Grid.Row="1" ItemsSource="{Binding Tiles}" SelectedItem="{Binding SelectedTile}"
             Background="Transparent" BorderThickness="0" Padding="6">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0" />
          <Setter Property="Margin" Value="4" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate DataType="panels:PaletteTileViewModel">
          <!-- Placing is the default action: clicking a tile arms placement, which is what a builder
               does with a palette nine times in ten. Editing lives behind the ellipsis and the right-click
               menu, so the common action needs no aim and the rare one is still one click away. -->
          <Border Width="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).TileSize}"
                  CornerRadius="4" Background="{DynamicResource PanelRaisedBrush}"
                  BorderBrush="{DynamicResource RuleBrush}" BorderThickness="1"
                  Tapped="OnTileTapped" ContextRequested="OnTileContextRequested">
            <Border.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Place in area"
                          Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).PlaceCommand}"
                          CommandParameter="{Binding}" />
                <MenuItem Header="Edit blueprint..."
                          Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).EditCommand}"
                          CommandParameter="{Binding}" />
                <Separator />
                <MenuItem Header="Delete blueprint..."
                          Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).DeleteTileCommand}"
                          CommandParameter="{Binding}" />
              </ContextMenu>
            </Border.ContextMenu>
            <StackPanel>
              <Panel>
                <Border Height="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).PreviewHeight}"
                        CornerRadius="3,3,0,0" Background="{DynamicResource FieldBrush}">
                  <Panel>
                    <TextBlock Text="{Binding Glyph}" FontSize="22" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"
                               IsVisible="{Binding !HasPreview}" />
                    <Image Source="{Binding Preview}" Stretch="Uniform" Margin="4"
                           IsVisible="{Binding HasPreview}" />
                  </Panel>
                </Border>

                <Button Classes="link" Content="&#x22EF;" FontSize="15" Padding="7,1"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0"
                        Command="{Binding $parent[ListBox].((panels:PaletteViewModel)DataContext).EditCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Edit this blueprint" />
              </Panel>

              <StackPanel Margin="8,6,8,8" Spacing="2">
                <TextBlock Classes="name" Text="{Binding Name}" MaxLines="2"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="resref" Text="{Binding ResRef}" />
                <TextBlock Classes="dim" FontSize="10" Text="{Binding CategoryPath, StringFormat='in {0}'}"
                           IsVisible="{Binding HasCategoryPath}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="2">
      <!-- Preview size: how big the artwork gets. Small fits far more of a large category on screen,
           large is what a builder wants when they are picking between similar models. -->
      <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,6" ColumnSpacing="9"
            Background="Transparent">
        <TextBlock Grid.Column="0" Classes="dim" FontSize="11" VerticalAlignment="Center"
                   Text="Preview size" />
        <Slider Grid.Column="1" Minimum="96" Maximum="200" Value="{Binding TileSize}"
                VerticalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="count" VerticalAlignment="Center"
                   Text="{Binding TileSizeLabel}" />
      </Grid>

      <TextBlock Margin="10,0,10,8" Classes="dim" FontSize="11.5" TextWrapping="Wrap"
                 Text="{Binding StatusMessage}"
                 IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
    </Grid>
  </Grid>
</UserControl>
