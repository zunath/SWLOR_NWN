<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:panels="using:SWLOR.Toolset.Shell.Panels"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="600"
             x:Class="SWLOR.Toolset.Shell.Views.PropertiesView"
             x:DataType="panels:PropertiesViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top"
               Text="{Binding SelectionTitle}"
               FontWeight="Bold"
               Margin="6" />
    <ListBox ItemsSource="{Binding Rows}" IsHitTestVisible="True">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="panels:PropertyRow">
          <Grid ColumnDefinitions="140,*">
            <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
