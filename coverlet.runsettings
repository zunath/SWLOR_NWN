<?xml version="1.0" encoding="utf-8"?>
<!--
  Coverage settings for the XPlat Code Coverage (coverlet) data collector.

  Used by the maintainability CI (.github/workflows/maintainability-ci.yml) and by anyone measuring locally
  (see scripts/ci/run-unit-tests.sh). The test command passes the collector name "XPlat Code Coverage" and this file
  as the run settings.

  Scope: the repository's own production assemblies. Test assemblies, the in-engine test assembly and generated
  code are excluded, so the numbers describe hand-written code only (owner decision 3 in
  SWLOR.Game.Server/Readmes/MaintainabilityRefactorPlan.md).
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>

          <!-- Every SWLOR.* production assembly a test run loads; the test and engine-test assemblies are not code
               under test. -->
          <Include>[SWLOR.*]*</Include>
          <Exclude>[*.Tests]*,[*.Corpus.Tests]*,[SWLOR.Game.Server.EngineTests]*</Exclude>

          <!-- Generated code, matched against the source file path:
               - Feature/BeastDefinition: the generated beast definitions (hundreds of thousands of lines of data).
               - Generated folders.
               - *.Generated.cs: files written by a generator and marked <auto-generated />
                 (Service/SlicingService/SlicingBoardCatalog.Generated.cs). -->
          <ExcludeByFile>**/Feature/BeastDefinition/**,**/Generated/**,**/*.Generated.cs,**/*.g.cs</ExcludeByFile>

          <!-- Compiler-generated members (CompilerGeneratedAttribute) stay in: lambdas and async state machines are
               real code and coverlet maps them back to the method that declares them. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>

          <SkipAutoProps>false</SkipAutoProps>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
