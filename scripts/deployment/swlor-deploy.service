[Unit]
Description=Build and deploy the latest SWLOR server release
Wants=network-online.target docker.service
After=network-online.target docker.service
ConditionPathExists=/etc/swlor-deploy.conf

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/swlor-deploy --if-changed
TimeoutStartSec=infinity
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
