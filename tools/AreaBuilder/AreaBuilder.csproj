<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AreaBuilder</AssemblyName>
    <RootNamespace>SWLOR.Tools.AreaBuilder</RootNamespace>
  </PropertyGroup>

  <!--
    Links the pure (engine-free) generation sources and dungeon/tileset/layout profile definitions
    directly, so the builder always previews the exact production solver and content, mirroring the
    linked-sources pattern in tools/ProcgenReview/ProcgenReview.csproj.
  -->
  <ItemGroup>
    <Compile Include="..\..\SWLOR.Game.Server\Service\AreaGenerationService\TilesetModel.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Service\AreaGenerationService\TilesetSetParser.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Service\AreaGenerationService\AreaLayout.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Service\AreaGenerationService\MacroLayoutGenerator.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Service\AreaGenerationService\TileResolver.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Service\AreaGenerationService\DungeonDefinition.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Service\AreaGenerationService\Layouts\*.cs" />

    <Compile Include="..\..\SWLOR.Game.Server\Feature\DungeonDefinition\IDungeonListDefinition.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Feature\DungeonDefinition\IDungeonTilesetProfileListDefinition.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Feature\DungeonDefinition\IDungeonLayoutProfileListDefinition.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Feature\DungeonDefinition\StandardTilesetProfiles.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Feature\DungeonDefinition\StandardLayoutProfiles.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Feature\DungeonDefinition\MineCaveDungeonDefinition.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Feature\DungeonDefinition\SciFiBaseDungeonDefinition.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Feature\DungeonDefinition\SewerDungeonDefinition.cs" />
    <Compile Include="..\..\SWLOR.Game.Server\Feature\DungeonDefinition\AlienRuinDungeonDefinition.cs" />
  </ItemGroup>

</Project>
